                    <div class="kd-all kd-all-c kd-seo-hidden @GetAllTabClass(0)">
                        <h3 class="kd-seo-hidden">Components</h3>

                        @{
                            foreach (var componentGroupName in ComponentGroups)
                            {
                                //var category = Categories.FirstOrDefault(c => c.Key == componentGroupName);
                                var category = CategoriesFlat.Where(c => c.Category == componentGroupName).ToList();

                                if (!string.IsNullOrEmpty(ComponentFilterQuery))
                                {
                                    category = category.Where(d =>
                                    {
                                        string componentName = string.IsNullOrEmpty(d.Text) ? d.Component : d.Text;
                                        return componentName.ToLowerInvariant().Contains(ComponentFilterQuery.ToLowerInvariant()) ||
                                                    ComponentFilterQuery.ToLowerInvariant().Contains(componentName.ToLowerInvariant());
                                    }).ToList();
                                }

                                if (category.Count() > 0)
                                {
                                    <div @key="@category">
                                        <h4>@componentGroupName</h4>

                                        <ul>
                                            @foreach (DemoItem component in category)
                                            {
                                                string componentName = string.IsNullOrEmpty(component.Text) ? component.Component : component.Text;
                                                <li @key="@component">
                                                    <NavLink href="@GetHref(component)">
                                                        @componentName
                                                        <DemoFlag Demo="@component" />
                                                    </NavLink>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            }
