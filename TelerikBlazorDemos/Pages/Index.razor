@code {
    //IEnumerable<IGrouping<string, DemoItem>> Categories { get; set; }
    IEnumerable<DemoItem> CategoriesFlat { get; set; }

    string SearchQuery { get; set; }

    string ComponentFilterQuery { get; set; }

    int PopularTabStripIndex { get; set; } = 0;
    int AllTabStripIndex { get; set; } = 0;

    readonly string[] ComponentGroups = new string[] {
        "Data Management",
        "File Management",
        "Navigation",
        "Editors",
        "Icons",
        //"Conversational UI",
        "Labels",
        "Charts",
        "Gauges",
        "Barcodes",
        "PDF",
        "Scheduling",
        "Layout",
        "Interactivity & UX",
        "Diagrams and Maps"
    };

    string GetPopularTabClass(int tabIndex)
    {
        return tabIndex == PopularTabStripIndex ? "kd-active" : null;
    }

    string GetAllTabClass(int tabIndex)
    {
        return tabIndex == AllTabStripIndex ? "kd-active" : null;
    }

    private void SelectPopularTab(int tabIndex, string hashValue)
    {
        PopularTabStripIndex = tabIndex;
        js.InvokeVoidAsync("updateUrlHash", hashValue);
    }

    private void SelectAllTab(int tabIndex, string hashValue)
    {
        AllTabStripIndex = tabIndex;
        js.InvokeVoidAsync("updateUrlHash", hashValue);
    }

    void ShowSearchResults(string query)
    {
        SearchQuery = query;
    }

    string GetHref(DemoItem component)
    {
        if (string.IsNullOrEmpty(component.Path))
        {
            return component.Component.ToLowerInvariant().Replace(" ", "") + "/overview";
        }
        else
        {
            return component.Path;
        }
    }

    protected override void OnInitialized()
    {
        CategoriesFlat = DemoListService.GetAllDemosFlat().OrderBy(d => d.Component).OrderBy(d => d.Text).ToList();
        //Categories = CategoriesFlat.GroupBy(d => d.Category).ToList();

        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await js.InvokeVoidAsync("theme.appTheme.disableDark");
            if (NavigationManager.Uri.Contains("#"))
            {
                await js.InvokeVoidAsync("openHomePageTab");
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public void Dispose()
    {
        _ = js.InvokeVoidAsync("theme.appTheme.restoreDark");
    }
}
