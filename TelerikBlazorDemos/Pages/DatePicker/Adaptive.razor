@page "/datepicker/adaptive"

<div class="demo-alert demo-alert-info" role="alert">
    <p>
        Resize the browser to see how the DatePicker adapts to different resolutions.
    </p>
</div>

<div class="demo-section">
    <label for="picker" class="k-label k-form-label">Set date</label>
    <TelerikDatePicker @bind-Value="@Value"
                       AdaptiveMode="@AdaptiveMode.Auto"
                       Id="picker"
                       Size="@ThemeConstants.DatePicker.Size.Large"
                       Title="Set date">
    </TelerikDatePicker>
</div>

@code {
    public DateTime? Value { get; set; } = new DateTime(2025, 11, 27, 9, 48, 53);
}
