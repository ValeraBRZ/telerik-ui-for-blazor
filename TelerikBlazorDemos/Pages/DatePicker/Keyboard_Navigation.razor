@page "/datepicker/keyboard-navigation"

<div class="demo-section k-form k-form-md k-form-vertical">
    <div class="k-form-field">
        <label for="selected-date" class="k-label k-form-label">Selected Date</label>
        <div class="k-form-field-wrap">
            <TelerikDatePicker Min="@Min" Max="@Max" @bind-Value="@selectedDate" Id="selected-date"></TelerikDatePicker>
        </div>
    </div>
</div>

@code {
    public DateTime Max = new DateTime(2050, 12, 31);
    public DateTime Min = new DateTime(1950, 1, 1);
    private DateTime? selectedDate;
}
