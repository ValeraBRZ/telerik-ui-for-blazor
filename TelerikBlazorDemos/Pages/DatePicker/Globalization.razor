@page "/datepicker/globalization"

<DemoConfigurator>
    <DemoConfiguratorColumn>
        <CultureChooser></CultureChooser>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<div class="demo-alert demo-alert-info">Type a year greater than "2050" in the dateinput to see localized validation message.</div>

<div class="demo-section k-form k-form-md k-form-vertical">
    <EditForm Model="@model">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="k-form-field">
            <label for="selected-date" class="k-label k-form-label">Selected Date</label>
            <div class="k-form-field-wrap">
                <TelerikDatePicker Min="@Min" Max="@Max" @bind-Value="@model.SelectedDate" Id="selected-date"></TelerikDatePicker>
            </div>
        </div>
    </EditForm>
</div>

@code {
    private EditFormModel model { get; set; } = new EditFormModel { SelectedDate = DateTime.Now };
    private DateTime Max = new DateTime(2050, 12, 31);
    private DateTime Min = new DateTime(1950, 1, 1);

    public class EditFormModel
    {
        public DateTime SelectedDate { get; set; }
    }
}
