@page "/button/keyboard-navigation"

<TelerikButton ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)" OnClick="@FirstButtonClick">Click me!</TelerikButton>
<br />
@firstButtonInstructions
<br />
<TelerikButton OnClick="@SecondButtonClick">Tab here and press Enter or Space</TelerikButton>
<br />
@secondButtonInfo

@code{
    string firstButtonInstructions;
    string secondButtonInfo;

    void FirstButtonClick()
    {
        firstButtonInstructions = string.Format("Last clicked at {0:HH:mm:ss} on {0:dd MMM yy}. Now you can press Enter or Space to click me again. You can aslo press Tab to get to the next button and activate it with the keyboard too", DateTime.Now);
    }

    void SecondButtonClick()
    {
        secondButtonInfo = "You can also press Shift + Tab to go back to the previous button.";
    }
}
