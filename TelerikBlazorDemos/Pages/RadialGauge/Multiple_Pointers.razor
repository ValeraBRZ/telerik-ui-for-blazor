@page "/radialgauge/multiple-pointers"

<div class="demo-section">
    <TelerikRadialGauge>
        <RadialGaugeScales>
            <RadialGaugeScale Min="0" Max="50">
            </RadialGaugeScale>
        </RadialGaugeScales>
        <RadialGaugePointers>
            <RadialGaugePointer Value="10"
                                Color="#FFE162">
            </RadialGaugePointer>
            <RadialGaugePointer Value="20"
                                Color="#4CD180">
            </RadialGaugePointer>
            <RadialGaugePointer Value="30"
                                Color="#017CFF">
            </RadialGaugePointer>
        </RadialGaugePointers>
    </TelerikRadialGauge>
</div>
