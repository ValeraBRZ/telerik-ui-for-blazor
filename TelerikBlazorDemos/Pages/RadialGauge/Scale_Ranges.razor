@page "/radialgauge/scale-ranges"

<div class="demo-section">
    <TelerikRadialGauge>
        <RadialGaugeScales>
            <RadialGaugeScale Min="0" Max="180">
                <RadialGaugeScaleRanges>
                    <RadialGaugeScaleRange From="90"
                                           To="120"
                                           Color="#FFE162">
                    </RadialGaugeScaleRange>

                    <RadialGaugeScaleRange From="120"
                                           To="150"
                                           Color="#FF8400">
                    </RadialGaugeScaleRange>

                    <RadialGaugeScaleRange From="150"
                                           To="180"
                                           Color="#C20000">
                    </RadialGaugeScaleRange>
                </RadialGaugeScaleRanges>
            </RadialGaugeScale>
        </RadialGaugeScales>
        <RadialGaugePointers>
            <RadialGaugePointer Value="50"></RadialGaugePointer>
        </RadialGaugePointers>
    </TelerikRadialGauge>
</div>
