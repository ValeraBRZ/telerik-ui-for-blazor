@page "/datetimepicker/keyboard-navigation"


<div class="demo-section k-form k-form-md k-form-vertical">
    <div class="k-form-field">
        <label for="selected-date" class="k-label k-form-label">Selected Date</label>
        <div class="k-form-field-wrap">
            <TelerikDateTimePicker @bind-Value="@selectedTime" Id="selected-date"></TelerikDateTimePicker>
        </div>
    </div>
</div>

@code {
    private DateTime? selectedTime = DateTime.Now;
}
