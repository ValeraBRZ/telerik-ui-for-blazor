@page "/datetimepicker/adaptive"

<div class="demo-alert demo-alert-info" role="alert">
    <p>
        Resize the browser to see how the DateTimePicker adapts to different resolutions.
    </p>
</div>

<div class="demo-section">
    <label for="picker" class="k-label k-form-label">Set date and time</label>
    <TelerikDateTimePicker @bind-Value="@Value"
                           AdaptiveMode="@AdaptiveMode.Auto"
                           Id="picker"
                           Size="@ThemeConstants.DateTimePicker.Size.Large"
                           Title="Set date and time">
    </TelerikDateTimePicker>
</div>

@code {
    public DateTime? Value { get; set; } = new DateTime(2025, 11, 27, 9, 48, 53);
}
