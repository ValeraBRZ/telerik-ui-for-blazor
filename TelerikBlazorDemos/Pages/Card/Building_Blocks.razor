@page "/card/building-blocks"

<div class="flex-center">
    <TelerikCard Width="300px">
        <CardHeader>
            <CardTitle>Tourism</CardTitle>
            <CardSubTitle>Bulgaria, Europe</CardSubTitle>
        </CardHeader>
        <CardImage Src="images/cards/bg/black_sea.jpg"></CardImage>
        <CardBody>
            <CardTitle>Black Sea</CardTitle>
            <CardSeparator></CardSeparator>
            <p>The Black Sea is bordered by Ukraine, Romania, Bulgaria, Turkey, Georgia, and Russia. It has a positive water balance; that is, a net outflow of water 300 km3 per year through the Bosphorus and the Dardanelles into the Aegean Sea.</p>
        </CardBody>
        <CardActions Layout="@CardActionsLayout.Stretch">
            <TelerikButton FillMode="@(ThemeConstants.Button.FillMode.Flat)" Icon="@SvgIcon.HeartOutline">Like</TelerikButton>
            <TelerikButton FillMode="@(ThemeConstants.Button.FillMode.Flat)">Share</TelerikButton>
            <TelerikButton FillMode="@(ThemeConstants.Button.FillMode.Flat)">Read More</TelerikButton>
        </CardActions>
        <CardFooter Class="k-hbox justify-space-between">
            <span>Created by @@john</span>
            <span>March 05, 2021</span>
        </CardFooter>
    </TelerikCard>
</div>


