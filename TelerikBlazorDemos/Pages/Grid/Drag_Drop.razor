@page "/grid/drag-drop"

@using System.Collections.Generic;

@inject ProductService ProductService

<div class="k-d-flex k-flex-wrap">
    <div class="k-flex-grow">
        <h4 class="mb-sm">Available Products</h4>
        <TelerikGrid @ref="@InStockProductsGrid"
                     Data=@InStockProducts
                     Height="400px"
                     Width="550px"
                     Resizable="true"
                     Pageable="true"
                     PageSize=@PageSize
                     RowDraggable="true"
                     SelectionMode="@GridSelectionMode.Multiple"
                     OnRowDrop="@((GridRowDropEventArgs<ProductDto> args) => OnInStockProductDrop(args))">
            <GridColumns>
                <GridColumn Field=@nameof(ProductDto.ProductName) Width="200px" Title="Product Name" />
                <GridColumn Field=@nameof(ProductDto.UnitPrice) Width="140px" Title="Price" DisplayFormat="{0:C2}" />
                <GridColumn Field=@nameof(ProductDto.Discontinued) Width="130px" Title="In Stock">
                    <Template>
                        <span class="k-badge k-badge-solid k-badge-solid-success k-badge-md k-rounded-md">Available</span>
                    </Template>
                </GridColumn>
            </GridColumns>
        </TelerikGrid>
    </div>

    <div class="k-flex-grow">
        <h4 class="mb-sm">Not Available Products</h4>
        <TelerikGrid @ref="@DiscontinuedGrid"
                     Data=@DiscontinuedProducts
                     Height="400px"
                     Width="550px"
                     Resizable="true"
                     Pageable="true"
                     PageSize=@PageSize
                     RowDraggable="true"
                     SelectionMode="@GridSelectionMode.Multiple"
                     OnRowDrop="@((GridRowDropEventArgs<ProductDto> args) => OnDiscontinuedProductDrop(args))">
            <NoDataTemplate>
                <div style="padding:120px 0;">Drag and drop products from the other Grid.</div>
            </NoDataTemplate>
            <GridColumns>
                <GridColumn Field=@nameof(ProductDto.ProductName) Width="200px" Title="Product Name" />
                <GridColumn Field=@nameof(ProductDto.UnitPrice) Width="140px" Title="Price" DisplayFormat="{0:C2}" />
                <GridColumn Field=@nameof(ProductDto.Discontinued) Width="130px" Title="In Stock">
                    <Template>
                        <span class="k-badge k-badge-solid k-badge-solid-error k-badge-md k-rounded-md">Not Available</span>
                    </Template>
                </GridColumn>
            </GridColumns>
        </TelerikGrid>
    </div>
</div>


@code {
    int PageSize = 10;
    public List<ProductDto> InStockProducts { get; set; }
    public List<ProductDto> DiscontinuedProducts { get; set; }
    public TelerikGrid<ProductDto> InStockProductsGrid { get; set; }
    public TelerikGrid<ProductDto> DiscontinuedGrid { get; set; }

    protected override void OnInitialized()
    {
        var allProducts = ProductService.GetProducts();
        DiscontinuedProducts = allProducts.Where(p => p.Discontinued == true).ToList();
        InStockProducts = allProducts.Where(p => p.Discontinued != true).ToList();
    }

    private void OnDiscontinuedProductDrop(GridRowDropEventArgs<ProductDto> args)
    {
        foreach (var item in args.Items)
        {
            DiscontinuedProducts.Remove(item);
        }

        InsertItem(args, false);
    }

    private void OnInStockProductDrop(GridRowDropEventArgs<ProductDto> args)
    {
        foreach (var item in args.Items)
        {
            InStockProducts.Remove(item);
        }

        InsertItem(args, true);
    }

    private void InsertItem(GridRowDropEventArgs<ProductDto> args, bool discontinued)
    {
        var destinationData = args.DestinationGrid == DiscontinuedGrid ? DiscontinuedProducts : InStockProducts;

        var destinationIndex = 0;

        if (args.DestinationItem != null)
        {
            destinationIndex = destinationData.IndexOf(args.DestinationItem);
            if (args.DropPosition == GridRowDropPosition.After)
            {
                destinationIndex += 1;
            }
        }

        foreach (var item in args.Items)
        {
            item.Discontinued = discontinued;
        }

        if (destinationIndex < 0)
        {
            // the item has already been removed from the destination grid
            destinationIndex = 0;
        }

        destinationData.InsertRange(destinationIndex, args.Items);
    }
}

<style>
    .gap-lg {
        gap: 24px;
    }
</style>
