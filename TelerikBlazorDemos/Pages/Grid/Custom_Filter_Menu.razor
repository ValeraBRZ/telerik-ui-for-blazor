@page "/grid/custom-filter-menu"

@using Telerik.DataSource

@inject EmployeeService EmployeeService

<div class="demo-alert demo-alert-info">
    The <strong>First Name</strong>, <strong>Country</strong> and <strong>Hire Date</strong> columns use custom filters, the other columns use the built-in filters.
    The <strong>Birth Date</strong> column renders custom Filter Menu buttons.
</div>

<TelerikGrid Data=@GridData
             Height="400px"
             Resizable="true"
             FilterMode="@GridFilterMode.FilterMenu"
             Pageable=true>
    <GridColumns>
        <GridColumn Field=@nameof(EmployeeDto.FirstName) Title="First Name">
            <FilterMenuTemplate>
                @{
                    <div class="filter-values-container">
                        @foreach (var name in Names)
                        {
                            <div>
                                <TelerikCheckBox Value="@(GetFilterValues(context.FilterDescriptor).Contains(name))"
                                         ValueChanged="@((bool value) => ColumnValueChanged(value, name, nameof(EmployeeDto.FirstName), context.FilterDescriptor))"
                                         Id="@($"name_{name}")">
                                </TelerikCheckBox>
                                <label for="@($"name_{name}")">
                                    @name
                                </label>
                            </div>
                        }
                    </div>
                }
            </FilterMenuTemplate>
        </GridColumn>
        <GridColumn Field=@nameof(EmployeeDto.LastName) Title="Last Name" Filterable="false" Width="130px" />
        <GridColumn Field=@nameof(EmployeeDto.Country) Title="Country" Width="100px">
            <FilterMenuTemplate>
                @{
                    <div class="filter-values-container">
                        @foreach (var country in Countries)
                        {
                            <div>
                                <TelerikCheckBox Value="@(GetFilterValues(context.FilterDescriptor).Contains(country))"
                                         ValueChanged="@((bool value) => ColumnValueChanged(value, country, nameof(EmployeeDto.Country), context.FilterDescriptor))"
                                         Id="@($"country_{country}")">
                                </TelerikCheckBox>
                                <label for="@($"country_{country}")">
                                    @country
                                </label>
                            </div>
                        }
                    </div>
                }
            </FilterMenuTemplate>
        </GridColumn>
        <GridColumn Field=@nameof(EmployeeDto.Extension) Title="Price" Width="100px" />
        <GridColumn Field=@nameof(EmployeeDto.HireDate) Title="Hire Date" Width="200px">
            <FilterMenuTemplate>
                @{
                    HireDateFilterMenuTemplateContext = context;

                    ExtendHireDateFilterDescriptor();
                }
                <label class="filter-label" for="afterDate">Is After:</label>
                <TelerikDatePicker Id="afterDate"
                                   @bind-Value="@HireDateAfterRangeDescriptor">
                </TelerikDatePicker>

                <TelerikDropDownList @bind-Value="@HireDateRangeDescriptor.LogicalOperator"
                                     Width="95px"
                                     TextField="@nameof(FilterLogicalOperatorDescriptor.Text)"
                                     ValueField="@nameof(FilterLogicalOperatorDescriptor.Operator)"
                                     Data="@FilterLogicalOperators">
                    <DropDownListSettings>
                        <DropDownListPopupSettings Height="auto"></DropDownListPopupSettings>
                    </DropDownListSettings>
                </TelerikDropDownList>

                <label class="filter-label" for="beforeDate">Is Before:</label>
                <TelerikDatePicker Id="beforeDate"
                                   @bind-Value="@HireDateBeforeRangeDescriptor">
                </TelerikDatePicker>

                <TelerikDropDownList @bind-Value="@HireDateCompositeFilterDescriptor.LogicalOperator"
                                     Width="95px"
                                     TextField="@nameof(FilterLogicalOperatorDescriptor.Text)"
                                     ValueField="@nameof(FilterLogicalOperatorDescriptor.Operator)"
                                     Data="@FilterLogicalOperators">
                    <DropDownListSettings>
                        <DropDownListPopupSettings Height="auto"></DropDownListPopupSettings>
                    </DropDownListSettings>
                </TelerikDropDownList>

                <label class="filter-label">
                    <TelerikCheckBox Value="@IsFromCurrentYear"
                                     ValueChanged="@((bool value) =>
                                                     {
                                                         if (value)
                                                         {
                                                             HireDateStartCurrentYearDescriptor.Value = new DateTime(DateTime.Now.Year, 1, 1);
                                                             HireDateEndCurrentYearDescriptor.Value = new DateTime(DateTime.Now.Year, 12, 31);
                                                         }
                                                         else
                                                         {
                                                             HireDateStartCurrentYearDescriptor.Value = HireDateEndCurrentYearDescriptor.Value = null;
                                                         }
                                                     })">
                    </TelerikCheckBox>
                    Is Current Year
                </label>
            </FilterMenuTemplate>
        </GridColumn>
        <GridColumn Field=@nameof(EmployeeDto.BirthDate) Title="Birth Date" Width="200px">
            <FilterMenuButtonsTemplate Context="filterContext">
                <TelerikButton OnClick="@(async () => await filterContext.FilterAsync())" Icon="@SvgIcon.Filter" ThemeColor="primary">Filter</TelerikButton>
                <TelerikButton OnClick="@(async () => await SetPredefinedFilterAsync(filterContext))" Icon="@SvgIcon.Filter">&ge; 1950 & &le; 1960</TelerikButton>
                <TelerikButton OnClick="@(async () => await filterContext.ClearFilterAsync())" Icon="@SvgIcon.FilterClear">Clear</TelerikButton>
            </FilterMenuButtonsTemplate>
        </GridColumn>
    </GridColumns>
</TelerikGrid>

@code {
    public async Task SetPredefinedFilterAsync(FilterMenuTemplateContext filterContext)
    {
        var compositeFilterDescriptor = filterContext.FilterDescriptor;
        compositeFilterDescriptor.FilterDescriptors.Clear();
        compositeFilterDescriptor.LogicalOperator = FilterCompositionLogicalOperator.And;

        compositeFilterDescriptor.FilterDescriptors.Add(
            new FilterDescriptor()
                {
                    Member = nameof(EmployeeDto.BirthDate),
                    MemberType = typeof(DateTime),
                    Operator = FilterOperator.IsGreaterThanOrEqualTo,
                    Value = new DateTime(1950, 1, 1)
                });

        compositeFilterDescriptor.FilterDescriptors.Add(
            new FilterDescriptor()
                {
                    Member = nameof(EmployeeDto.BirthDate),
                    MemberType = typeof(DateTime),
                    Operator = FilterOperator.IsLessThanOrEqualTo,
                    Value = new DateTime(1960, 1, 1)
                });

        await filterContext.FilterAsync();
    }

    public List<FilterLogicalOperatorDescriptor> FilterLogicalOperators { get; set; }

    public IEnumerable<EmployeeDto> GridData { get; set; }
    public List<string> Countries { get; set; }

    public List<string> Names { get; set; } = new List<string>();

    public FilterMenuTemplateContext HireDateFilterMenuTemplateContext { get; set; }

    public CompositeFilterDescriptor HireDateCompositeFilterDescriptor
        => HireDateFilterMenuTemplateContext.FilterDescriptor;

    public CompositeFilterDescriptor HireDateRangeDescriptor
        => HireDateCompositeFilterDescriptor.FilterDescriptors[0] as CompositeFilterDescriptor;

    public DateTime? HireDateBeforeRangeDescriptor
    {
        get => (HireDateRangeDescriptor.FilterDescriptors[1] as FilterDescriptor).Value as DateTime?;
        set
        {
            (HireDateRangeDescriptor.FilterDescriptors[1] as FilterDescriptor).Value = value;
        }
    }

    public DateTime? HireDateAfterRangeDescriptor
    {
        get => (HireDateRangeDescriptor.FilterDescriptors[0] as FilterDescriptor).Value as DateTime?;
        set
        {
            (HireDateRangeDescriptor.FilterDescriptors[0] as FilterDescriptor).Value = value;
        }
    }

    public CompositeFilterDescriptor HireDateCurrentYearDescriptor
        => HireDateCompositeFilterDescriptor.FilterDescriptors[1] as CompositeFilterDescriptor;

    public FilterDescriptor HireDateStartCurrentYearDescriptor
        => HireDateCurrentYearDescriptor.FilterDescriptors[0] as FilterDescriptor;

    public FilterDescriptor HireDateEndCurrentYearDescriptor
        => HireDateCurrentYearDescriptor.FilterDescriptors[1] as FilterDescriptor;

    public bool IsFromCurrentYear => HireDateStartCurrentYearDescriptor.Value != null;

    protected override void OnInitialized()
    {
        FilterLogicalOperators = GetFilterLogicalOperators();

        GridData = EmployeeService.GetEmployees();

        Countries = GridData.Select(e => e.Country).Distinct().ToList();

        Names = GridData.Select(d => d.FirstName).Distinct().ToList();
    }

    public List<string> GetFilterValues(CompositeFilterDescriptor filterDescriptor)
    {
        return filterDescriptor.FilterDescriptors.Select(f => (f as FilterDescriptor).Value?.ToString()).ToList();
    }

    public void ExtendHireDateFilterDescriptor()
    {
        if (HireDateCompositeFilterDescriptor.FilterDescriptors.Count > 0 &&
            HireDateCompositeFilterDescriptor.FilterDescriptors[0] is CompositeFilterDescriptor)
        {
            return;
        }

        HireDateCompositeFilterDescriptor.FilterDescriptors.Clear();

        HireDateCompositeFilterDescriptor.FilterDescriptors.Add(GetCompositeFilterForDateRange(null, null));
        HireDateCompositeFilterDescriptor.FilterDescriptors.Add(GetCompositeFilterForDateRange(null, null));
    }

    public void ColumnValueChanged(bool value, string itemValue, string columnName, CompositeFilterDescriptor filterDescriptor)
    {
        var filter = filterDescriptor.FilterDescriptors.FirstOrDefault(f => (f as FilterDescriptor).Value?.ToString() == itemValue);

        filterDescriptor.LogicalOperator = FilterCompositionLogicalOperator.Or;

        if (value && filter == null)
        {
            filterDescriptor.FilterDescriptors.Add(new FilterDescriptor(columnName, FilterOperator.IsEqualTo, itemValue));
        }
        else if (!value && filter != null)
        {
            filterDescriptor.FilterDescriptors.Remove(filter);
        }
    }

    public CompositeFilterDescriptor GetCompositeFilterForDateRange(DateTime? start, DateTime? end)
    {
        var firstFilter = new FilterDescriptor(nameof(EmployeeDto.HireDate), FilterOperator.IsGreaterThanOrEqualTo, start);
        var secondFilter = new FilterDescriptor(nameof(EmployeeDto.HireDate), FilterOperator.IsLessThanOrEqualTo, end);

        var filterDescriptors = new FilterDescriptorCollection();
        filterDescriptors.Add(firstFilter);
        filterDescriptors.Add(secondFilter);

        return new CompositeFilterDescriptor
            {
                FilterDescriptors = filterDescriptors,
                LogicalOperator = FilterCompositionLogicalOperator.And
            };
    }

    public class FilterLogicalOperatorDescriptor
    {
        public string Text { get; set; }

        public FilterCompositionLogicalOperator Operator { get; set; }
    }

    public List<FilterLogicalOperatorDescriptor> GetFilterLogicalOperators()
    {
        var data = new List<FilterLogicalOperatorDescriptor>();

        data.Add(new FilterLogicalOperatorDescriptor()
            {
                Text = "Or",
                Operator = FilterCompositionLogicalOperator.Or
            });

        data.Add(new FilterLogicalOperatorDescriptor()
            {
                Text = "And",
                Operator = FilterCompositionLogicalOperator.And
            });

        return data;
    }
}

<style>
    .filter-values-container {
        max-height: 300px;
        overflow: auto;
        padding: 8px;
    }

    .filter-label {
        padding: 0 8px;
    }
</style>
