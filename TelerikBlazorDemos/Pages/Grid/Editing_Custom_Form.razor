@page "/grid/editing-custom-form"

@inject ProductService ProductService

<TelerikGrid Data=@GridData
             Height=@Height
             Pageable="true" PageSize=@PageSize>
    <GridColumns>
        <GridCommandColumn Width="120px">
            <GridCommandButton OnClick="@((args)=> SelectProduct(args.Item as ProductDto))"
                               ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                               Icon="@SvgIcon.Pencil">Edit</GridCommandButton>
        </GridCommandColumn>
        <GridColumn Field=@nameof(ProductDto.ProductName) Title="Product Name" />
        <GridColumn Field=@nameof(ProductDto.UnitPrice) Title="Unit Price">
            <Template>
                @(String.Format("{0:C2}", (context as ProductDto).UnitPrice))
            </Template>
        </GridColumn>
    </GridColumns>
</TelerikGrid>

@if (selectedProduct != null)
{
<hr />
    <div class="mb-sm">
        <label class="k-label" for="productName">
            Product Name
        </label>
        <input class="k-textbox k-input k-input-md k-rounded-md k-input-solid fixed-input-width" @bind="@selectedProduct.ProductName" id="name" name="name" type="text" />
    </div>
    <div class="mb-sm">
        <label class="k-label" for="unitPrice">
            Unit Price
        </label>
        <input class="k-textbox k-input k-input-md k-rounded-md k-input-solid fixed-input-width" @bind="@selectedProduct.UnitPrice" id="unitPrice" name="unitPrice" step=".01" type="number" />
    </div>
    <div class="mb-sm">
        <div>
            <TelerikButton ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)" Icon="@SvgIcon.Save" Class="mr-sm" OnClick="@Update">Save</TelerikButton>
            <TelerikButton Icon="@SvgIcon.X" OnClick="@ClearSelection">Cancel</TelerikButton>
        </div>
    </div>
}

@code {
    public List<ProductDto> GridData { get; set; }
    public List<ProductDto> SourceData { get; set; }
    int PageSize = 10;
    string Height = "400px";
    ProductDto selectedProduct { get; set; }

    protected override void OnInitialized()
    {
        LoadData();
    }

    void LoadData()
    {
        SourceData = ProductService.GetProducts().ToList();
        GridData = new List<ProductDto>(SourceData);
    }

    void SelectProduct(ProductDto item)
    {
        if (item != null)
        {
            selectedProduct = new ProductDto { ProductId = item.ProductId, ProductName = item.ProductName, UnitPrice = item.UnitPrice };
        }
        else
        {
            ClearSelection();
        }

        StateHasChanged();
    }

    void Update()
    {
        var productToEdit = SourceData.FirstOrDefault(p => p.ProductId == selectedProduct.ProductId);
        productToEdit.ProductName = selectedProduct.ProductName;
        productToEdit.UnitPrice = selectedProduct.UnitPrice;

        GridData = new List<ProductDto>(SourceData);

        ClearSelection();
    }

    void ClearSelection()
    {
        selectedProduct = null;
    }
}

<style>
    .fixed-input-width {
        width: 12.4em;
    }
</style>
