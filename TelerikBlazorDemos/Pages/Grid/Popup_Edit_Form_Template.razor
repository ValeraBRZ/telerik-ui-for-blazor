@page "/grid/popup-edit-form-template"

@using System.Collections.Generic;
@using TelerikBlazorDemos.DataAccess.Dto;
@using TelerikBlazorDemos.DataAccess.Services;

@inject ProductService ProductService

<TelerikGrid @ref="@GridRef"
             Data="@GridData"
             EditMode="@GridEditMode.Popup"
             Pageable="true"
             Width="100%"
             PageSize="10"
             OnDelete="@DeleteItem">
    <GridToolBarTemplate>
        <GridCommandButton Command="Add" Icon="@SvgIcon.Plus">Add Product</GridCommandButton>
    </GridToolBarTemplate>
    <GridSettings>
        <GridPopupEditSettings Width="500px"
                               Title="Product Data"
                               MaxHeight="95vh"
                               MaxWidth="95vw"
                               Class="popup-class">
        </GridPopupEditSettings>
        <GridPopupEditFormSettings>
            <FormTemplate Context="gridPopupEditFormTemplateContext">
                @{
                    EditItem = gridPopupEditFormTemplateContext.Item as ProductDto;

                    <TelerikForm Model="EditItem"
                                 OnValidSubmit="@OnValidSubmit"
                                 ColumnSpacing="20px"
                                 ButtonsLayout="@FormButtonsLayout.Stretch"
                                 Columns="2">
                        <FormValidation>
                            <DataAnnotationsValidator />
                        </FormValidation>
                        <FormItems>
                            <FormItem Field="ProductId" Enabled="false"></FormItem>
                            <FormItem Field="ProductName"></FormItem>
                            <FormItem Field="UnitPrice" LabelText="Price"></FormItem>
                            <FormItem Field="UnitsInStock" LabelText="In Stock"></FormItem>
                            <FormItem Field="UnitsOnOrder" LabelText="On order"></FormItem>
                            <FormItem Field="Discontinued"></FormItem>
                        </FormItems>
                        <FormButtons>
                            <TelerikButton Icon="@nameof(SvgIcon.Save)">Save</TelerikButton>
                            <TelerikButton Icon="@nameof(SvgIcon.Cancel)" ButtonType="@ButtonType.Button" OnClick="@OnCancel">Cancel</TelerikButton>
                        </FormButtons>
                    </TelerikForm>
                }
            </FormTemplate>
        </GridPopupEditFormSettings>
    </GridSettings>
    <GridColumns>
        <GridColumn Field=@nameof(ProductDto.ProductId) Title="ID" Editable="false" />
        <GridColumn Field=@nameof(ProductDto.ProductName) Title="Product Name" />
        <GridColumn Field=@nameof(ProductDto.UnitPrice) Title="Price" />
        <GridColumn Field=@nameof(ProductDto.UnitsInStock) Title="In stock" />
        <GridColumn Field=@nameof(ProductDto.UnitsOnOrder) Title="On order" />
        <GridColumn Field=@nameof(ProductDto.Discontinued) Title="Discontinued" />
        <GridCommandColumn>
            <GridCommandButton Command="Edit" Icon="@SvgIcon.Pencil">Edit</GridCommandButton>
            <GridCommandButton Command="Delete" Icon="@SvgIcon.Trash">Delete</GridCommandButton>
        </GridCommandColumn>
    </GridColumns>
</TelerikGrid>

<style>
    .popup-class{
        border-radius:8px;
    }
    .popup-class .k-window-titlebar{
        border-radius:8px;
    }
</style>

@code {
    public TelerikGrid<ProductDto> GridRef { get; set; }
    public List<ProductDto> GridData { get; set; }
    public ProductDto EditItem { get; set; }

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        GridData = ProductService.GetProducts().ToList();
    }

    private void DeleteItem(GridCommandEventArgs args)
    {
        ProductService.DeleteProduct(args.Item as ProductDto);

        LoadData();
    }

    private async Task OnValidSubmit()
    {

        if (EditItem.ProductId != default)
        {
            ProductService.UpdateProduct(EditItem);
        }
        else
        {
            ProductService.CreateProduct(EditItem);
        }

        await ExitEditAsync();

        LoadData();
    }

    private async Task OnCancel()
    {
        await ExitEditAsync();
    }

    private async Task ExitEditAsync()
    {
        var state = GridRef?.GetState();
        state.OriginalEditItem = null;
        state.EditItem = null;
        state.InsertedItem = null;

        await GridRef?.SetStateAsync(state);
    }
}
