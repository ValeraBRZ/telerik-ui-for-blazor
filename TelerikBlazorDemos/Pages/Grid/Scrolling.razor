@page "/grid/scrolling"

@inject ProductService ProductService

<TelerikGrid Data="@GridData"
             Sortable="true"
             Height="400px"
             Width="100%"
             ScrollMode="@GridScrollMode.Scrollable">
    <GridColumns>
        <GridColumn Field=@nameof(ProductDto.ProductId) Title="ID" Width="50px" />
        <GridColumn Field=@nameof(ProductDto.ProductName) Title="Product Name" Width="400px" />
        <GridColumn Field=@nameof(ProductDto.CategoryId) Title="Category" Width="400px">
            <Template>
                @{ var product = context as ProductDto;

                    <span>@product.CategoryName</span>
                 }
            </Template>
        </GridColumn>
        <GridColumn Field=@nameof(ProductDto.UnitPrice) Title="Price" Width="300px" />
        <GridColumn Field=@nameof(ProductDto.UnitsInStock) Title="In stock" Width="200px" />
        <GridColumn Field=@nameof(ProductDto.QuantityPerUnit) Title="Quantity per unit" Width="400px" />
        <GridColumn Field=@nameof(ProductDto.Discontinued) Title="Discontinued" Width="200px" />
    </GridColumns>
</TelerikGrid>

@code {
    public IEnumerable<ProductDto> GridData { get; set; }

    protected override void OnInitialized()
    {
        GridData = ProductService.GetProducts();
    }
}
