@page "/grid/persist-state"

@using Telerik.DataSource;

@inject LocalStorage LocalStorage
@inject IJSRuntime JsInterop
@inject ProductService ProductService

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Control the Grid state">
        <TelerikButton OnClick="@SaveState" Icon="@SvgIcon.Save" Class="mr-xs">Save State</TelerikButton>
        <TelerikButton OnClick="@ReloadPage" Icon="@SvgIcon.ArrowRotateCw" Class="mr-xs">Reload the page</TelerikButton>
        <TelerikButton OnClick="@LoadState" Icon="@SvgIcon.Download" Class="mr-xs">Load last State</TelerikButton>
        <TelerikButton OnClick="@SetExplicitState" Icon="@SvgIcon.Gear" Class="mr-xs">Configure State</TelerikButton>
        <TelerikButton OnClick="@ResetState" Icon="@SvgIcon.ArrowRotateCcw">Reset State</TelerikButton>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<div class="demo-alert demo-alert-info" role="alert">
    <strong>Change the grid</strong> (for example, filter, page, resize columns, change grouping) and
    <strong>Save</strong> the grid state, then <strong>Reload</strong> the page to see the state persisted.
    <strong>Change</strong> the grid some more and <strong>Load</strong> the state to see the last one preserved.
    You can manage the grid state with your own code to put it in a specific configuration through the <strong>Configure</strong> button.
    You can also <strong>Reset</strong> the grid to its default settings. This demo will remember your last grid layout
    until your clear your browser storage or click the Reset button.
</div>

<TelerikGrid @ref="@Grid"
             Data="@GridData"
             Height="550px"
             Width="100%"
             Sortable="true"
             Resizable="true"
             Reorderable="true"
             Groupable="true"
             Pageable="true"
             PageSize="20"
             FilterMode="@GridFilterMode.FilterRow"
             ScrollMode="@GridScrollMode.Scrollable"
             OnStateInit="@((GridStateEventArgs<ProductDto> args) => OnStateInit(args))">
    <GridColumns>
        <GridColumn Field=@nameof(ProductDto.ProductId) Title="ID" />
        <GridColumn Field=@nameof(ProductDto.ProductName) Title="Product Name" />
        <GridColumn Field=@nameof(ProductDto.UnitPrice) Title="Price" />
        <GridColumn Field=@nameof(ProductDto.UnitsInStock) Title="In stock" />
        <GridColumn Field=@nameof(ProductDto.QuantityPerUnit) Title="Quantity per unit" />
        <GridColumn Field=@nameof(ProductDto.Discontinued) Title="Discontinued" />
    </GridColumns>
</TelerikGrid>

@code {
    public TelerikGrid<ProductDto> Grid { get; set; }
    public IEnumerable<ProductDto> GridData { get; set; }
    string stateStorageKey = "TelerikBlazorGridStateDemoKey";

    protected override void OnInitialized()
    {
        GridData = ProductService.GetProducts();
    }

    private async Task OnStateInit(GridStateEventArgs<ProductDto> args)
    {
        try
        {
            var state = await LocalStorage.GetItem<GridState<ProductDto>>(stateStorageKey);
            if (state != null)
            {
                args.GridState = state;
            }
        }
        catch (InvalidOperationException)
        {
            // the JS Interop for the local storage cannot be used during pre-rendering
        }
    }

    async Task SaveState()
    {
        var gridState = Grid.GetState();
        await LocalStorage.SetItem(stateStorageKey, gridState);
    }

    async Task LoadState()
    {
        GridState<ProductDto> storedState = await LocalStorage.GetItem<GridState<ProductDto>>(stateStorageKey);
        if (storedState != null)
        {
            await Grid.SetStateAsync(storedState);
        }
    }

    async void ResetState()
    {
        await Grid.SetStateAsync(null);
        await LocalStorage.RemoveItem(stateStorageKey);
    }

    void ReloadPage()
    {
        JsInterop.InvokeVoidAsync("window.location.reload");
    }

    async void SetExplicitState()
    {
        GridState<ProductDto> desiredState = GetDefaultDemoState();
        await Grid.SetStateAsync(desiredState);
        await SaveState();
    }

    GridState<ProductDto> GetDefaultDemoState()
    {
        GridState<ProductDto> defaultDemoState = new GridState<ProductDto>()
        {
            GroupDescriptors = new List<GroupDescriptor>()
    {
                    new GroupDescriptor()
                    {
                        Member = nameof(ProductDto.QuantityPerUnit),
                        MemberType = typeof(string)
                    }
                },
            CollapsedGroups = new List<int>() { 1, 2 },
            Page = 3
        };
        return defaultDemoState;
    }
}
