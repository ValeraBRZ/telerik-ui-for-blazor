@page "/grid/ai-column"

@using System.Net.Http.Json
@using System.Text.Json.Serialization

@using PatientService = TelerikBlazorDemos.Services.Data.MedicalRecordService;
@using MedicalRecordDto = TelerikBlazorDemos.Services.Data.MedicalRecordDto;

@inject PatientService PatientService
@inject HttpClient HttpClientInstance

<TelerikGrid Data="@GridData"
             Pageable="true"
             PageSize="10"
             Resizable="true"
             Sortable="true">
    <GridColumns>
        <GridColumn Title="AI" Resizable="false" Width="70px">
            <Template>
                @{
                    var dataItem = (MedicalRecordDto)context;

                    <TelerikButton OnClick="@((MouseEventArgs args) => OnAIButtonClick(dataItem, args))"
                                   Icon="@nameof(SvgIcon.Sparkles)">
                    </TelerikButton>
                }
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(MedicalRecordDto.Info)" Title="AI Assisted Info" Filterable="false" Width="280px" />
        <GridColumn Field="@nameof(MedicalRecordDto.PatientName)" Title="Patient Name" />
        <GridColumn Field="@nameof(MedicalRecordDto.Diagnosis)" Title="Diagnosis" />
        <GridColumn Field="@nameof(MedicalRecordDto.Status)" Title="Status" Width="200px">
            <Template>
                @{
                    var dataItem = (MedicalRecordDto)context;

                    <TelerikChip Text="@dataItem.Status"
                                 Selectable="false"
                                 ThemeColor="@GetStatusThemeColor(dataItem)">
                    </TelerikChip>
                }
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(MedicalRecordDto.AdmissionDate)" Title="Admission Date" DisplayFormat="{0:d}" />
        <GridColumn Field="@nameof(MedicalRecordDto.RiskIndicator)" Title="Risk Indicator" />
    </GridColumns>
</TelerikGrid>

<TelerikInlineAIPrompt @ref="@InlineAIPromptRef"
                       @bind-Prompt="@Prompt"
                       Commands="@Commands"
                       EnableSpeechToText="true"
                       OutputActions="@OutputActions"
                       OnCommandExecute="@OnCommandExecute"
                       OnOutputActionClick="@OnOutputActionClick"
                       OnPromptRequest="@OnAIPromptRequest"
                       Placeholder="Enter your request here...">
    <InlineAIPromptSettings>
        <AIPromptSpeechToTextButtonSettings Lang="en-US" />
        <InlineAIPromptPopupSettings MaxHeight="600px"
                                     Width="500px">
        </InlineAIPromptPopupSettings>
    </InlineAIPromptSettings>
</TelerikInlineAIPrompt>

@code {
    private List<MedicalRecordDto> GridData { get; set; }

    private TelerikInlineAIPrompt InlineAIPromptRef { get; set; }
    private MedicalRecordDto DataItemForAI { get; set; }
    private string Prompt { get; set; }

    private List<InlineAIPromptCommandDescriptor> Commands { get; set; } = new()
    {
        new InlineAIPromptCommandDescriptor
        {
            Id = "Recommend",
            Title = "Add recommendations",
            Prompt = "Provide a recommendation for the patient.",
        },
        new InlineAIPromptCommandDescriptor
        {
            Id = "Analyze",
            Title = "Analyze conditions",
            Prompt = "Analyze the patient's condition.",
        },
        new InlineAIPromptCommandDescriptor
        {
            Id = "Summarize",
            Title = "Summarize",
            Prompt = "Summarize the information for the patient.",
        }
    };

    private List<InlineAIPromptOutputActionDescriptor> OutputActions { get; set; } = new()
    {
        new InlineAIPromptOutputActionDescriptor
        {
            Name = "Copy",
            Title = "Copy",
            Text = "Copy",
        },
        new InlineAIPromptOutputActionDescriptor
        {
            Name = "Insert",
            Title = "Insert",
            Text = "Insert",
            Icon = nameof(SvgIcon.Wrench)
        },
        new InlineAIPromptOutputActionDescriptor
        {
            Name = "Discard",
            Title = "Discard",
            Text = "Discard",
        },
    };

    private async Task OnAIPromptRequest(InlineAIPromptPromptRequestEventArgs args)
    {
        var prompt = $@"{Prompt}.
            The patient's data is: {JsonSerializer.Serialize(DataItemForAI)}.
            Return a response in less than 50 characters.";

        var requestData = new List<CompletionRequestDto>()
        {
            new CompletionRequestDto()
            {
                Role = "user",
                Contents = new List<ChatContentRequestDto>()
                {
                    new ChatContentRequestDto
                    {
                        Type = "text",
                        Text = prompt
                    }
                }
            }
        };

        try
        {
            var requestResult = await this.HttpClientInstance.PostAsJsonAsync("https://demos.telerik.com/service/v2/ai/completion", requestData);
            var aiResponse = await requestResult.Content.ReadFromJsonAsync<CompletionResponseDto>();

            args.Output = aiResponse.Messages?.FirstOrDefault()?.Contents?.FirstOrDefault()?.Text;
        }
        catch (Exception)
        {
            args.Output = "The request returned no results. Try another request from the prompt suggestions.";
        }
    }

    private void OnAIButtonClick(MedicalRecordDto dataItem, MouseEventArgs args)
    {
        DataItemForAI = dataItem;
        Prompt = Commands.First().Prompt;

        _ = InlineAIPromptRef.ShowAsync(args.ClientX, args.ClientY);
    }

    private void OnCommandExecute(InlineAIPromptCommandExecuteEventArgs args)
    {
        Prompt = args.Command.Prompt;
    }

    private void OnOutputActionClick(InlineAIPromptOutputActionClickEventArgs args)
    {
        if (args.Action.Name == "Insert")
        {
            // This code updates the local data item only.
            // Also update the original data source.
            DataItemForAI.Info = args.Output;

            _ = InlineAIPromptRef.HideAsync();
        }
    }

    private string GetStatusThemeColor(MedicalRecordDto dataItem)
    {
        string themeColor = ThemeConstants.Chip.ThemeColor.Base;

        switch (dataItem.Status)
        {
            case "Awaiting Diagnosis":
                themeColor = ThemeConstants.Chip.ThemeColor.Base;
                break;
            case "Transferred":
                themeColor = ThemeConstants.Chip.ThemeColor.Base;
                break;
            case "Under Treatment":
                themeColor = ThemeConstants.Chip.ThemeColor.Info;
                break;
            case "In Surgery":
                themeColor = ThemeConstants.Chip.ThemeColor.Warning;
                break;
            case "Critical":
                themeColor = ThemeConstants.Chip.ThemeColor.Error;
                break;
            case "Monitoring":
                themeColor = ThemeConstants.Chip.ThemeColor.Info;
                break;
            case "Discharged":
                themeColor = ThemeConstants.Chip.ThemeColor.Success;
                break;
        }

        return themeColor;
    }

    protected override void OnInitialized()
    {
        GridData = PatientService.GetData();

        Prompt = Commands.First().Prompt;
    }

    public class CompletionRequestDto
    {
        [JsonPropertyName("role")]
        public string Role { get; set; } = "user";

        [JsonPropertyName("contents")]
        public List<ChatContentRequestDto> Contents { get; set; } = new();
    }

    public class ChatContentRequestDto
    {
        [JsonPropertyName("$type")]
        public string Type { get; set; } = "text";

        [JsonPropertyName("text")]
        public string Text { get; set; } = string.Empty;
    }

    public class CompletionResponseDto
    {
        [JsonPropertyName("messages")]
        public List<CompletionRequestDto> Messages { get; set; }
    }
}
