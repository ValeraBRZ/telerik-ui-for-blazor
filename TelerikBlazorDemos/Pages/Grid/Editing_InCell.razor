@page "/grid/editing-incell"

@using System.Collections.Generic;

@inject ProductService ProductService


<TelerikGrid Data=@GridData EditMode="@GridEditMode.Incell"
             Height="500px"
             Pageable="true" PageSize=@PageSize
             OnUpdate=@UpdateItem OnDelete=@DeleteItem OnCreate=@CreateItem>
    <GridToolBarTemplate>
        <GridCommandButton Command="Add" Icon="@SvgIcon.Plus">Add Product</GridCommandButton>
    </GridToolBarTemplate>
    <GridColumns>
        <GridColumn Field=@nameof(ProductDto.ProductName) Title="Product Name" Width="250px" />
        <GridColumn Field=@nameof(ProductDto.UnitsOnOrder) Title="On Order" Width="150px" />
        <GridColumn Field=@nameof(ProductDto.UnitsInStock) Title="In Stock" Width="150px" />
        <GridColumn Field=@nameof(ProductDto.UnitPrice) DisplayFormat="{0:C}" Title="Unit Price" Width="150px" />
        <GridColumn Field=@nameof(ProductDto.Discontinued) Title="Discontinued" Width="110px" />
        <GridCommandColumn Width="160px">
            <HeaderTemplate>
                <span style="display: flex; align-items: center; gap: var(--kendo-spacing-1);">
                    <TelerikSvgIcon Icon="@SvgIcon.Trash" /> <span>Delete Discontinued</span>
                </span>
            </HeaderTemplate>
            <Template>
                @if ((context as ProductDto).Discontinued == true)
                {
                    <GridCommandButton Command="Delete" Icon="@SvgIcon.Trash">Delete</GridCommandButton>
                }
            </Template>
        </GridCommandColumn>
    </GridColumns>
</TelerikGrid>

@code {
    int PageSize = 15;
    public List<ProductDto> GridData { get; set; }

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        GridData = ProductService.GetProducts().ToList();
    }

    private void CreateItem(GridCommandEventArgs args)
    {
        ProductService.CreateProduct((ProductDto)args.Item);
        LoadData();
    }

    private void DeleteItem(GridCommandEventArgs args)
    {
        ProductService.DeleteProduct((ProductDto)args.Item);
        LoadData();
    }

    private void UpdateItem(GridCommandEventArgs args)
    {
        ProductService.UpdateProduct((ProductDto)args.Item);
        LoadData();
    }
}
