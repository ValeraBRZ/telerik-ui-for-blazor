@page "/grid/editing-inline"

@inject ProductService ProductService

<DemoConfigurator>
    <DemoConfiguratorColumn>
        <TelerikButton OnClick="@(() => EnabledValidation = !EnabledValidation)">
            @if (EnabledValidation)
            {
                <span>Disable Built-in Validation</span>
            }
            else
            {
                <span>Enable Built-in Validation</span>
            }
        </TelerikButton>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<TelerikGrid Data=@GridData
             EditMode="@GridEditMode.Inline"
             Height="500px"
             Resizable="true"
             Pageable="true"
             PageSize="@PageSize"
             ConfirmDelete="true"
             OnUpdate="@UpdateItem"
             OnDelete="@DeleteItem"
             OnCreate="@CreateItem">
    <GridToolBarTemplate>
        <GridCommandButton Command="Add" Icon="@SvgIcon.Plus">Add Product</GridCommandButton>
    </GridToolBarTemplate>
    <GridSettings>
        <GridValidationSettings Enabled="@EnabledValidation" />
    </GridSettings>
    <GridColumns>
        <GridColumn Field=@nameof(ProductDto.ProductId) Width="80px" Title="ID" Editable="false" />
        <GridColumn Field=@nameof(ProductDto.ProductName) Width="200px" Title="Product Name" />
        <GridColumn Field=@nameof(ProductDto.UnitPrice) Width="140px" Title="Price" DisplayFormat="{0:C2}" />
        <GridColumn Field=@nameof(ProductDto.Discontinued) Width="160px" Title="Discontinued" />
        <GridColumn Field=@nameof(ProductDto.UnitsInStock) Width="160px" Title="Units" />
        <GridColumn Field=@nameof(ProductDto.QuantityPerUnit) Width="210px" Title="Quantity per unit" />
        <GridCommandColumn Width="250px">
            <HeaderTemplate>
                <span style="display: flex; align-items: center; gap: var(--kendo-spacing-1);">
                    <TelerikSvgIcon Icon="@SvgIcon.Gear" /> <span>Actions</span>
                </span>
            </HeaderTemplate>
            <Template>
                <GridCommandButton Command="Edit" Icon="@SvgIcon.Pencil" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">Edit</GridCommandButton>
                <GridCommandButton Command="Delete"
                                   Enabled="@((context as ProductDto).Discontinued == true)"
                                   Icon="@SvgIcon.Trash"
                                   ThemeColor="@GetButtonThemeColor(context as ProductDto)">Delete</GridCommandButton>


                <GridCommandButton Command="Save" Icon="@SvgIcon.Save" ShowInEdit="true">Update</GridCommandButton>
                <GridCommandButton Command="Cancel" Icon="@SvgIcon.Cancel" ShowInEdit="true">Cancel</GridCommandButton>
            </Template>
        </GridCommandColumn>
    </GridColumns>
</TelerikGrid>

@code {
    int PageSize = 15;
    public List<ProductDto> GridData { get; set; }
    public bool EnabledValidation { get; set; }

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        GridData = ProductService.GetProducts().ToList();
    }

    private void CreateItem(GridCommandEventArgs args)
    {
        ProductService.CreateProduct((ProductDto)args.Item);
        LoadData();
    }

    private void DeleteItem(GridCommandEventArgs args)
    {
        ProductService.DeleteProduct((ProductDto)args.Item);
        LoadData();
    }

    private void UpdateItem(GridCommandEventArgs args)
    {
        ProductService.UpdateProduct((ProductDto)args.Item);
        LoadData();
    }

    private string GetButtonThemeColor(ProductDto productDto)
    {
        if (productDto.Discontinued == true)
        {
            return ThemeConstants.Button.ThemeColor.Warning;
        }
        else
        {
            return ThemeConstants.Button.ThemeColor.Base;
        }
    }
}
