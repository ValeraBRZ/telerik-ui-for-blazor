@page "/grid/custom-filter-row"

@using Telerik.DataSource

@inject ProductService ProductService

<div class="demo-alert demo-alert-info">
    The <strong>Product Name</strong> and <strong>Price</strong> columns use custom filters, the other columns use the built-in filters.
</div>

<TelerikGrid Data=@GridData
             FilterMode="@GridFilterMode.FilterRow"
             Height="400px"
             Resizable="true"
             Pageable=true
             PageSize="10">
    <GridColumns>
        <GridColumn Field=@nameof(ProductDto.ProductName) Title="Product Name">
            <FilterCellTemplate>
                <TelerikComboBox Data="@Names"
                                 Value="@Name"
                                 Filterable="true"
                                 FilterOperator="@StringFilterOperator.Contains"
                                 Width="100%"
                                 ValueChanged="@(async (string val) =>
                                                 {
                                                     Name = val;

                                                     var filter = context.FilterDescriptor.FilterDescriptors[0] as FilterDescriptor;
                                                     filter.Value = Name;

                                                     if (string.IsNullOrEmpty(Name))
                                                     {
                                                         await context.ClearFilterAsync();
                                                     }
                                                     else
                                                     {
                                                        await context.FilterAsync();
                                                     }
                                                 })">
                </TelerikComboBox>
            </FilterCellTemplate>
        </GridColumn>
        <GridColumn Field=@nameof(ProductDto.QuantityPerUnit) Title="Quantity Per Unit" Width="220px" />
        <GridColumn Field=@nameof(ProductDto.UnitPrice) Title="Price" Width="300px">
            <FilterCellTemplate>
                <label for="min">Min:&nbsp;</label>
                <TelerikNumericTextBox Id="min"
                                       Value="@MinValue"
                                       ValueChanged="@(async (int? val) =>
                                                        {
                                                            MinValue = val;

                                                            SetMinMaxFilter(context.FilterDescriptor);

                                                            await context.FilterAsync();
                                                        })">
                </TelerikNumericTextBox>
                <label for="min">Max:&nbsp;</label>
                <TelerikNumericTextBox Id="max"
                                       Value="@MaxValue"
                                       ValueChanged="@(async (int? val) =>
                                                       {
                                                           MaxValue = val;

                                                           SetMinMaxFilter(context.FilterDescriptor);

                                                           await context.FilterAsync();
                                                       })">
                </TelerikNumericTextBox>
                <TelerikButton ButtonType="ButtonType.Button"
                               Class="k-clear-button-visible ml-sm"
                               Icon="@SvgIcon.FilterClear"
                               OnClick="@(async () =>
                                          {
                                              MinValue = MaxValue = null;

                                              SetMinMaxFilter(context.FilterDescriptor);

                                              await context.ClearFilterAsync();
                                          })">
                </TelerikButton>
            </FilterCellTemplate>
        </GridColumn>
        <GridColumn Field=@nameof(ProductDto.UnitsOnOrder) Title="Units On Order" />
    </GridColumns>
</TelerikGrid>

@code {
    public IEnumerable<ProductDto> GridData { get; set; }

    public List<string> Names { get; set; } = new List<string>();
    public string Name { get; set; }

    public int? MinValue { get; set; }
    public int? MaxValue { get; set; }

    protected override void OnInitialized()
    {
        GridData = ProductService.GetProducts();

        Names = GridData.Select(d => d.ProductName).Distinct().ToList();

        base.OnInitialized();
    }

    public void SetMinMaxFilter(CompositeFilterDescriptor filterDescriptor)
    {
        var maxFilter = new FilterDescriptor(nameof(ProductDto.UnitPrice), FilterOperator.IsLessThan, MaxValue);
        var minFilter = new FilterDescriptor(nameof(ProductDto.UnitPrice), FilterOperator.IsGreaterThan, MinValue);

        filterDescriptor.FilterDescriptors.Clear();

        if (MinValue != null)
        {
            filterDescriptor.FilterDescriptors.Add(minFilter);
        }

        if (MaxValue != null)
        {
            filterDescriptor.FilterDescriptors.Add(maxFilter);
        }

        if (!filterDescriptor.FilterDescriptors.Any())
        {
            filterDescriptor.FilterDescriptors.Add(new FilterDescriptor()
            {
                Member = nameof(ProductDto.UnitPrice)
            });
        }
    }
}

<style>
    .k-filtercell-wrapper {
        align-items: center;
    }

    .k-filtercell-wrapper label {
        margin: unset;
    }
</style>
