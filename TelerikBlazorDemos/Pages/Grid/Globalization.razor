@page "/grid/localization"
@page "/grid/globalization"

@using Telerik.Blazor.Services
@using TelerikBlazorDemos.Resources

@inject ITelerikStringLocalizer Localizer
@inject ProductService ProductService

<DemoConfigurator>
    <DemoConfiguratorColumn>
        <CultureChooser></CultureChooser>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<TelerikGrid Data=@GridData
             Height="500px"
             EditMode="@GridEditMode.Inline"
             Groupable="true"
             FilterMode="GridFilterMode.FilterMenu"
             Pageable="true"
             PageSize=@PageSize
             OnUpdate="@UpdateItem"
             OnDelete="@DeleteItem"
             OnCreate="@CreateItem">
    <GridToolBarTemplate>
        <GridCommandButton Command="Add" Icon="@SvgIcon.Plus">@Localizer[nameof(TelerikMessages.Grid_Create)]</GridCommandButton>
        <GridCommandButton Command="ExcelExport" Icon="@SvgIcon.FileExcel">@Localizer[nameof(TelerikMessages.Grid_Excel)]</GridCommandButton>
        <GridCommandButton Command="CsvExport" Icon="@SvgIcon.FileCsv">@Localizer[nameof(TelerikMessages.Grid_Csv)]</GridCommandButton>
    </GridToolBarTemplate>
    <GridColumns>
        <GridColumn Field=@nameof(ProductDto.ProductName) Title="Product Name" Width="280px" />
        <GridColumn Field=@nameof(ProductDto.UnitPrice) DisplayFormat="{0:C}" Title="Unit Price" Width="150px" />
        <GridColumn Field="@nameof(ProductDto.CategoryId)" Title="Category Id" Width="250px" />
        <GridColumn Field=@nameof(ProductDto.SupplierId) Title="Supplier Id" Width="200px" />
        <GridCommandColumn>
            <GridCommandButton Command="Edit" Icon="@SvgIcon.Pencil" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">@Localizer[nameof(TelerikMessages.Grid_Edit)]</GridCommandButton>
            <GridCommandButton Command="Delete" Icon="@SvgIcon.Trash">@Localizer[nameof(TelerikMessages.Grid_Delete)]</GridCommandButton>
            <GridCommandButton Command="Save" Icon="@SvgIcon.Save" ShowInEdit="true">@Localizer[nameof(TelerikMessages.Grid_Update)]</GridCommandButton>
            <GridCommandButton Command="Cancel" Icon="@SvgIcon.Cancel" ShowInEdit="true">@Localizer[nameof(TelerikMessages.Grid_Cancel)]</GridCommandButton>
        </GridCommandColumn>
    </GridColumns>
</TelerikGrid>

@code {
    int PageSize = 15;
    public List<ProductDto> GridData { get; set; }

    protected override void OnInitialized()
    {
        LoadData();
    }

    public void LoadData()
    {
        GridData = ProductService.GetProducts().ToList();
    }

    public void CreateItem(GridCommandEventArgs args)
    {
        ProductService.CreateProduct((ProductDto)args.Item);
        LoadData();
    }

    public void DeleteItem(GridCommandEventArgs args)
    {
        ProductService.DeleteProduct((ProductDto)args.Item);
        LoadData();
    }

    public void UpdateItem(GridCommandEventArgs args)
    {
        ProductService.UpdateProduct((ProductDto)args.Item);
        LoadData();
    }
}
