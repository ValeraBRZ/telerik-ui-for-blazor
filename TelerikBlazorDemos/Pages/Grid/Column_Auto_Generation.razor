@page "/grid/column-auto-generation"

@inject UrbanAreaService urbanAreaService

<TelerikGrid Data=@GridData
             AutoGenerateColumns="true"
             Width="100%"
             Pageable="true"
             Sortable="true"
             Groupable="true">
    <GridColumns>
        <GridAutoGeneratedColumns ColumnWidth="100px" />
    </GridColumns>
</TelerikGrid>

@code {
    public IEnumerable<UrbanAreaDto> GridData { get; set; }

    void LoadData()
    {
        GridData = urbanAreaService.GetUrbanAreas().Take(100);
    }

    protected override void OnInitialized()
    {
        LoadData();
    }
}
