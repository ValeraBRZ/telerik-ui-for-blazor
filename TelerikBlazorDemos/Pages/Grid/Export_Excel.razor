@page "/grid/export-excel"

@inject ProductService ProductService

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Select columns for export">
        <TelerikMultiSelect @bind-Value="@ExportColumns" Data="@Colummns">
            <MultiSelectSettings>
                <MultiSelectPopupSettings Height="auto"></MultiSelectPopupSettings>
            </MultiSelectSettings>
        </TelerikMultiSelect>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Export">
        <TelerikCheckBox Id="cancel-export" @bind-Value="@CancelExport"></TelerikCheckBox>
        <label for="cancel-export">Cancel Export</label>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<TelerikGrid Data=@GridData Pageable="true" Groupable="true" Sortable="true"
             FilterMode="GridFilterMode.FilterMenu" Resizable="true" Reorderable="true">
    <GridToolBarTemplate>
        <GridCommandButton Command="ExcelExport" Icon="@SvgIcon.FileExcel">Export to Excel</GridCommandButton>
        <label class="k-checkbox-label"><TelerikCheckBox @bind-Value="@ExportAllPages" /> Export All Pages</label>
    </GridToolBarTemplate>
    <GridExport>
        <GridExcelExport FileName="telerik-grid-export" AllPages="@ExportAllPages" OnBeforeExport="@OnBeforeExcelExport" />
    </GridExport>
    <GridColumns>
        <GridColumn Field="@nameof(ProductDto.ProductId)" Title="Id" Groupable="false" Width="75px" />
        <GridColumn Field="@nameof(ProductDto.ProductName)" Width="230px" />
        <GridColumn Field="@nameof(ProductDto.UnitsInStock)" Width="95px" />
        <GridColumn Field="@nameof(ProductDto.UnitsOnOrder)" Title="On Order" Width="90px" />
        <GridColumn Field="@nameof(ProductDto.ReorderLevel)" Width="100px" />
        <GridColumn Field="@nameof(ProductDto.QuantityPerUnit)" Width="250px" />
        <GridColumn Field="@nameof(ProductDto.UnitPrice)" Title="Price" Width="100px" />
    </GridColumns>
</TelerikGrid>

@code {
    public List<ProductDto> GridData { get; set; }
    bool ExportAllPages { get; set; }

    public List<string> Colummns { get; set; } = new List<string>() { nameof(ProductDto.ProductId), nameof(ProductDto.ProductName), nameof(ProductDto.UnitsInStock), nameof(ProductDto.UnitsOnOrder), nameof(ProductDto.ReorderLevel), nameof(ProductDto.QuantityPerUnit), nameof(ProductDto.UnitPrice) };

    public List<string> ExportColumns { get; set; } = new List<string>();

    public bool CancelExport {  get;  set; }

    protected override void OnInitialized()
    {
        GridData = ProductService.GetProducts().ToList();
    }

    public void OnBeforeExcelExport(GridBeforeExcelExportEventArgs args)
    {
        if (ExportColumns.Any())
        {
            args.Columns = args.Columns.Where(col => ExportColumns.Contains(col.Field)).ToList();
        }

        args.IsCancelled = CancelExport;
    }
}
