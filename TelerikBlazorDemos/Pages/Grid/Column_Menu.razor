@page "/grid/column-menu"

@inject ProductService ProductService

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Product Name in Column Chooser">
        <TelerikCheckBox @bind-Value="@ProductNameInChooser"
                         Id="ProductNameInChooser">
        </TelerikCheckBox>
        <label class="k-checkbox-label" for="ProductNameInChooser">Include Product Name</label>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Price Lockable">
        <TelerikCheckBox @bind-Value="@UnitPriceLockable"
                         Id="UnitPriceLockable">
        </TelerikCheckBox>
        <label class="k-checkbox-label" for="UnitPriceLockable">Enable Lockable</label>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Column Menu for Discontinued">
        <TelerikCheckBox @bind-Value="@DiscontinuedColumnMenu"
                         Id="DiscontinuedColumnMenu">
        </TelerikCheckBox>
        <label class="k-checkbox-label" for="DiscontinuedColumnMenu">Enable Column Menu</label>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Filter Mode">
        <TelerikRadioGroup Data="@FilterModes"
                           @bind-Value="@FilterMode"
                           Layout="RadioGroupLayout.Horizontal">
        </TelerikRadioGroup>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<TelerikGrid Data="@GridData"
             Width="100%"
             Height="350px"
             ShowColumnMenu="true"
             Sortable="true"
             Reorderable="true"
             Pageable="true"
             FilterMode="@FilterMode">
    <GridSettings>
        <GridColumnMenuSettings FilterMode="@(FilterMode == GridFilterMode.FilterRow? ColumnMenuFilterMode.None : ColumnMenuFilterMode.FilterMenu)">
        </GridColumnMenuSettings>
    </GridSettings>
    <GridColumns>
        <GridColumn Field=@nameof(ProductDto.ProductId) Width="120px" Title="ID" />
        <GridColumn Field=@nameof(ProductDto.ProductName) Width="200px" Title="Product Name" VisibleInColumnChooser="@ProductNameInChooser" />
        <GridColumn Field=@nameof(ProductDto.UnitPrice) Width="140px" Title="Price" Lockable="@UnitPriceLockable" />
        <GridColumn Field=@nameof(ProductDto.UnitsInStock) Width="160px" Title="In stock" />
        <GridColumn Field=@nameof(ProductDto.QuantityPerUnit) Width="210px" Title="Quantity per unit" />
        <GridColumn Field=@nameof(ProductDto.Discontinued) Width="160px" Title="Discontinued" ShowColumnMenu="@DiscontinuedColumnMenu" />
    </GridColumns>
</TelerikGrid>

@code {
    private IEnumerable<ProductDto> GridData { get; set; }

    private GridFilterMode FilterMode { get; set; } = GridFilterMode.FilterMenu;

    private List<GridFilterMode> FilterModes { get; set; } = new List<GridFilterMode>()
    {
        GridFilterMode.FilterMenu,
        GridFilterMode.FilterRow
    };

    private bool ProductNameInChooser { get; set; }

    private bool UnitPriceLockable { get; set; }

    private bool DiscontinuedColumnMenu { get; set; }

    protected override void OnInitialized()
    {
        GridData = ProductService.GetProducts();
    }
}
