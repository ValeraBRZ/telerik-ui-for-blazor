@page "/grid/editing-popup"

@inject ProductService ProductService

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Form Orientation">
        <TelerikDropDownList @bind-Value="@FormOrientation"
                             Data="@OrientationTypes">
            <DropDownListSettings>
                <DropDownListPopupSettings Height="auto"></DropDownListPopupSettings>
            </DropDownListSettings>
        </TelerikDropDownList>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<TelerikGrid Data=@GridData EditMode="@GridEditMode.Popup"
             Height="500px" Pageable="true" PageSize=@PageSize
             OnUpdate=@UpdateItem OnDelete=@DeleteItem OnCreate=@CreateItem>
    <GridToolBarTemplate>
        <GridCommandButton Command="Add" Icon="@SvgIcon.Plus">Add Product</GridCommandButton>
    </GridToolBarTemplate>
    <GridSettings>
        <GridPopupEditFormSettings Orientation="@FormOrientation"></GridPopupEditFormSettings>
    </GridSettings>
    <GridColumns>
        <GridColumn Field=@nameof(ProductDto.ProductId) Editable="false" />
        <GridColumn Field=@nameof(ProductDto.ProductName) />
        <GridColumn Field=@nameof(ProductDto.UnitsInStock) Title="Units In Stock" />
        <GridColumn Field=@nameof(ProductDto.UnitPrice) Title="Unit Price" />
        <GridColumn Field=@nameof(ProductDto.Discontinued) Title="Discontinued" />
        <GridCommandColumn Width="250px">
            <HeaderTemplate>
                <span style="display: flex; align-items: center; gap: var(--kendo-spacing-1);">
                    <TelerikSvgIcon Icon="@SvgIcon.Gear" /> <span>Actions</span>
                </span>
            </HeaderTemplate>
            <Template>
                <GridCommandButton Command="Edit" Icon="@SvgIcon.Pencil" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">Edit</GridCommandButton>
                <GridCommandButton Command="Delete"
                                   Enabled="@((context as ProductDto).Discontinued == true)"
                                   Icon="@SvgIcon.Trash"
                                   ThemeColor="@GetButtonThemeColor(context as ProductDto)">Delete</GridCommandButton>
            </Template>
        </GridCommandColumn>
    </GridColumns>
</TelerikGrid>

@code {
    public FormOrientation FormOrientation { get; set; }
    public List<FormOrientation> OrientationTypes { get; set; } = new List<FormOrientation>()
{
        FormOrientation.Horizontal,
        FormOrientation.Vertical,
    };

    int PageSize = 15;
    public List<ProductDto> GridData { get; set; }

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        GridData = ProductService.GetProducts().ToList();
    }

    private void CreateItem(GridCommandEventArgs args)
    {
        ProductService.CreateProduct((ProductDto)args.Item);
        LoadData();
    }

    private void DeleteItem(GridCommandEventArgs args)
    {
        ProductService.DeleteProduct((ProductDto)args.Item);
        LoadData();
    }

    private void UpdateItem(GridCommandEventArgs args)
    {
        ProductService.UpdateProduct((ProductDto)args.Item);
        LoadData();
    }

    private string GetButtonThemeColor(ProductDto productDto)
    {
        if (productDto.Discontinued == true)
        {
            return ThemeConstants.Button.ThemeColor.Warning;
        }
        else
        {
            return ThemeConstants.Button.ThemeColor.Base;
        }
    }
}
