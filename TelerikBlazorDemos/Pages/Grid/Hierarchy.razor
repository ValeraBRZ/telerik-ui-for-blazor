@page "/grid/hierarchy"

@inject CategoryService categoryService

<TelerikGrid Data="@GridData"
             Pageable="true"
             PageSize="10"
             Sortable="true">
    <GridColumns>
        <GridColumn Field=@nameof(CategoryDto.CategoryId) Title="Category ID" Width="100px" />
        <GridColumn Field=@nameof(CategoryDto.CategoryName) Title="Category Name" />
        <GridColumn Field=@nameof(CategoryDto.Description) />
    </GridColumns>

    <DetailTemplate>
        @{
            var category = context as CategoryDto;

            <TelerikGrid Data="@category.Products"
                         Height="300px"
                         Pageable="true"
                         Sortable="true"
                         PageSize="5">
                <GridColumns>
                    <GridColumn Field=@nameof(ProductDto.ProductId) Title="Product ID" />
                    <GridColumn Field=@nameof(ProductDto.ProductName) Title="Product Name" />
                    <GridColumn Field=@nameof(ProductDto.UnitPrice) Title="Unit Price" />
                </GridColumns>
            </TelerikGrid>
        }
    </DetailTemplate>
</TelerikGrid>

@code {
    public IEnumerable<CategoryDto> GridData { get; set; }

    protected override void OnInitialized()
    {
        GridData = categoryService.GetProductCategories();

        base.OnInitialized();
    }
}

