@page "/grid/custom-column-menu"

@inject ProductService ProductService

<div class="demo-alert demo-alert-info">
    <p>
        Click the three dots in the column header to see the
        column menu and open the "Columns" section for a customized view of the column list.
    </p>
</div>

<TelerikGrid Data="@GridData"
             Width="100%"
             Height="350px"
             ShowColumnMenu="true"
             Sortable="true"
             Reorderable="true"
             Pageable="true">
    <GridSettings>
        <GridColumnMenuSettings Sortable="true"
                                FilterMode="@ColumnMenuFilterMode.FilterMenu"
                                ShowColumnChooser="true">
            <GridColumnMenuChooser>
                <Template>
                    <GridColumnMenuChooserGroup Title="Product">
                        <GridColumnMenuChooserItem Title="Id"
                                                   ColumnId="@nameof(ProductDto.ProductId)">
                        </GridColumnMenuChooserItem>

                        <GridColumnMenuChooserItem Title="Name"
                                                   ColumnId="@nameof(ProductDto.ProductName)">
                        </GridColumnMenuChooserItem>
                    </GridColumnMenuChooserGroup>

                    <GridColumnMenuChooserGroup Title="Storage">
                        <GridColumnMenuChooserItem Title="Quantity"
                                                   ColumnId="@nameof(ProductDto.QuantityPerUnit)">
                        </GridColumnMenuChooserItem>

                        <GridColumnMenuChooserItem Title="In stock"
                                                   ColumnId="@nameof(ProductDto.UnitsInStock)">
                        </GridColumnMenuChooserItem>
                    </GridColumnMenuChooserGroup>
                </Template>
            </GridColumnMenuChooser>
        </GridColumnMenuSettings>
    </GridSettings>

    <GridColumns>
        <GridColumn Field="@nameof(ProductDto.ProductId)" Id="@nameof(ProductDto.ProductId)" Width="120px" Title="ID" />
        <GridColumn Field="@nameof(ProductDto.ProductName)" Id="@nameof(ProductDto.ProductName)" Width="200px" Title="Product Name" />
        <GridColumn Field="@nameof(ProductDto.UnitPrice)" Id="@nameof(ProductDto.UnitPrice)" Width="140px" Title="Price" />
        <GridColumn Field="@nameof(ProductDto.UnitsInStock)" Id="@nameof(ProductDto.UnitsInStock)" Width="160px" Title="In stock" />
        <GridColumn Field="@nameof(ProductDto.QuantityPerUnit)" Id="@nameof(ProductDto.QuantityPerUnit)" Width="210px" Title="Quantity per unit" />
        <GridColumn Field="@nameof(ProductDto.Discontinued)" Width="160px" Title="Discontinued" />
    </GridColumns>
</TelerikGrid>

@code {
    public IEnumerable<ProductDto> GridData { get; set; }

    protected override void OnInitialized()
    {
        GridData = ProductService.GetProducts();
    }
}
