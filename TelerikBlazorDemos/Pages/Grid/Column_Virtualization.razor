@page "/grid/column-virtualization"

@inject ProductService ProductService

<div class="demo-alert demo-alert-info">
    The "Product Id" column is frozen and will remain visible during horizontal grid scrolling.
</div>

<TelerikGrid ColumnVirtualization="true"
             RowHeight="60" Height="450px" Width="800px"
             Data="@GridData"
             Pageable="true"
             FilterMode="@GridFilterMode.FilterMenu"
             Sortable="true"
             Groupable="true">
    <GridColumns>
        <GridColumn Field="@nameof(ProductDto.ProductId)" Title="Product Id" Width="200px" Locked="true" />
        <GridColumn Field="@nameof(ProductDto.ProductName)" Title="Product Name" Width="200px" />
        <GridColumn Field="@nameof(ProductDto.CategoryId)" Title="Product Category Id" Width="200px" />
        <GridColumn Field="@nameof(ProductDto.ReorderLevel)" Title="Reorder Level" Width="200px" />
        <GridColumn Field="@nameof(ProductDto.QuantityPerUnit)" Title="Quantity Per Unit" Width="200px" />
        <GridColumn Field="@nameof(ProductDto.UnitsInStock)" Title="Product Color" Width="200px" />
        <GridColumn Field="@nameof(ProductDto.UnitsOnOrder)" Title="Units On Order" Width="200px" />
        <GridColumn Field="@nameof(ProductDto.UnitPrice)" Title="Unit Price" Width="200px" />
        <GridColumn Field="@nameof(ProductDto.Discontinued)" Title="Discontinued" Width="200px" />
        <GridColumn Field="@nameof(ProductDto.SupplierId)" Title="Supplier Id" Width="200px" />
    </GridColumns>
</TelerikGrid>

@code {
    public List<ProductDto> GridData { get; set; }

    protected override void OnInitialized()
    {
        GridData = ProductService.GetProducts().ToList();
    }
}
