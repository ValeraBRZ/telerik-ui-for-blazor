@page "/grid/filter-menu"

@using Telerik.DataSource

@inject ProductService ProductService

<div class="demo-alert demo-alert-info">
    The <strong>Product Name</strong> column has <strong>DefaultFilterOperator</strong>. The <strong>Price</strong> column uses customized list of <strong>FilterOperators</strong>.
</div>

<TelerikGrid Data=@GridData
             Height=@Height
             FilterMode="@GridFilterMode.FilterMenu"
             Pageable=true PageSize=@PageSize>
    <GridColumns>
        <GridColumn Field=@nameof(ProductDto.ProductName) Title="Product Name" DefaultFilterOperator="@FilterOperator.StartsWith" />
        <GridColumn Field=@nameof(ProductDto.ProductId) Title="Product Number" />
        <GridColumn Field=@nameof(ProductDto.CategoryName) Title="Category" />
        <GridColumn Field=@nameof(ProductDto.UnitPrice) Title="Price" FilterOperators="@NumericOperators" />
        <GridColumn Field=@nameof(ProductDto.UnitsInStock) Title="Units In Stock" />
        <GridColumn Field=@nameof(ProductDto.Discontinued) Title="Discontinued" />
    </GridColumns>
</TelerikGrid>

@code {
    public IEnumerable<ProductDto> GridData { get; set; }
    int PageSize = 10;
    string Height = "400px";

    protected override void OnInitialized()
    {
        GridData = ProductService.GetProducts();
    }

    public List<FilterListOperator> NumericOperators { get; set; } = new List<FilterListOperator>()
    {
        new FilterListOperator { Operator = FilterOperator.IsEqualTo, Text = "Equals" },
        new FilterListOperator { Operator = FilterOperator.IsLessThan, Text = "Smaller than" },
        new FilterListOperator { Operator = FilterOperator.IsGreaterThan, Text = "Larger than" },
        new FilterListOperator { Operator = FilterOperator.IsLessThanOrEqualTo, Text = "Smaller than or equals" },
        new FilterListOperator { Operator = FilterOperator.IsGreaterThanOrEqualTo, Text = "Larger than or equals" }
    };
}
