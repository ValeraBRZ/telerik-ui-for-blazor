@page "/multiselect/custom-filtering"

@using Telerik.DataSource;
@using Telerik.DataSource.Extensions;

<div class="demo-alert demo-alert-info">In this example, the Telerik DataSource is used to filter existing data to skip the first 10 items.</div>

<div class="demo-section k-form k-form-md k-form-vertical">
    <div class="k-form-field">
        <label for="countries" class="k-label k-form-label">Countries</label>
        <div class="k-form-field-wrap">
            <TelerikMultiSelect @bind-Value="@CountryIds"
                                TItem="Country" TValue="int"
                                ValueField="Id"
                                TextField="Name"
                                OnRead=@ReadCountries
                                Filterable="true"
                                Placeholder="Enter your preferred destinations"
                                Id="countries"
                                Width="100%">
            </TelerikMultiSelect>
        </div>
    </div>
</div>

@code {
    List<Country> AllCountries { get; set; }
    List<int> CountryIds { get; set; }
    List<Country> Countries { get; set; }

    class Country
    {
        public int Id { get; set; }
        public string Name { get; set; }

        public Country()
        {

        }

        public Country(int id, string name)
        {
            Id = id;
            Name = name;
        }
    }

    protected void ReadCountries(MultiSelectReadEventArgs args)
    {
        EnsureData();

        //add manual filter - show only countries with ID greater than 10
        args.Request.Filters.Add(new FilterDescriptor("Id", FilterOperator.IsGreaterThan, 10));

        var datasourceResult = AllCountries.ToDataSourceResult(args.Request);
        args.Data = datasourceResult.Data;
    }

    void EnsureData()
    {
        if (AllCountries == null)
        {
            AllCountries = new List<Country>()
            {
                new Country(0, "Albania"),
                new Country(1, "Andorra"),
