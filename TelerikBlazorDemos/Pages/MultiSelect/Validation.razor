@page "/multiselect/validation"

@using System.ComponentModel.DataAnnotations

@if (string.IsNullOrEmpty(SuccessMessage))
{
    <TelerikForm Model="@Employee"
                    OnValidSubmit="@OnFormValidSubmit">
        <FormValidation>
            <DataAnnotationsValidator />
            <TelerikValidationSummary />
        </FormValidation>
        <FormItems>
            <FormItem Field="@nameof(Person.DestinationIds)">
                <Template>
                    <label for="destinations" class="k-label k-form-label">Destinations</label>
                    <div class="k-form-field-wrap">
                        <TelerikMultiSelect @bind-Value="@Employee.DestinationIds"
                                            Data="@Countries"
                                            AutoClose="false"
                                            ValueField="@nameof(Country.Id)"
                                            TextField="@nameof(Country.Name)"
                                            Placeholder="Enter Preferred Destinations"
                                            Id="destinations">
                        </TelerikMultiSelect>
                        <TelerikValidationMessage For="@(() => Employee.DestinationIds)" />
                    </div>
                </Template>
            </FormItem>
        </FormItems>
    </TelerikForm>
}
else
{
    <div class="demo-alert demo-alert-success" role="alert">
        @SuccessMessage
    </div>
}

@code {
    private Person Employee { get; set; } = new Person();

    private List<Country> Countries { get; set; }

    private string SuccessMessage { get; set; } = string.Empty;

    private async Task OnFormValidSubmit()
    {
        SuccessMessage = "Form Submitted Successfully!";
        await Task.Delay(2000);

        SuccessMessage = string.Empty;
        Employee = new Person();
    }

    protected override void OnInitialized()
