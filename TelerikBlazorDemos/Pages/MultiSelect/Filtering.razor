    #region Demo configurator options

    private bool Filterable { get; set; } = true;

    private bool PersistFilter { get; set; } = true;

    private bool AutoClose { get; set; }

    private int DebounceDelay { get; set; } = 200;

    private int MinLength { get; set; }

    private StringFilterOperator FilterOperator { get; set; } = StringFilterOperator.Contains;

    private List<StringFilterOperator> filterOperators { get; set; } = new List<StringFilterOperator>()
    {
        StringFilterOperator.Contains,
        StringFilterOperator.DoesNotContain,
        StringFilterOperator.EndsWith,
        StringFilterOperator.IsContainedIn,
        StringFilterOperator.StartsWith
    };

    private void OnChangeHandler()
    {
        if (!Filterable || AutoClose)
        {
            PersistFilter = false;
        }
    }

    #endregion Demo configurator options
}
