@page "/multiselect/filtering"

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Enable filtering">
        <TelerikCheckBox @bind-Value="@Filterable" Id="filterableCheckBox" OnChange="@OnChangeHandler"></TelerikCheckBox>
        <label class="k-checkbox-label" for="filterableCheckBox">Filterable</label>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Close on select">
        <TelerikCheckBox @bind-Value="@AutoClose" Id="autoCloseCheckBox" OnChange="@OnChangeHandler"></TelerikCheckBox>
        <label class="k-checkbox-label" for="autoCloseCheckBox">Auto Close</label>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Perist filter on select">
        <TelerikCheckBox @bind-Value="@PersistFilter" Enabled="@(Filterable && !AutoClose)" Id="persistFilterCheckBox"></TelerikCheckBox>
        <label class="@(Filterable && !AutoClose ? "" : "k-disabled") k-checkbox-label" for="persistFilterCheckBox">Persist Filter</label>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description=" Select the filter operator">
        <TelerikDropDownList @bind-Value="@FilterOperator"
                             Data="@filterOperators"
                             Enabled="@Filterable"
                             Width="100%" />
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Debounce Delay">
        <TelerikNumericTextBox @bind-Value="@DebounceDelay" Min="0" Max="1000" />
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Minimum input length to show popup ">
        <TelerikNumericTextBox @bind-Value="@MinLength" Min="0" Max="10"></TelerikNumericTextBox>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<div class="demo-section">
    <label for="basic" class="k-label k-form-label">Destinations:</label>
    <TelerikMultiSelect Data="@Countries"
                        @bind-Value="@SelectedCountries"
                        Filterable="@Filterable"
                        AutoClose="@AutoClose"
                        PersistFilterOnSelect="@PersistFilter"
                        FilterOperator="@FilterOperator"
                        DebounceDelay="@DebounceDelay"
                        MinLength="@MinLength"
                        Placeholder="Enter your preferred destinations">
        <NoDataTemplate>
            <strong>
                <TelerikSvgIcon Icon="@SvgIcon.InfoCircle" /> There are no such items...
            </strong>
        </NoDataTemplate>
    </TelerikMultiSelect>
</div>

@code {
    private List<string> SelectedCountries { get; set; } = new List<string>();

