@page "/pivotgrid/templates"

<TelerikPivotGrid Height="600px"
                  TItem="object"
                  DataProviderType="@PivotGridDataProviderType.Xmla">
    <PivotGridSettings>
        <PivotGridXmlaDataProviderSettings ServerUrl="https://demos.telerik.com/service/v2/olap/msmdpump.dll"
                                           Catalog="Adventure Works DW 2008R2"
                                           Cube="Adventure Works">
        </PivotGridXmlaDataProviderSettings>
    </PivotGridSettings>

    <ColumnHeaderTemplate>
        @{
            var c = (PivotGridColumnHeaderTemplateContext)context;
        }
        <span class="templated-column-header">
            <TelerikSvgIcon Icon="@SvgIcon.Categorize"
                            Size="@ThemeConstants.SvgIcon.Size.Medium">
            </TelerikSvgIcon>
            @c.Text
        </span>
    </ColumnHeaderTemplate>

    <RowHeaderTemplate>
        @{
            var c = (PivotGridRowHeaderTemplateContext)context;
        }

        <span class="templated-row-header">
            <TelerikSvgIcon Icon="@SvgIcon.MapMarker"
                            Size="@ThemeConstants.SvgIcon.Size.Medium">
            </TelerikSvgIcon>
            @c.Text
        </span>

    </RowHeaderTemplate>

    <DataCellTemplate Context="dataCellContext">
        @{
            var c = (PivotGridDataCellTemplateContext)dataCellContext;

            if (c.Value != null)
            {
                isTooExpensive = (double)c.Value > 10000 ? true : false;
            }
        }
        <span style="color: @(isTooExpensive ? "red" : "green")">@c.FormattedValue</span>
    </DataCellTemplate>

    <PivotGridRows>
        <PivotGridRow Name="[Geography].[Country]"></PivotGridRow>
        <PivotGridRow Name="[Geography].[City]"></PivotGridRow>
    </PivotGridRows>

    <PivotGridColumns>
        <PivotGridColumn Name="[Product].[Category]"></PivotGridColumn>
        <PivotGridColumn Name="[Product].[Model Name]"></PivotGridColumn>
    </PivotGridColumns>

    <PivotGridMeasures>
        <PivotGridMeasure Name="[Measures].[Reseller Freight Cost]"></PivotGridMeasure>
    </PivotGridMeasures>
</TelerikPivotGrid>

@code{

    private bool isTooExpensive{ get; set; }
}
