@page "/pivotgrid/local-data-binding"

<TelerikPivotGrid Data="@Data"
                  DataProviderType="@PivotGridDataProviderType.Local">
    <PivotGridRows>
        <PivotGridRow Name="@nameof(PivotOrderDetails.CategoryName)"></PivotGridRow>
        <PivotGridRow Name="@nameof(PivotOrderDetails.ProductName)"></PivotGridRow>
    </PivotGridRows>

    <PivotGridColumns>
        <PivotGridColumn Name="@nameof(PivotOrderDetails.Year)"></PivotGridColumn>
        <PivotGridColumn Name="@nameof(PivotOrderDetails.Quarter)"></PivotGridColumn>
    </PivotGridColumns>

    <PivotGridMeasures>
        <PivotGridMeasure Name="@nameof(PivotOrderDetails.Quantity)" Aggregate="@PivotGridAggregateType.Sum"></PivotGridMeasure>
    </PivotGridMeasures>
</TelerikPivotGrid>

