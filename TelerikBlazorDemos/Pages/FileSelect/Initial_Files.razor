@page "/fileselect/initial-files"

<div class="demo-section k-form k-form-md k-form-horizontal">
    <div class="k-form-field-wrap">
        <TelerikFileSelect Files="@InitialFiles"
                           AllowedExtensions="@AllowedExtensions"
                           MinFileSize="@MinFileSize"
                           MaxFileSize="@MaxFileSize">
        </TelerikFileSelect>
        <div class="k-form-hint">
            Expected files: <strong>DOCX, PDF, JPG, PNG</strong>
            between <strong>1KB</strong> and <strong>4MB</strong>.
        </div>
    </div>
</div>

<style>
    .k-form-hint {
        display: block;
        margin-top: 1em;
    }
</style>


@code {
    public List<string> AllowedExtensions { get; set; } = new List<string>() { ".docx", ".pdf", ".jpg", ".png" };
    public int MinFileSize { get; set; } = 1024; // 1 MB
    public int MaxFileSize { get; set; } = 4 * 1024 * 1024; // 4 MB

    private List<FileSelectFileInfo> InitialFiles { get; set; } = new List<FileSelectFileInfo>()
    {
        new FileSelectFileInfo()
        {
            Id="1",
            Name="Report",
            Extension=".pdf",
            Size = 1024 * 1024 * 2 // 2 MB
        },
        new FileSelectFileInfo()
        {
            Id="2",
            Name="Portrait",
            Extension=".jpg",
            Size = 1024 * 1024 * 2 // 2 MB
        },
        new FileSelectFileInfo()
        {
            Id="3",
            Name="Logo",
            Extension=".png",
            Size = 1024 * 1024 * 3 // 3 MB
        },
    };
}
