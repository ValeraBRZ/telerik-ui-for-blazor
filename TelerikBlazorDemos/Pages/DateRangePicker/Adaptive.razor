@page "/daterangepicker/adaptive"

<div class="demo-alert demo-alert-info" role="alert">
    <p>
        Resize the browser to see how the DateRangePicker adapts to different resolutions.
    </p>
</div>

<div class="demo-section">
    <label for="picker" class="k-label k-form-label">Set date range</label>
    <TelerikDateRangePicker @bind-StartValue="@StartValue"
                            @bind-EndValue="@EndValue"
                            Title="Set date range"
                            Size="@ThemeConstants.DateRangePicker.Size.Large"
                            AdaptiveMode="@AdaptiveMode.Auto">
    </TelerikDateRangePicker>
</div>

@code {
    public DateTime? StartValue { get; set; } = new DateTime(2025, 11, 22, 9, 48, 53);
    public DateTime? EndValue { get; set; } = new DateTime(2025, 11, 27, 9, 48, 53);
}
