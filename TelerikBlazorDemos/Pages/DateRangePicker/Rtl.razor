@page "/daterangepicker/rtl"

<div class="demo-section auto">
    <TelerikDateRangePicker @bind-StartValue="@StartValue"
                            @bind-EndValue="@EndValue">
    </TelerikDateRangePicker>
</div>

@code {
    public DateTime StartValue { get; set; } = new DateTime(2025, 4, 3);
    public DateTime EndValue { get; set; } = new DateTime(2025, 4, 10);
}
