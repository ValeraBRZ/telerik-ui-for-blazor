@page "/daterangepicker/two-digit-year-format"

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Two-digit year max">
        <TelerikNumericTextBox @bind-Value="@TwoDigitYearMax" Min="1" Max="99" />
    </DemoConfiguratorColumn>
</DemoConfigurator>

<div class="demo-section k-form k-form-md k-form-vertical">
    <div class="k-form-field">
        <label for="travel-date" class="k-label k-form-label">Selected Date</label>
        <div class="k-form-field-wrap">
            <TelerikDateRangePicker @bind-StartValue="@StartValue"
                                    @bind-EndValue="@EndValue"
                                    Title="Set date range"
                                    Format="dd/MMM/yy"
                                    TwoDigitYearMax="@TwoDigitYearMax">
            </TelerikDateRangePicker>
        </div>
    </div>
    <div class="k-form-field">
        <p>The selected date start is: <strong>@StartValue?.ToShortDateString()</strong></p>
        <p>The selected date end is: <strong>@EndValue?.ToShortDateString()</strong></p>
    </div>
</div>

@code {
    public DateTime? StartValue { get; set; } = new DateTime(2025, 11, 22, 9, 48, 53);
    public DateTime? EndValue { get; set; } = new DateTime(2025, 11, 27, 9, 48, 53);
    public int TwoDigitYearMax { get; set; } = 28;

}
