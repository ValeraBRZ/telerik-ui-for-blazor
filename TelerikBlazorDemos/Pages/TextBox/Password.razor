@page "/textbox/password"

@using System.ComponentModel.DataAnnotations

<div class="box-content" style="margin: auto;">
    <EditForm Model="@PasswordModel" OnValidSubmit="@HandleValidSubmit">
        <DataAnnotationsValidator />
        <div class="k-validation-summary k-messagebox k-messagebox-error p-0" role="alert">
            <ValidationSummary />
        </div>

        <h4 class="mb-sm">Your Password</h4>

        <TelerikTextBox Placeholder="Enter Password"
                        Password="HidePassword"
                        Width="200px"
                        @bind-Value="@PasswordModel.Password"></TelerikTextBox>
        <TelerikButton OnClick="@RevealPassword"
                       Icon="@SvgIcon.Unlock"
                       ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)"
                       ButtonType="ButtonType.Button"></TelerikButton>

        <h4 class="mb-sm">Confirm Password</h4>

        <TelerikTextBox Password="@HideConfirmPassword"
                        Placeholder="Re-Enter Your Password"
                        Width="200px"
                        @bind-Value="@PasswordModel.ConfirmPassword"></TelerikTextBox>
        <TelerikButton OnClick="@RevealConfirmPassword"
                       Icon="@SvgIcon.Unlock"
                       ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)"
                       ButtonType="ButtonType.Button"></TelerikButton>
        <TelerikButton Class="mt-md"
                       ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)"
                       ButtonType="@ButtonType.Submit">Update password</TelerikButton>
    </EditForm>

    <p>@OutputMessage</p>

</div>

@code {
    public ChangePasswordModel PasswordModel { get; set; } = new ChangePasswordModel();

    public bool HidePassword { get; set; } = true;
    public bool HideConfirmPassword { get; set; } = true;

    public string OutputMessage { get; set; }

    public async Task RevealPassword()
    {
        HidePassword = false;
        await Task.Delay(700);
        HidePassword = true;
    }

    public async Task RevealConfirmPassword()
    {
        HideConfirmPassword = false;
        await Task.Delay(700);
        HideConfirmPassword = true;
    }

    public async Task HandleValidSubmit()
    {
        OutputMessage = "You successfully updated your password";

        await Task.Delay(2000);

        PasswordModel.Password = null;
        PasswordModel.ConfirmPassword = null;
        OutputMessage = null;
        StateHasChanged();
    }

    public class ChangePasswordModel
    {
        [Required]
        [StringLength(26, MinimumLength = 8)]
        [RegularExpression(
            @"^(?=.*?[a-z])(?=.*?[0-9]).{6,}$", // This is a very weak password requirement to make the demo easy to review. You should enforce stronger requirements
            ErrorMessage = "Password should have •  At least one lower case letter • At least one digit • Minimum 6 in length")]
        public string Password { get; set; }

        [Required]
        [Compare(nameof(Password), ErrorMessage = "Passwords don't match.")]
        public string ConfirmPassword { get; set; }
    }
}
