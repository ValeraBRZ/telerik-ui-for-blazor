@page "/upload/validation"

@inject NavigationManager NavigationManager

<div class="demo-section k-form k-form-md">
    <h6 class="kd-demo-heading">Upload PDF</h6>
    <div class="k-form-field">
        <div class="k-form-field-wrap">
            <TelerikUpload SaveUrl="@SaveUrl"
                           RemoveUrl="@RemoveUrl"
                           AllowedExtensions="@(new List<string>() { ".pdf" })">
            </TelerikUpload>
            <div class="k-form-hint">You can only upload <strong> PDF </strong> files.</div>
        </div>
    </div>
    <h6 class="kd-demo-heading">Upload Image</h6>
    <div class="k-form-field">
        <div class="k-form-field-wrap">
            <TelerikUpload SaveUrl="@SaveUrl"
                           RemoveUrl="@RemoveUrl"
                           AllowedExtensions="@(new List<string>() { ".gif", ".jpg", ".png" })">
            </TelerikUpload>
            <div class="k-form-hint">You can only upload <strong> GIF</strong>, <strong> JPG</strong>, <strong> PNG</strong> files.</div>
        </div>
    </div>

    <h6 class="kd-demo-heading">Size Validation</h6>

    <div class="k-form-field">
        <div class="k-form-field-wrap">
            <TelerikUpload SaveUrl="@SaveUrl"
                           RemoveUrl="@RemoveUrl"
                           MaxFileSize="4194304">
            </TelerikUpload>
            <div class="k-form-hint">Maximum allowed file size is <strong> 4MB</strong></div>
        </div>
    </div>
</div>

@code {
    public string SaveUrl => ToAbsoluteUrl("api/upload/save");
    public string RemoveUrl => ToAbsoluteUrl("api/upload/remove");
    public int MinFileSize { get; set; } = 1024;
    public int MaxFileSize { get; set; } = 4 * 1024 * 1024;

    public string ToAbsoluteUrl(string url)
    {
        return $"{NavigationManager.BaseUri}{url}";
    }
}

<style>
    .k-upload-files {
        max-height: 200px;
        overflow-y: auto;
    }

    .k-form-hint {
        display: block;
        margin-top: 1em;
    }

    .demo-section > .kd-demo-heading {
        padding-bottom: 0;
        margin-bottom: 1em;
    }

</style>
