@page "/dateinput/appearance"

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Fill Mode">
        <TelerikDropDownList TextField="Key" ValueField="Value" Data="@FillModes" @bind-Value="@FillMode" Width="150px"><DropDownListSettings><DropDownListPopupSettings Height="auto"></DropDownListPopupSettings></DropDownListSettings></TelerikDropDownList>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Rounded">
        <TelerikDropDownList TextField="Key" ValueField="Value" Data="@Roundesses" @bind-Value="@Rounded" Width="150px"><DropDownListSettings><DropDownListPopupSettings Height="auto"></DropDownListPopupSettings></DropDownListSettings></TelerikDropDownList>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Size">
        <TelerikDropDownList TextField="Key" ValueField="Value" Data="@Sizes" @bind-Value="@Size" Width="150px"><DropDownListSettings><DropDownListPopupSettings Height="auto"></DropDownListPopupSettings></DropDownListSettings></TelerikDropDownList>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<div class="demo-section auto">
    <TelerikDateInput @bind-Value="@Value"
                       Size="@Size"
                       Rounded="@Rounded"
                       FillMode="@FillMode">
    </TelerikDateInput>
</div>

@code {
    public string FillMode { get; set; } = ThemeConstants.DateInput.FillMode.Solid;
    public string Rounded { get; set; } = ThemeConstants.DateInput.Rounded.Medium;
    public string Size { get; set; } = ThemeConstants.DateInput.Size.Medium;

    public Dictionary<string, string> FillModes { get; set; } = new Dictionary<string, string>
    {
        { "Solid", ThemeConstants.DateInput.FillMode.Solid },
        { "Flat", ThemeConstants.DateInput.FillMode.Flat },
        { "Outline", ThemeConstants.DateInput.FillMode.Outline }
    };

    public Dictionary<string, string> Roundesses { get; set; } = new Dictionary<string, string>
    {
        { "Small", ThemeConstants.DateInput.Rounded.Small },
        { "Medium", ThemeConstants.DateInput.Rounded.Medium },
        { "Large", ThemeConstants.DateInput.Rounded.Large },
        { "Full", ThemeConstants.DateInput.Rounded.Full }
    };

    public Dictionary<string, string> Sizes { get; set; } = new Dictionary<string, string>
    {
        { "Small", ThemeConstants.DateInput.Size.Small },
        { "Medium", ThemeConstants.DateInput.Size.Medium },
        { "Large", ThemeConstants.DateInput.Size.Large }
    };

    public DateTime Value { get; set; } = DateTime.Now;
}
