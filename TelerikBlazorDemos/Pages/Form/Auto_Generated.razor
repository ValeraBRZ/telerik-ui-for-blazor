@page "/form/auto-generated"

@using TelerikBlazorDemos.Models.Form

<div class="demo-section">
    @if (ValidSubmit)
    {
        <div class="demo-alert demo-alert-success" role="alert">
            The form was submitted successfully.
        </div>
    }
    else
    {
        <TelerikForm Model="@TheUser"
                     OnValidSubmit="@HandleValidSubmit"
                     OnInvalidSubmit="@HandleInvalidSubmit">
            <FormValidation>
                <DataAnnotationsValidator></DataAnnotationsValidator>
            </FormValidation>
            <FormItems>
                <FormItem Field="EmployeeId" LabelText="ID"></FormItem>
                <FormItem Field="AgeInYears" Hint="Enter your age in years"></FormItem>
                <FormAutoGeneratedItems></FormAutoGeneratedItems>
            </FormItems>
        </TelerikForm>
    }
</div>

@code {
    public Person TheUser { get; set; } = new Person()
    {
        HireDate = new DateTime(2025, 10, 10),
        MeetingDate = new DateTime(2025, 3, 6)
    };
    public bool ValidSubmit { get; set; } = false;

    async void HandleValidSubmit()
    {
        ValidSubmit = true;

        await Task.Delay(2000);

        ValidSubmit = false;

        StateHasChanged();
    }

    void HandleInvalidSubmit()
    {
        ValidSubmit = false;
    }
}

