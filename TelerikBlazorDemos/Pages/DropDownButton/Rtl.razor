@page "/dropdownbutton/rtl"

<div class="demo-section auto">
    <TelerikDropDownButton>
        <DropDownButtonContent>
            <TelerikAvatar Type="AvatarType.Image" Size="@ThemeConstants.Avatar.Size.Small">
                <img src="images/customers/GOURL.jpg" />
            </TelerikAvatar>
                User Settings
            </DropDownButtonContent>

        <DropDownButtonItems>
            <DropDownButtonItem Icon="@SvgIcon.User">My Profile</DropDownButtonItem>
            <DropDownButtonItem Icon="@SvgIcon.Download">Downloads</DropDownButtonItem>
            <DropDownButtonItem Icon="@SvgIcon.QuestionCircle">Support</DropDownButtonItem>
            <DropDownButtonItem Icon="@SvgIcon.Logout">Log Out</DropDownButtonItem>
        </DropDownButtonItems>

    </TelerikDropDownButton>
</div>
