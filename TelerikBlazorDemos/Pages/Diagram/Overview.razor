@page "/diagram/overview"

@inject NavigationManager NavigationManager

<TelerikDiagram Height="900px" Zoom="1" MinZoom="0.3" MaxZoom="1.5">
    <DiagramLayout Type="@DiagramLayoutType.Tree"
                   Subtype="@DiagramLayoutSubtype.Down" />
    <DiagramConnectionDefaults FromConnector="@DiagramConnectionsFromConnector.Bottom"
                               ToConnector="@DiagramConnectionsToConnector.Top" />
    <DiagramShapeDefaults CornerRadius="6"
                          Height="89"
                          Width="300"
                          Visual="shapeVisualFunction">
        <DiagramShapeDefaultsContent Color="#212529" FontSize="20" FontWeight="bold" />
    </DiagramShapeDefaults>
    <DiagramShapes>
        @foreach (DiagramEmployee employee in Employees)
        {
            <DiagramShape @key="@employee"
                          Id="@( $"shape-{employee.Id}" )"
                          DataItem="@employee"
                          Source="@( $"{GetBaseUri()}images/diagram/{employee.Id}.png" )">
                <DiagramShapeFill Color="@employee.BackgroundColor" />
                <DiagramShapeStroke Color="@employee.BorderColor" Width="2" />
            </DiagramShape>
        }
    </DiagramShapes>
    <DiagramConnections>
        @foreach (DiagramEmployee employee in Employees)
        {
            if (employee.ParentId is not null)
            {
                <DiagramConnection @key="@employee"
                                   FromId="@( $"shape-{employee.ParentId}" )"
                                   ToId="@( $"shape-{employee.Id}" )" />
            }
        }
    </DiagramConnections>
</TelerikDiagram>

@* Move JavaSctipt code to a separate JS file *@
<script suppress-error="BL9992">
    function shapeVisualFunction(context) {
        let diagramNS = TelerikBlazor.DiagramCommon;

        let shapeGroup = new diagramNS.Group();

        // Most settings are obtained from the Diagram parameters (context...).
        // The text labels are obtained from the Shape DataItem (context.dataItem...).
        // In this specific case, the Shape background and border styles are available in both.

        shapeGroup.append(new diagramNS.Process({
            width: context.width,
            height: context.height,
            fill: {
                color: context.fill.color
            },
            stroke: {
                color: context.stroke.color,
                width: context.stroke.width
            },
            cornerRadius: context.cornerRadius
        }));

        shapeGroup.append(new diagramNS.Image({
            source: context.source,
            width: 64,
            height: 64,
            x: 16,
            y: 12
        }));

        shapeGroup.append(new diagramNS.TextBlock({
            text: clipText(context.dataItem.Name, 14),
            color: context.content.color,
            fontSize: context.content.fontSize,
            fontWeight: context.content.fontWeight,
            x: 96,
            y: 16
        }));

        shapeGroup.append(new diagramNS.TextBlock({
            text: clipText(context.dataItem.Title, 20),
            color: context.content.color,
            fontSize: "16",
            x: 96,
            y: 48
        }));

        return shapeGroup;
    }

    function clipText(text, maxLength) {
        if (text.length > maxLength) {
            return text.substring(0, maxLength) + "...";
        } else {
            return text;
        }
    }
</script>

