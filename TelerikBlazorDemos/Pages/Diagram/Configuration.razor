@page "/diagram/configuration"

@inject IJSRuntime js

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Layout Type">
        <TelerikDropDownList Data="@AllDiagramLayoutTypes"
                             @bind-Value="@DiagramLayoutType"
                             Width="120px">
            <DropDownListSettings>
                <DropDownListPopupSettings Height="auto" />
            </DropDownListSettings>
        </TelerikDropDownList>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Layout Sub Type">
        <TelerikDropDownList Data="@( DiagramLayoutType == DiagramLayoutType.Layered ? LayeredLayoutSubtypes : AllDiagramLayoutSubtypes )"
                             @bind-Value="@DiagramLayoutSubtype"
                             Enabled="@(DiagramLayoutType != DiagramLayoutType.Force)"
                             Width="180px">
            <DropDownListSettings>
                <DropDownListPopupSettings Height="auto" />
            </DropDownListSettings>
        </TelerikDropDownList>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Shape Type">
        <TelerikDropDownList Data="@AllDiagramShapeTypes"
                             @bind-Value="@DiagramShapeType"
                             Width="180px" />
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Connection Type">
        <TelerikDropDownList Data="@AllDiagramConnectionTypes"
                             @bind-Value="@DiagramConnectionType"
                             Width="180px">
            <DropDownListSettings>
                <DropDownListPopupSettings Height="auto" />
            </DropDownListSettings>
        </TelerikDropDownList>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<TelerikDiagram Id="diagram1" MinZoom="0.3" MaxZoom="1" Zoom="0.5">
    <DiagramLayout Type="@DiagramLayoutType" Subtype="@DiagramLayoutSubtype" />

    <DiagramShapeDefaults Type="@DiagramShapeType" Width="@DiagramShapeWidth">
        <DiagramShapeDefaultsContent Color="#000" FontSize="24" />
    </DiagramShapeDefaults>

    <DiagramConnectionDefaults Type="@DiagramConnectionType" />

    <DiagramShapes>
        <DiagramShape Id="shape1"
                      Source="@Base64SvgImage"
                      Type="@DiagramShapeType.Image"
                      Width="100">
        </DiagramShape>
        <DiagramShape Id="shape2">
            <DiagramShapeContent Text="1" Color="@DiagramContentColor" />
            <DiagramShapeFill Color="#707070" />
        </DiagramShape>
        <DiagramShape Id="shape3">
            <DiagramShapeContent Text="2" Color="@DiagramContentColor" />
            <DiagramShapeFill Color="#707070" />
        </DiagramShape>
        <DiagramShape Id="shape4">
            <DiagramShapeContent Text="3" Color="@DiagramContentColor" />
            <DiagramShapeFill Color="#707070" />
        </DiagramShape>
        <DiagramShape Id="shape5">
            <DiagramShapeContent Text="1-1" />
            <DiagramShapeFill Color="#d0d0d0" />
        </DiagramShape>
        <DiagramShape Id="shape6">
            <DiagramShapeContent Text="2-1" />
            <DiagramShapeFill Color="#d0d0d0" />
        </DiagramShape>
        <DiagramShape Id="shape7">
            <DiagramShapeContent Text="2-2" />
            <DiagramShapeFill Color="#d0d0d0" />
        </DiagramShape>
        <DiagramShape Id="shape8">
            <DiagramShapeContent Text="3-1" />
            <DiagramShapeFill Color="#d0d0d0" />
        </DiagramShape>
        <DiagramShape Id="shape9">
            <DiagramShapeContent Text="3-2" />
            <DiagramShapeFill Color="#d0d0d0" />
        </DiagramShape>
        <DiagramShape Id="shape10">
            <DiagramShapeContent Text="3-3" />
            <DiagramShapeFill Color="#d0d0d0" />
        </DiagramShape>
        <DiagramShape Id="shape11">
            <DiagramShapeContent Text="1-1-1" />
            <DiagramShapeFill Color="#fff" />
        </DiagramShape>
        <DiagramShape Id="shape12">
            <DiagramShapeContent Text="1-1-2" />
            <DiagramShapeFill Color="#fff" />
        </DiagramShape>
        <DiagramShape Id="shape13">
            <DiagramShapeContent Text="1-1-3" />
            <DiagramShapeFill Color="#fff" />
        </DiagramShape>
        <DiagramShape Id="shape14">
            <DiagramShapeContent Text="2-1-1" />
            <DiagramShapeFill Color="#fff" />
        </DiagramShape>
        <DiagramShape Id="shape15">
            <DiagramShapeContent Text="2-1-2" />
            <DiagramShapeFill Color="#fff" />
        </DiagramShape>
        <DiagramShape Id="shape16">
            <DiagramShapeContent Text="2-2-1" />
            <DiagramShapeFill Color="#fff" />
        </DiagramShape>
        <DiagramShape Id="shape17">
            <DiagramShapeContent Text="2-2-2" />
            <DiagramShapeFill Color="#fff" />
        </DiagramShape>
        <DiagramShape Id="shape18">
            <DiagramShapeContent Text="3-1-1" />
            <DiagramShapeFill Color="#fff" />
        </DiagramShape>
        <DiagramShape Id="shape19">
            <DiagramShapeContent Text="3-2-1" />
            <DiagramShapeFill Color="#fff" />
        </DiagramShape>
        <DiagramShape Id="shape20">
            <DiagramShapeContent Text="3-3-1" />
            <DiagramShapeFill Color="#fff" />
        </DiagramShape>
    </DiagramShapes>

    <DiagramConnections>
        <DiagramConnection FromId="shape1" ToId="shape2" />
        <DiagramConnection FromId="shape1" ToId="shape3" />
        <DiagramConnection FromId="shape1" ToId="shape4" />
        <DiagramConnection FromId="shape2" ToId="shape5" />
        <DiagramConnection FromId="shape3" ToId="shape6" />
        <DiagramConnection FromId="shape3" ToId="shape7" />
        <DiagramConnection FromId="shape4" ToId="shape8" />
        <DiagramConnection FromId="shape4" ToId="shape9" />
        <DiagramConnection FromId="shape4" ToId="shape10" />
        <DiagramConnection FromId="shape5" ToId="shape11" />
        <DiagramConnection FromId="shape5" ToId="shape12" />
        <DiagramConnection FromId="shape5" ToId="shape13" />
        <DiagramConnection FromId="shape6" ToId="shape14" />
        <DiagramConnection FromId="shape6" ToId="shape15" />
        <DiagramConnection FromId="shape7" ToId="shape16" />
        <DiagramConnection FromId="shape7" ToId="shape17" />
        <DiagramConnection FromId="shape8" ToId="shape18" />
        <DiagramConnection FromId="shape9" ToId="shape19" />
        <DiagramConnection FromId="shape10" ToId="shape20" />
    </DiagramConnections>
</TelerikDiagram>

<script suppress-error="BL9992">
    function centerDiagram(id) {
        let diagram = TelerikBlazor.getComponentById(id);
        if (diagram) {
            // Center Diagram and zoom out if necessary.
            diagram.widget.bringIntoView(diagram.widget.shapes);
        }
    }
</script>

@code {
    private DiagramLayoutType DiagramLayoutType { get; set; } = DiagramLayoutType.Tree;

    private DiagramLayoutSubtype DiagramLayoutSubtype { get; set; } = DiagramLayoutSubtype.Radial;

    private DiagramShapeType DiagramShapeType { get; set; } = DiagramShapeType.Circle;

    private DiagramConnectionType DiagramConnectionType { get; set; } = DiagramConnectionType.Cascading;

    private string DiagramContentColor => DiagramShapeType == DiagramShapeType.Text || DiagramShapeType == DiagramShapeType.Collate ? "#000" : "#fff";

    private double DiagramShapeWidth => DiagramShapeType == DiagramShapeType.Terminator ? 200 : 100;

    private void DiagramLayoutTypeChanged(bool newSelected, DiagramLayoutType newDiagramLayoutType)
    {
        if (newSelected)
        {
            DiagramLayoutType = newDiagramLayoutType;
        }
    }

    private void DiagramLayoutSubtypeChanged(bool newSelected, DiagramLayoutSubtype newDiagramLayoutSubtype)
    {
        if (newSelected)
        {
            DiagramLayoutSubtype = newDiagramLayoutSubtype;
        }
    }

    private void DiagramShapeTypeChanged(bool newSelected, DiagramShapeType newDiagramShapeType)
    {
        if (newSelected)
        {
            DiagramShapeType = newDiagramShapeType;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(1); // Wait for HTML and Diagram client instance.
            await js.InvokeVoidAsync("centerDiagram", "diagram1");
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private readonly List<DiagramLayoutType> AllDiagramLayoutTypes = new()
    {
        DiagramLayoutType.Force,
        DiagramLayoutType.Layered,
        DiagramLayoutType.Tree
    };

    private readonly List<DiagramLayoutSubtype> AllDiagramLayoutSubtypes = new()
    {
        DiagramLayoutSubtype.Down,
        DiagramLayoutSubtype.Left,
        DiagramLayoutSubtype.MindMapHorizontal,
        DiagramLayoutSubtype.MindMapVertical,
        DiagramLayoutSubtype.Radial,
        DiagramLayoutSubtype.Right,
        DiagramLayoutSubtype.TipOver,
        DiagramLayoutSubtype.Up
    };

    private readonly List<DiagramLayoutSubtype> LayeredLayoutSubtypes = new()
    {
        DiagramLayoutSubtype.Down,
        DiagramLayoutSubtype.Left,
        DiagramLayoutSubtype.Right,
        DiagramLayoutSubtype.Up
    };

    private readonly List<DiagramShapeType> AllDiagramShapeTypes = new()
    {
        DiagramShapeType.Circle,
        DiagramShapeType.Collate,
        DiagramShapeType.Database,
        DiagramShapeType.DataInputOutput,
        DiagramShapeType.DataStorage,
        DiagramShapeType.Decision,
        DiagramShapeType.Delay,
        DiagramShapeType.DirectAccessStorage,
        DiagramShapeType.Display,
        DiagramShapeType.Document,
        DiagramShapeType.Extract,
        DiagramShapeType.InternalStorage,
        DiagramShapeType.LogicalOr,
        DiagramShapeType.ManualInputOutput,
        DiagramShapeType.ManualOperation,
        DiagramShapeType.Merge,
        DiagramShapeType.MultipleDocuments,
        DiagramShapeType.OffPageConnector,
        DiagramShapeType.OnPageConnector,
        DiagramShapeType.PredefinedProcess,
        DiagramShapeType.Preparation,
        DiagramShapeType.Process,
        DiagramShapeType.Rectangle,
        DiagramShapeType.Sort,
        DiagramShapeType.SummingJunction,
        DiagramShapeType.Terminator,
        DiagramShapeType.Text
    };

    private readonly List<DiagramConnectionType> AllDiagramConnectionTypes = new()
    {
        DiagramConnectionType.Cascading,
        DiagramConnectionType.Polyline
    };

    private readonly string Base64SvgImage = "data:image/svg;base64,";
}
