@page "/marketing-campaigns/grid-performance"
@layout MainLayout
@implements IDisposable

@using System.Collections
@using System.Threading
@using Telerik.DataSource.Extensions

<TelerikTooltip TargetSelector=".k-draghandle">
    <Template>
        @refreshInterval ms
    </Template>
</TelerikTooltip>

<div class="financial-grid-wrapper">
    <div style="position: relative;">
        <TelerikLoaderContainer OverlayThemeColor="@ThemeConstants.Loader.ThemeColor.Light"
                                Visible="@loaderVisible">
            <Template>
                <TelerikLoader Type="@LoaderType.InfiniteSpinner"
                               Size="@ThemeConstants.Loader.Size.Large" />
            </Template>
        </TelerikLoaderContainer>
        <TelerikGrid @ref="@GridRef"
                     Class="financial-grid"
                     EnableLoaderContainer="false"
                     Height="440px"
                     ScrollMode="@GridScrollMode.Virtual"
                     RowHeight="36"
                     TItem="FinancialData"
                     OnRead="@OnRead"
                     PageSize="25"
                     ShowColumnMenu="true">
            <GridSettings>
                <GridColumnMenuSettings Lockable="false" Groupable="false" Reorderable="false" ShowColumnChooser="false">
                </GridColumnMenuSettings>
            </GridSettings>
            <GridToolBar>
                <GridToolBarCustomTool>
                    <div class="toolbar-item">
                        Rows:
                        <TelerikDropDownList Data="@DataSize" Value="@dataSize" ValueChanged="@(async (int value) => await OnDataSizeChanged(value))">
                            <DropDownListSettings>
                                <DropDownListPopupSettings Height="auto" />
                            </DropDownListSettings>
                        </TelerikDropDownList>
                    </div>
                    <GridToolBarCustomTool>
                        <div class="toolbar-item">
                            <div>Refresh rate:</div>
                            <TelerikSlider Min="50" Max="1000" SmallStep="250" ShowButtons="false" TickPosition="@SliderTickPosition.None" Value="@refreshInterval" ValueChanged="@((int value) => OnRefreshIntervalChanged(value))" />
                        </div>
                    </GridToolBarCustomTool>
                </GridToolBarCustomTool>
            </GridToolBar>
            <GridColumns>
                <GridColumn Field="@nameof(FinancialData.Company)" Width="260px" Title="Company"></GridColumn>
                <GridColumn Field="@nameof(FinancialData.AssetType)" Width="200px" Title="Assets Type">
                    <Template>
                        @{
                            var data = context as FinancialData;
                            var assetType = data.AssetType;

                            <div class="asset-icon-wrapper">
                                <div class="asset-icon">
                                    @{
                                        if (assetType == "Cash")
                                        {
                                            @CashIcon()
                                        }
                                        else if (assetType == "Securities")
                                        {
                                            @SecuritiesIcon()
                                        }
                                        else if (assetType == "Gold")
                                        {
                                            @GoldIcon()
                                        }
                                        else if (assetType == "Real Estate")
                                        {
                                            @RealEstateIcon()
                                        }
                                    }
                                </div>
                                @assetType
                            </div>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(FinancialData.Price)" Width="120px" TextAlign="@ColumnTextAlign.Right" DisplayFormat="{0:C}" ShowColumnMenu="false"></GridColumn>
                <GridColumn Field="@nameof(FinancialData.Change)" Width="150px" Title="Change">
                    <Template>
                        @{
                            var data = context as FinancialData;
                            var priceChange = data.Change;

                            var color = priceChange < 0 ? "#F31700" : "#37B400";

                            <div style="color: @color;">
                                <svg width="10"
                                     height="8"
                                     viewBox="0 0 10 8"
                                     fill="none"
                                     xmlns="http://www.w3.org/2000/svg">
                                    <path d="M5 7.75L0 0.25H10L5 7.75Z"
                                          fill=@color
                                          transform=@(color == "#F31700" ? string.Empty : "scale(1, -1) translate(0, -8)") />
                                </svg>
                                @priceChange
                            </div>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(FinancialData.Timeline)" Width="240px" Title="Timeline" ShowColumnMenu="false">
                    <Template>
                        @{
                            var data = context as FinancialData;
                            var timeline = data.Timeline;

                            @SparklineChart(timeline)
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(FinancialData.Status)" Title="Status">
                    <Template>
                        @{
                            var data = context as FinancialData;
                            var status = data.Status;

                            var color = status switch
                            {
                                "Filled" => "#0058E9",
                                "Rejected" => "#F31700",
                                "Open" => "#37B400",
                                _ => "#0058E9"
                            };

                            <div role="button" class="k-chip k-chip-md k-rounded-full k-chip-solid k-chip-solid-base" style="color: rgb(255, 255, 255); height: 20px; width: 55px; padding: 4px; gap: 0px; font-weight: 400; font-size: 10px; justify-content: center; line-height: 10px; letter-spacing: 0px; border: 1px solid @color; background-color: @color;">
                                <span class="k-chip-content" style="justify-content: center;">
                                    @data.Status
                                </span>
                            </div>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </TelerikGrid>
        <div class="financial-grid-status-bar">
            <div>Rows: @DataSize.First(x => x.Value == @dataSize).Text</div>
            <div>Load performance: @refreshInterval ms</div>
        </div>
    </div>
</div>

@code {
    private TelerikGrid<FinancialData> GridRef { get; set; }
    private List<DataSizeModel> DataSize = new List<DataSizeModel>
    {
        new DataSizeModel() { Value = 100, Text = "100" },
        new DataSizeModel() { Value = 5000, Text = "5,000" },
        new DataSizeModel() { Value = 10000, Text = "10,000" },
        new DataSizeModel() { Value = 25000, Text = "25,000" },
        new DataSizeModel() { Value = 50000, Text = "50,000" },
        new DataSizeModel() { Value = 100000, Text = "100,000" },
    };

    private bool loaderVisible = false;
    private int dataSize = 100;
    private Timer timer;
    private int refreshInterval = 250;
    private int[] refreshIntervalPresets = { 50, 250, 500, 1000 };

    private IEnumerable<FinancialData> Data { get; set; }
    private IEnumerable<FinancialData> CurrentData { get; set; }
    private int CurrentTotal { get; set; }

    #region Lifecycle Methods

    protected override void OnInitialized()
    {
        CreateRandomData(dataSize);

        base.OnInitialized();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            StartTimer();
        }

        base.OnAfterRender(firstRender);
    }

    public void Dispose()
    {
        timer?.Dispose();
    }

    #endregion Lifecycle Methods

    #region Timer Update

    private void StartTimer()
    {
        timer?.Dispose();
        timer = new Timer(UpdateTime, null, refreshInterval, refreshInterval);
    }

    private void UpdateTime(object state)
    {
        InvokeAsync(() => RandomlyUpdatePrices());
    }

    private void UpdateInterval()
    {
        StartTimer();
    }

    private void OnRefreshIntervalChanged(int value)
    {
        var closestValue = refreshIntervalPresets.OrderBy(x => Math.Abs(x - value)).First();
        refreshInterval = closestValue;
        UpdateInterval();
    }

    #endregion Timer Update

    private async Task OnDataSizeChanged(int value)
    {
        loaderVisible = true;

        CreateRandomData(value);

        // Artificial loader to simmulate remote work.
        await Task.Delay(2500);

        dataSize = value;
        loaderVisible = false;

        GridRef?.Rebind();
    }

    private void OnRead(GridReadEventArgs args)
    {
        var result = Data.ToDataSourceResult(args.Request);

        args.Data = result.Data;
        CurrentData = result.Data.Cast<FinancialData>();
        args.Total = CurrentTotal = result.Total;
    }

    #region Data Randomization Methods

    private void CreateRandomData(int count)
    {
        var data = new List<FinancialData>();
        var random = new Random();
        for (int i = 0; i < count; i++)
        {
            data.Add(new FinancialData
                {
                    Company = companies[(int)Math.Floor(random.NextDouble() * companies.Length)],
                    AssetType = assetTypes[(int)Math.Floor(random.NextDouble() * assetTypes.Length)],
                    Price = prices[(int)Math.Floor(random.NextDouble() * prices.Length)],
                    Change = changes[(int)Math.Floor(random.NextDouble() * changes.Length)],
                    Timeline = GetSparklineData(42),
                    Status = statuses[(int)Math.Floor(random.NextDouble() * statuses.Length)],
                });
        }

        Data = data;
    }

    private void RandomlyUpdatePrices()
    {
        if (GridRef == null)
        {
            return;
        }

        var random = new Random();

        for (int i = (int)Math.Round(random.NextDouble() * 10); i < (CurrentTotal + 5); i += (int)Math.Round(random.NextDouble() * 10))
        {
            if (i < 25)
            {
                RandomizeObjectData(CurrentData.ElementAt(i));
            }
        }

        GridRef.Rebind();
    }

    private void RandomizeObjectData(FinancialData dataItem)
    {
        (double price, double changePercent) = GenerateNewPrice(dataItem.Price);
        dataItem.Price = price;
        dataItem.Change = changePercent;
        dataItem.Timeline.RemoveAt(0);
        dataItem.Timeline.Add(price);
    }

    private (double price, double changePercent) GenerateNewPrice(double oldPrice)
    {
        var random = new Random();
        var randomNum = Math.Round(random.NextDouble() * 100) / 100;
        var volatility = 2;
        double newPrice = 0;
        var changePercent = 2 * volatility * randomNum;

        if (changePercent > volatility)
        {
            changePercent -= (2 * volatility);
        }

        var changeAmount = oldPrice * (changePercent / 100);
        newPrice = oldPrice + changeAmount;
        newPrice = Math.Round(newPrice * 100) / 100;

        changePercent = Math.Round(changePercent * 100) / 100;

        return (newPrice, changePercent);
    }

    private List<double> GetSparklineData(int count)
    {
        var random = new Random();
        List<double> shuffled = prices.OrderBy(_ => random.Next()).ToList();

        // Return the first x elements
        return shuffled.Take(count).ToList();
    }

    #endregion Data Randomization Methods

