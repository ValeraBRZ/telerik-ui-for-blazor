    private RenderFragment SparklineChart(List<double> data) =>
    @<text>
        <TelerikChart Width="100%" Height="21px" Transitions="false">
            <ChartChartArea Background="transparent" />
            <ChartTooltip Visible="true"></ChartTooltip>
            <ChartSeriesItems>
                <ChartSeries Type="ChartSeriesType.Column"
                             Data="@(data.Cast<object>())" />
                <ChartLegend Visible="false" />
                <ChartValueAxes>
                    <ChartValueAxis Visible="false">
                        <ChartValueAxisLabels Visible="false" />
