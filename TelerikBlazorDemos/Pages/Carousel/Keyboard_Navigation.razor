@page "/carousel/keyboard-navigation"

<TelerikCarousel Data="@CarouselData"
                 Width="512px" Height="384px">
    <Template>
        <img src="images/photos/@(context.ImageID).jpg" alt="Photograph" width="512" height="384" />
    </Template>
</TelerikCarousel>

<style>
    /* center the Carousel horizontally */
    /* k-scrollview is the default component class */
    .k-scrollview {
        margin: 0 auto;
    }
</style>

@code {
    public List<CarouselModel> CarouselData { get; set; }

    protected override Task OnInitializedAsync()
    {
        CarouselData = Enumerable.Range(1, 7).Select(x => new CarouselModel
        {
            ImageID = x
        }).ToList();

        return base.OnInitializedAsync();
    }

    public class CarouselModel
    {
        public int ImageID { get; set; }
    }
}
