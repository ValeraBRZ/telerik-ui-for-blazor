@page "/arcgauge/scale-options"

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Ticks">
        <ul style="columns: 2">
            <li>
                <label>
                    <TelerikCheckBox @bind-Value="@MajorTicksVisible"></TelerikCheckBox>
                    Show Major Ticks
                </label>
            </li>
            <li>
                <TelerikColorPalette @bind-Value="@TickColor"
                                     Colors="@Colors"
                                     Columns="4"></TelerikColorPalette>
            </li>
            <li>
                <label>
                    <TelerikCheckBox @bind-Value="@MinorTicksVisible"></TelerikCheckBox>
                    Show Minor Ticks
                </label>
            </li>
        </ul>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Labels">
        <ul>
            <li>
                <label>
                    <TelerikCheckBox @bind-Value="@LabelVisible"></TelerikCheckBox>
                    Show Labels
                </label>
            </li>
            <li>
                <TelerikColorPalette @bind-Value="@LabelColor"
                                     Colors="@Colors"
                                     Columns="4"></TelerikColorPalette>
            </li>
        </ul>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Start Angle">
        <TelerikNumericTextBox @bind-Value="@StartAngle"
                               Min="0"
                               Max="30"
                               Step="10"></TelerikNumericTextBox>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="End Angle">
        <TelerikNumericTextBox @bind-Value="@EndAngle"
                               Min="150"
                               Max="180"
                               Step="10"></TelerikNumericTextBox>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Reverse">
        <label>
            <TelerikCheckBox @bind-Value="@Reversed"></TelerikCheckBox>
            Reverse
        </label>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<div class="demo-section auto">
    <TelerikArcGauge>
        <ArcGaugeScales>
            <ArcGaugeScale Min="0" Max="50"
                           Reverse="@Reversed"
                           StartAngle="@StartAngle"
                           EndAngle="@EndAngle">
                <ArcGaugeScaleMajorTicks Visible="@MajorTicksVisible" Color="@TickColor"></ArcGaugeScaleMajorTicks>
                <ArcGaugeScaleMinorTicks Visible="@MinorTicksVisible" Color="@TickColor"></ArcGaugeScaleMinorTicks>
                <ArcGaugeScaleLabels Color="@LabelColor" Visible="@LabelVisible"></ArcGaugeScaleLabels>
            </ArcGaugeScale>
        </ArcGaugeScales>
        <ArcGaugePointers>
            <ArcGaugePointer Value="20">
            </ArcGaugePointer>
        </ArcGaugePointers>
    </TelerikArcGauge>
</div>
@code {
    public bool Reversed { get; set; }

    public double StartAngle { get; set; } = 0;
    public double EndAngle { get; set; } = 180;

    public bool MajorTicksVisible { get; set; }
    public bool MinorTicksVisible { get; set; }
    public string TickColor { get; set; }

    public int LineWidth { get; set; } = 1;
    public string LineColor { get; set; }

    public bool LabelVisible { get; set; }
    public string LabelColor { get; set; }

    public List<string> Colors { get; set; } = new List<string>()
    {
        "#FF6358",
        "#FFE162",
        "#4CD180",
        "#707070",
        "#017CFF",
        "#8888E5",
        "#FF8400",
        "#BABABA"
    };
}
