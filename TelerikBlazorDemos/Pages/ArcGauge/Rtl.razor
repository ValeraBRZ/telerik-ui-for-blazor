@page "/arcgauge/rtl"

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Change pointer value">
        <TelerikNumericTextBox @bind-Value="@Value"
                               Min="0"
                               Max="100"
                               Step="10"></TelerikNumericTextBox>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<div class="demo-section auto">
    <TelerikArcGauge>
        <ArcGaugeCenterLabel>
            <Template>
                @(context.Pointers[0].Value)%
            </Template>
        </ArcGaugeCenterLabel>
        <ArcGaugeScales>
            <ArcGaugeScale Min="0" Max="100">
            </ArcGaugeScale>
        </ArcGaugeScales>
        <ArcGaugePointers>
            <ArcGaugePointer Value="@Value">
            </ArcGaugePointer>
        </ArcGaugePointers>
    </TelerikArcGauge>
</div>

@code {
    public int Value { get; set; } = 20;
}
