@page "/chart/trendline-chart"

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Pick the Trendline's Type">
        <TelerikDropDownList Data="@TrendlineTypes"
                             @bind-Value="@SelectedTrendlineType">
            <DropDownListSettings>
                <DropDownListPopupSettings Height="auto" Width="auto"></DropDownListPopupSettings>
            </DropDownListSettings>
        </TelerikDropDownList>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<TelerikChart>
    <ChartPannable Enabled="true" Lock="@ChartAxisLock.Y" />
    <ChartZoomable Enabled="true" />
    <ChartLegend Visible="true" Position="@ChartLegendPosition.Bottom" />
    <ChartTooltip Visible="true" Shared="false" />
    <ChartSeriesItems>
        <ChartSeries Type="ChartSeriesType.ScatterLine"
                     Name="@SeriesName"
                     Data="@ChartData"
                     XField="@nameof(StockPriceTrend.NumericPeriod)"
                     YField="@nameof(StockPriceTrend.Price)">
        </ChartSeries>

        @foreach (var trend in TrendlinesData)
        {
            if (trend.Name.Contains(SelectedTrendlineType.Split(' ')[0], StringComparison.OrdinalIgnoreCase) ||
            trend.Name.Contains(SelectedTrendlineType.Split(' ')[3], StringComparison.OrdinalIgnoreCase))
            {
                <ChartSeries Type="@trend.Type"
                             Name="@trend.Name"
                             For="@trend.For"
                             Color="@trend.Color">
                    <ChartSeriesTrendline Period="4">
                        <ChartSeriesTrendlineForecast Before="0" After="3" />
                    </ChartSeriesTrendline>
                </ChartSeries>
            }
        }

    </ChartSeriesItems>

    <ChartYAxes>
        <ChartYAxis>
            <ChartYAxisTitle Text="Price" />
            <ChartYAxisLabels Format="C0" />
        </ChartYAxis>
    </ChartYAxes>

</TelerikChart>

@code {
    private List<StockPriceTrend> ChartData { get; set; }
    private const string SeriesName = "Stock Price Trend";

    private string SelectedTrendlineType { get; set; } = "Linear Trendline & Moving Average Trendline";

    private List<string> TrendlineTypes { get; set; } = new List<string>
