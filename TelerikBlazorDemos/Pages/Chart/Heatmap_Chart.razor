@page "/chart/heatmap-chart"

@using Telerik.Blazor
@using Telerik.Blazor.Components

<TelerikChart Width="100%" Height="400px">
    <ChartTitle Text="GitHub contributions for the last 12 weeks"></ChartTitle>

    <ChartLegend Position="@ChartLegendPosition.Bottom"></ChartLegend>

    <ChartSeriesItems>
        <ChartSeries Type="ChartSeriesType.Heatmap"
                     Name="Number of commits per day"
                     Data="@Data"
                     XField="@nameof(HeatmapData.Week)"
                     YField="@nameof(HeatmapData.Day)"
                     Field="@nameof(HeatmapData.Value)">
            <ChartSeriesTooltip Visible="true">
                <Template>
                    @{ var dataItem = context.DataItem as HeatmapData; }

                    <div>@($"{dataItem.Value} contributions on {dataItem.Day}, week {dataItem.Week}")</div>
                </Template>
            </ChartSeriesTooltip>

            <ChartSeriesMarkers Type="@ChartSeriesMarkersType.RoundedRect"
                                BorderRadius="5">
            </ChartSeriesMarkers>
        </ChartSeries>
    </ChartSeriesItems>

    <ChartXAxes>
        <ChartXAxis>
            <ChartXAxisLabels Template="Week #= value #"></ChartXAxisLabels>
        </ChartXAxis>
    </ChartXAxes>

    <ChartYAxes>
        <ChartYAxis Categories="@YAxisCategories"></ChartYAxis>
    </ChartYAxes>
</TelerikChart>

@code {
    public List<HeatmapData> Data { get; set; } = new List<HeatmapData>();
    public object[] YAxisCategories { get; set; } = new object[]
    {
        "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"
    };

