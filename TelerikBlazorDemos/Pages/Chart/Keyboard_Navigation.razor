@page "/chart/keyboard-navigation"

<div>
    <div class="kd-border kd-rounded">
        @if (CategoricalChartData?.ProductAggregation != null)
        {
            <TelerikChart Height="230px">
                <ChartTooltip Visible="true" Shared="true" />
                <ChartTitle Text="Sales and Revenue Total" />
                <ChartSubtitle Text="The sales and revenue total over a calendar year" />

                <ChartSeriesItems>
                    @foreach (var product in CategoricalChartData.ProductAggregation)
                    {
                        <ChartSeries Type="ChartSeriesType.Column"
                                     Name="@product.ProductName"
                                     Data="@product.ProductRevenueAndSales"
                                     Field="@nameof(ProductRevenueAndSalesModel.SalesCount)"
                                     CategoryField="@nameof(ProductRevenueAndSalesModel.Category)">
                                <ChartSeriesLabels Visible="false"
                                                   AriaTemplate="chartSeriesAriaTemplate">
                                </ChartSeriesLabels>
                        </ChartSeries>
                    }

                    <ChartSeries Type="ChartSeriesType.Line"
                                 Name="Total Revenue"
                                 Data="@CategoricalChartData.TotalAggregation"
                                 Field="@nameof(ProductRevenueAndSalesModel.Revenue)"
                                 Axis="RevenueAxis">
                    </ChartSeries>
                </ChartSeriesItems>

                <ChartValueAxes>
                    <ChartValueAxis>
                        <ChartValueAxisTitle Text="Sold items (thousands)" />
                        <ChartValueAxisMajorGridLines Visible="false" />
                    </ChartValueAxis>
                    <ChartValueAxis Name="RevenueAxis">
                        <ChartValueAxisTitle Text="Revenue" />
                        <ChartValueAxisLabels Format="{0:C}M" />
                        <ChartValueAxisMajorGridLines Visible="false" />
                    </ChartValueAxis>
                </ChartValueAxes>

                <ChartCategoryAxes>
                    <ChartCategoryAxis AxisCrossingValue="@(new object[] { 20, 0 })" />
                </ChartCategoryAxes>
            </TelerikChart>
        }
    </div>

    <div class="kd-border kd-rounded">
        @if (DonutChartData != null)
        {
            <TelerikChart Height="290px">
                <ChartTitle Text="Sales Distribution" />
                <ChartSubtitle Text="Per product for the last year" />

                <ChartSeriesItems>
                    <ChartSeries Type="ChartSeriesType.Donut"
                                 Data="@DonutChartData"
                                 Field="SalesCount"
                                 CategoryField="ProductName">
                        <ChartSeriesLabels Visible="true"
                                           Template="#=category#"
                                           Background="transparent"
                                           Position="ChartSeriesLabelsPosition.OutsideEnd" />
                        <ChartSeriesTooltip Visible="true" />
                    </ChartSeries>
                </ChartSeriesItems>

                <ChartLegend Visible="true" />
            </TelerikChart>
        }
    </div>

    <div class="mt-md k-d-flex k-flex-wrap">
        <div class="k-flex-grow mb-md kd-border kd-rounded chart-item">
            @if (PieChartData != null)
            {
                <TelerikChart Height="230px">
                    <ChartSeriesItems>
                        <ChartSeries Type="ChartSeriesType.Pie" 
                                     Data="@PieChartData"
                                     Field="@nameof(PieChartModel.PieSegmentValue)" 
                                     CategoryField="@nameof(PieChartModel.PieSegmentName)">
                                     <ChartSeriesLabels Visible="true"
                                                        Background="transparent"
                                                        Position="ChartSeriesLabelsPosition.InsideEnd" />
                        </ChartSeries>
                    </ChartSeriesItems>

                    <ChartTitle Text="Revenue per product" />

                    <ChartLegend Visible="true" />
                </TelerikChart>
            }
        </div>

        <div class="k-flex-grow mb-md kd-border kd-rounded chart-item">
            @if (ScatterChartData != null)
            {
                <TelerikChart Height="250px">
                    <ChartTitle Text="Unrecoverable Errors Per Minute" />

                    <ChartSeriesItems>
                        <ChartSeries Type="ChartSeriesType.Scatter"
                                     Data="@ScatterChartData"
                                     Name="APSK modulation"
                                     XField="@nameof(ScatterChartModel.Strength)"
                                     YField="@nameof(ScatterChartModel.Errors)">
                        </ChartSeries>
                    </ChartSeriesItems>

                    <ChartXAxes>
                        <ChartXAxis Max="-30" AxisCrossingValue="@(new object[] { -100 })">
                            <ChartXAxisTitle Text="Signal Strength, dBm" />
                        </ChartXAxis>
                    </ChartXAxes>

                    <ChartYAxes>
                        <ChartYAxis>
                            <ChartYAxisTitle Text="Error count" />
                        </ChartYAxis>
                    </ChartYAxes>
                </TelerikChart>
            }
        </div>

        <div class="k-flex-grow mb-md kd-border kd-rounded chart-item">
            @if (RadarChartHighData != null && RadarChartLowData != null)
            {
                <TelerikChart Height="250px">
                    <ChartSeriesItems>
                        <ChartSeries Type="@ChartSeriesType.RadarLine" 
                                     Name="Avg. High" 
                                     Data="@RadarChartHighData" 
                                     Color="red">
                        </ChartSeries>
                        <ChartSeries Type="@ChartSeriesType.RadarLine" 
                                     Name="Avg. Low" 
                                     Data="@RadarChartLowData" 
                                     Color="blue">
                        </ChartSeries>
                    </ChartSeriesItems>

                    <ChartCategoryAxes>
                        <ChartCategoryAxis Categories="@RadarChartXaxisItems" />
                    </ChartCategoryAxes>

                    <ChartValueAxes>
                        <ChartValueAxis>
                            <ChartValueAxisLabels Visible="false" />
                        </ChartValueAxis>
                    </ChartValueAxes>

                    <ChartTitle Text="Monthly temperatures in Rovaniemi (the Santa Claus village)" />

                    <ChartLegend Visible="true" />
                </TelerikChart>
            }
        </div>

        <div class="k-flex-grow mb-md kd-border kd-rounded chart-item">
            @if (HeatmapChartData != null)
            {
                <TelerikChart Height="250px">
                    <ChartSeriesItems>
                        <ChartSeries Type="@ChartSeriesType.Heatmap"
                                     Name="Commits Made per developer"
                                     Data="@HeatmapChartData"
                                     XField="@(nameof(HeatmapChartModel.Week))"
                                     YField="@(nameof(HeatmapChartModel.Day))"
                                     Field="@(nameof(HeatmapChartModel.CommitsNumber))">
                        </ChartSeries>
                    </ChartSeriesItems>

                    <ChartTitle Text="Developers Commits Number" />

                    <ChartLegend Visible="true" />
                </TelerikChart>
            }
        </div>
    </div>
</div>

<!-- Move JavaScript code to a separate JS file in production -->
