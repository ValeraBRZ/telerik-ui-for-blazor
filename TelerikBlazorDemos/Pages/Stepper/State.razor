@page "/stepper/state"

<TelerikStepper>
    <StepperSteps>
        <StepperStep Optional="true" Text="1" Label="Optional Step"></StepperStep>
        <StepperStep Text="2" Label="Normal Step"></StepperStep>
        <StepperStep Text="3" Label="Disabled Step" Disabled="true"></StepperStep>
        <StepperStep Text="4" Optional="true" Disabled="true" Label="Optional Disabled"></StepperStep>
        <StepperStep Text="5" Label="Normal Step"></StepperStep>
    </StepperSteps>
</TelerikStepper>
