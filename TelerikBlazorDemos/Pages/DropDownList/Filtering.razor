@page "/dropdownlist/filtering"

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Enable filtering for the ComboBox">
        <TelerikCheckBox @bind-Value="@Filterable" Id="filterableCheckBox"></TelerikCheckBox>
        <label class="k-checkbox-label" for="filterableCheckBox">Enable Filtering</label>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Select the filter operator">
        <TelerikDropDownList @bind-Value="@filterOperator"
                             Data="@filterOperators"
                             Enabled="@Filterable"
                             Width="100%">
            <DropDownListSettings>
                <DropDownListPopupSettings Height="auto"></DropDownListPopupSettings>
            </DropDownListSettings>
        </TelerikDropDownList>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Filter Debounce Delay" >
        <TelerikNumericTextBox @bind-Value="@FilterDebounceDelay" Min="0" Max="1000"/>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Filter Placeholder">
        <TelerikTextBox @bind-Value="@FilterPlaceholder"/>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<div class="k-form k-form-md demo-section">
    <div class="k-form-field">
        <label for="country" class="k-label k-form-label">Select a country:</label>
        <div class="k-form-field-wrap">
            <TelerikDropDownList @bind-Value="@SelectedValue"
                                 Id="country"
                                 Data="@Countries"
                                 TItem="string"
                                 TValue="string"
                                 Filterable="@Filterable"
                                 FilterOperator="@filterOperator"
                                 FilterDebounceDelay="@FilterDebounceDelay"
                                 FilterPlaceholder="@FilterPlaceholder">
                <NoDataTemplate>
                    <div>
                        <TelerikSvgIcon Icon="@SvgIcon.InfoCircle" Size="@ThemeConstants.SvgIcon.Size.Large" />
                        <br />
                        <br />
                        No items to display...
                    </div>
                </NoDataTemplate>
            </TelerikDropDownList>
        </div>
    </div>
</div>

@code {
    private int FilterDebounceDelay { get; set; } = 200;

    private bool Filterable { get; set; } = true;

    private StringFilterOperator filterOperator { get; set; } = StringFilterOperator.Contains;

    private string FilterPlaceholder { get; set; } = "Search a country...";

    private List<StringFilterOperator> filterOperators { get; set; } = new List<StringFilterOperator>()
    {
        StringFilterOperator.Contains,
        StringFilterOperator.DoesNotContain,
        StringFilterOperator.EndsWith,
        StringFilterOperator.IsContainedIn,
        StringFilterOperator.StartsWith
    };

    private List<string> Countries = new List<string>()
        {
        "Albania",
