@page "/dropdownlist/overview"
@page "/dropdownlist/index"

@inject DestinationService DestinationService

<OrderFoodTemplate>
    <TelerikDropDownList Data="@DestinationsData"
                         @bind-Value="@SelectedDestinationId"
                         TextField="@nameof(DestinationDto.Title)"
                         ValueField="@nameof(DestinationDto.Id)"
                         DefaultText="Select a city..."
                         Width="100%">
    </TelerikDropDownList>
</OrderFoodTemplate>

@code {
    public int SelectedDestinationId { get; set; }
    public IEnumerable<DestinationDto> DestinationsData { get; set; }

    protected override void OnInitialized()
    {
        LoadData();
    }

    // sample Read operation
    private void LoadData()
    {
        DestinationsData = DestinationService.GetDestinations();
    }
}
