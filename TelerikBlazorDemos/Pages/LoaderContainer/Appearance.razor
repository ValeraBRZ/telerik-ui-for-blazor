@page "/loadercontainer/appearance"

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Size">
        <TelerikDropDownList Data="@Sizes"
                             TextField="Key"
                             ValueField="Value"
                             @bind-Value="@SelectedLoaderSize"
                             Width="120px">
            <DropDownListSettings>
                <DropDownListPopupSettings Height="auto"></DropDownListPopupSettings>
            </DropDownListSettings>
        </TelerikDropDownList>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Overlay">
        <TelerikDropDownList Data="@OverlayThemeColors"
                             @bind-Value="@OverlayThemeColor"
                             Width="120px">
            <DropDownListSettings>
                <DropDownListPopupSettings Height="auto"></DropDownListPopupSettings>
            </DropDownListSettings>
        </TelerikDropDownList>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Position">
        <TelerikDropDownList Data="@LoaderPositions"
                             TItem="@LoaderPosition"
                             TValue="LoaderPosition"
                             @bind-Value="@SelectedLoaderPosition"
                             Width="120px">
            <DropDownListSettings>
                <DropDownListPopupSettings Height="auto"></DropDownListPopupSettings>
            </DropDownListSettings>
        </TelerikDropDownList>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Theme Color">
        <TelerikDropDownList Data="@ThemeColors"
                             @bind-Value="@ThemeColor"
                             Width="120px">
            <DropDownListSettings>
                <DropDownListPopupSettings Height="auto"></DropDownListPopupSettings>
            </DropDownListSettings>
        </TelerikDropDownList>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Loader type">
        <TelerikDropDownList Data="@Types"
                             @bind-Value="@SelectedLoaderType"
                             Width="170px">
            <DropDownListSettings>
                <DropDownListPopupSettings Height="auto"></DropDownListPopupSettings>
            </DropDownListSettings>
        </TelerikDropDownList>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Text">
        <TelerikTextBox @bind-Value="@LoaderContainerText"
                        Width="170px">
        </TelerikTextBox>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<div class="demo-container">
    <TelerikLoaderContainer Size="@SelectedLoaderSize"
                            ThemeColor="@ThemeColor"
                            OverlayThemeColor="@OverlayThemeColor"
                            LoaderPosition="@SelectedLoaderPosition"
                            Text="@LoaderContainerText"
                            LoaderType="@SelectedLoaderType"
                            ></TelerikLoaderContainer>
</div>

@code {
    string SelectedLoaderSize { get; set; } = ThemeConstants.Loader.Size.Medium;
    string ThemeColor { get; set; } = "primary";
    string OverlayThemeColor { get; set; } = "dark";
    string LoaderContainerText { get; set; } = "Your page is loading";
    LoaderPosition SelectedLoaderPosition { get; set; }
    LoaderType SelectedLoaderType { get; set; }

    List<string> ThemeColors = new List<string>
    {
        "primary",
        "secondary",
        "tertiary",
        "info",
        "success",
        "warning",
        "error",
        "dark",
        "light",
        "inverse"
    };

    List<LoaderType> Types { get; set; } = new List<LoaderType>
    {
        LoaderType.Pulsing,
        LoaderType.InfiniteSpinner,
        LoaderType.ConvergingSpinner
    };

    List<DropDownListItem> OverlayThemeColors = new List<DropDownListItem>
    {
        new DropDownListItem{Text = "dark", Value = "dark" },
        new DropDownListItem{Text = "light", Value = "light" },
        new DropDownListItem{Text = "null", Value = null }
    };

    public Dictionary<string, string> Sizes { get; set; } = new Dictionary<string, string>
    {
        { "Small", ThemeConstants.Loader.Size.Small },
        { "Medium", ThemeConstants.Loader.Size.Medium },
        { "Large", ThemeConstants.Loader.Size.Large }
    };

    List<LoaderPosition> LoaderPositions { get; set; } = new List<LoaderPosition>
    {
       LoaderPosition.Top,
       LoaderPosition.Start,
       LoaderPosition.End
    };

    class DropDownListItem
    {
        public string Text { get; set; }

        public string Value { get; set; }
    }
}

<style>
    .demo-container {
        position: relative;
        height: 300px;
        width: 75%;
        margin: 0 auto;
    }

    .loader-container-heading {
        padding-top:25px;
    }

    .k-loader-container {
        z-index: 0;
        word-break: break-all;
    }
</style>
