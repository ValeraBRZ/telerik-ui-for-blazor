@page "/filemanager/events"

@inject NavigationManager NavigationManager
@inject HierarchicalFileService FileService

<TelerikFileManager Height="400px"
                    Data="@Data"
                    Path="@DirectoryPath"
                    PathChanged="@DirectoryPathChanged"
                    View="@FileManagerView"
                    ViewChanged="@FileManagerViewChanged"
                    NameField="@(nameof(HierarchicalFileEntry.Name))"
                    SizeField="@(nameof(HierarchicalFileEntry.Size))"
                    PathField="@(nameof(HierarchicalFileEntry.Path))"
                    ExtensionField="@(nameof(HierarchicalFileEntry.Extension))"
                    IsDirectoryField="@(nameof(HierarchicalFileEntry.IsDirectory))"
                    HasDirectoriesField="@(nameof(HierarchicalFileEntry.HasDirectories))"
                    ItemsField="@(nameof(HierarchicalFileEntry.Items))"
                    DirectoriesField="@(nameof(HierarchicalFileEntry.Directories))"
                    DateCreatedField="@(nameof(HierarchicalFileEntry.DateCreated))"
                    DateCreatedUtcField="@(nameof(HierarchicalFileEntry.DateCreatedUtc))"
                    DateModifiedField="@(nameof(HierarchicalFileEntry.DateModified))"
                    DateModifiedUtcField="@(nameof(HierarchicalFileEntry.DateModifiedUtc))"
                    OnCreate="@OnCreate"
                    OnModelInit="@OnModelInit"
                    OnEdit="@OnEdit"
                    OnUpdate="@OnUpdate"
                    OnDelete="@OnDelete"
                    OnDownload="@OnDownload"
                    SelectedItemsChanged="@((IEnumerable<HierarchicalFileEntry> selectedFiles) => OnSelect(selectedFiles))">
    <FileManagerSettings>
        <FileManagerUploadSettings SaveUrl="@UploadUrl"
                                   Multiple="true"
                                   OnSuccess="@OnUploadSuccess">
        </FileManagerUploadSettings>
    </FileManagerSettings>
</TelerikFileManager>

<DemoConsole EventLog="@EventLog" OnClearLogClick="@OnClearLogClick" />

@code {
    public string EventLog { get; set; } = string.Empty;

    [CascadingParameter]
    public DialogFactory Dialogs { get; set; }

    public string DirectoryPath { get; set; }

    public FileManagerViewType FileManagerView { get; set; }

    public List<HierarchicalFileEntry> Data { get; set; } = new List<HierarchicalFileEntry>();

    public string UploadUrl =>
        NavigationManager
            .ToAbsoluteUrl($"api/filemanager/{nameof(FileManagerController.UploadHierarchicalFiles).ToLower()}");

    protected override async Task OnInitializedAsync()
    {
        DirectoryPath = FileManagerConstants.FilesPath;

        await LoadDataAsync();

        await base.OnInitializedAsync();
    }

    public async Task LoadDataAsync()
    {
        Data = await FileService.ReadHierarchicalDataAsync();
    }

    public void DirectoryPathChanged(string newPath)
    {
        DirectoryPath = newPath;

        var log = string.Empty;
        log += "<div>";
        log += $"<div><strong>PathChanged event</strong> triggered. The new path is <strong>{newPath}</strong>";
        log += "</div>";

        LogToConsole(log);
    }

    public void FileManagerViewChanged(FileManagerViewType newView)
    {
        FileManagerView = newView;

        var log = string.Empty;
        log += "<div>";
        log += $"<div><strong>ViewChanged event</strong> triggered. The new view is <strong>{newView}</strong>.";
        log += "</div>";

        LogToConsole(log);
    }

    public async Task OnCreate(FileManagerCreateEventArgs args)
    {
        var item = (HierarchicalFileEntry)args.Item;

        await FileService.CreateAsync(item, DirectoryPath);

        await LoadDataAsync();

        var log = string.Empty;
        log += "<div>";
        log += $"<div><strong>Create event</strong> triggered for <strong>{item.Name}{item.Extension}</strong>.";
        log += "</div>";

        LogToConsole(log);
    }

    public HierarchicalFileEntry OnModelInit()
    {
        var item = FileService.ModelInit(DirectoryPath);

        var log = string.Empty;
        log += "<div>";
        log += $"<div><strong>ModelInit event</strong> triggered for <strong>{item.Name}{item.Extension}</strong>.";
        log += "</div>";

        LogToConsole(log);

        return item;
    }

    public async Task OnUpdate(FileManagerUpdateEventArgs args)
    {
        var item = (HierarchicalFileEntry)args.Item;

        var log = string.Empty;
        log += "<div>";
        log += $"<div><strong>Update event</strong> triggered for <strong>{item.Name}{item.Extension}</strong>.";
        log += "</div>";

        LogToConsole(log);

        if (item.IsDirectory)
        {
            // avoid changes to folders intentionally
            // simulate access rights violation, name clash, etc.
            args.IsCancelled = true;

            await Dialogs.AlertAsync(
                title: "Information",
                text: "The specified folder name is not accepted.");
        }
        else
        {
            await FileService.UpdateAsync(args.Item as HierarchicalFileEntry, DirectoryPath);

            await LoadDataAsync();
        }
    }

    public async Task OnEdit(FileManagerEditEventArgs args)
    {
        var item = (HierarchicalFileEntry)args.Item;

        var log = string.Empty;
        log += "<div>";
        log += $"<div><strong>Edit event</strong> triggered for <strong>{item.Name}{item.Extension}</strong>.";
        log += "</div>";

        LogToConsole(log);

        await Task.Yield();
    }

    public async Task OnDelete(FileManagerDeleteEventArgs args)
    {
        var item = (HierarchicalFileEntry)args.Item;

        var log = string.Empty;
        log += "<div>";
        log += $"<div><strong>Delete event</strong> triggered for <strong>{item.Name}{item.Extension}</strong>.";
        log += "</div>";

        LogToConsole(log);

        await FileService.DeleteAsync(args.Item as HierarchicalFileEntry);

        await LoadDataAsync();
    }

    public async Task OnDownload(FileManagerDownloadEventArgs args)
    {
        var item = (HierarchicalFileEntry)args.Item;

        var log = string.Empty;
        log += "<div>";
        log += $"<div><strong>Download event</strong> triggered for <strong>{item.Name}{item.Extension}</strong>.";
        log += "</div>";

        LogToConsole(log);

        await FileService.DownloadAsync(args);

        await LoadDataAsync();
    }

    public async Task OnUploadSuccess(UploadSuccessEventArgs args)
    {
        await FileService.UploadAsync(args, DirectoryPath);

        await LoadDataAsync();
    }

    protected void OnSelect(IEnumerable<HierarchicalFileEntry> selectedFiles)
    {
        var selectedFilesMessage = selectedFiles.Any()
            ? $"Last selected file: <strong>{selectedFiles.LastOrDefault()?.Name}{selectedFiles.LastOrDefault()?.Extension}</strong>"
            : "No files selected.";

        var log = string.Empty;
        log += "<div>";
        log += $"<div><strong>SelectedItemsChanged event</strong> triggered. {selectedFilesMessage}";
        log += "</div>";

        LogToConsole(log);
    }

    public void LogToConsole(string text)
    {
        EventLog = EventLog.Insert(0, text);
    }

    public void OnClearLogClick()
    {
        EventLog = string.Empty;
    }

}
