@page "/filemanager/localization"

@inject NavigationManager NavigationManager
@inject HierarchicalFileService FileService

<DemoConfigurator>
    <DemoConfiguratorColumn>
        <CultureChooser></CultureChooser>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<TelerikFileManager Height="400px"
                    Data="@Data"
                    @bind-Path="@DirectoryPath"
                    NameField="@(nameof(HierarchicalFileEntry.Name))"
                    SizeField="@(nameof(HierarchicalFileEntry.Size))"
                    PathField="@(nameof(HierarchicalFileEntry.Path))"
                    ExtensionField="@(nameof(HierarchicalFileEntry.Extension))"
                    IsDirectoryField="@(nameof(HierarchicalFileEntry.IsDirectory))"
                    HasDirectoriesField="@(nameof(HierarchicalFileEntry.HasDirectories))"
                    ItemsField="@(nameof(HierarchicalFileEntry.Items))"
                    DirectoriesField="@(nameof(HierarchicalFileEntry.Directories))"
                    DateCreatedField="@(nameof(HierarchicalFileEntry.DateCreated))"
                    DateCreatedUtcField="@(nameof(HierarchicalFileEntry.DateCreatedUtc))"
                    DateModifiedField="@(nameof(HierarchicalFileEntry.DateModified))"
                    DateModifiedUtcField="@(nameof(HierarchicalFileEntry.DateModifiedUtc))"
                    OnCreate="@OnCreate"
                    OnModelInit="@OnModelInit"
                    OnUpdate="@OnUpdate"
                    OnDelete="@OnDelete"
                    OnDownload="@OnDownload">
    <FileManagerSettings>
        <FileManagerUploadSettings SaveUrl="@UploadUrl"
                                   Multiple="true"
                                   OnSuccess="@OnUploadSuccess">
        </FileManagerUploadSettings>
    </FileManagerSettings>
</TelerikFileManager>

@code {
    [CascadingParameter]
    public DialogFactory Dialogs { get; set; }

    public string DirectoryPath { get; set; }
    public List<HierarchicalFileEntry> Data { get; set; } = new List<HierarchicalFileEntry>();

    public string UploadUrl =>
        NavigationManager
            .ToAbsoluteUrl($"api/filemanager/{nameof(FileManagerController.UploadHierarchicalFiles).ToLower()}");

    protected override async Task OnInitializedAsync()
    {
        DirectoryPath = FileManagerConstants.FilesPath;

        await LoadDataAsync();

        await base.OnInitializedAsync();
    }

    public async Task LoadDataAsync()
    {
        Data = await FileService.ReadHierarchicalDataAsync();
    }

    public async Task OnCreate(FileManagerCreateEventArgs args)
    {
        await FileService.CreateAsync(args.Item as HierarchicalFileEntry, DirectoryPath);

        await LoadDataAsync();
    }

    public HierarchicalFileEntry OnModelInit()
    {
        var item = FileService.ModelInit(DirectoryPath);
        return item;
    }

    public async Task OnUpdate(FileManagerUpdateEventArgs args)
    {
        var item = (HierarchicalFileEntry)args.Item;

        if (item.IsDirectory)
        {
            // avoid changes to folders intentionally
            // simulate access rights violation, name clash, etc.
            args.IsCancelled = true;

            await Dialogs.AlertAsync(
                title: "Information",
                text: "The specified folder name is not accepted.");
        }
        else
        {
            await FileService.UpdateAsync(args.Item as HierarchicalFileEntry, DirectoryPath);

            await LoadDataAsync();
        }
    }

    public async Task OnDelete(FileManagerDeleteEventArgs args)
    {
        await FileService.DeleteAsync(args.Item as HierarchicalFileEntry);

        await LoadDataAsync();
    }

    public async Task OnDownload(FileManagerDownloadEventArgs args)
    {
        await FileService.DownloadAsync(args);

        await LoadDataAsync();
    }

    public async Task OnUploadSuccess(UploadSuccessEventArgs args)
    {
        await FileService.UploadAsync(args, DirectoryPath);

        await LoadDataAsync();
    }
}
