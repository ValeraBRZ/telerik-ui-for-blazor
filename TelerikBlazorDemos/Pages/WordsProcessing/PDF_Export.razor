@page "/wordsprocessing/pdf-export"

@using System.IO;
@using Telerik.Windows.Documents.Flow.FormatProviders.Docx;
@using Telerik.Windows.Documents.Flow.Model;
@using TelerikBlazorDemos.DocumentProcessing;
@using System;
@using System.Text.RegularExpressions;
@using Telerik.Windows.Documents.Common.FormatProviders;
@using Telerik.Windows.Documents.Flow.FormatProviders.Html;
@using Telerik.Windows.Documents.Flow.FormatProviders.Rtf;
@using Telerik.Windows.Documents.Flow.FormatProviders.Txt;
@using Telerik.Windows.Documents.Flow.FormatProviders.Pdf;
@using Telerik.Documents.ImageUtils;
@using Telerik.Windows.Documents.Extensibility;
@using Microsoft.AspNetCore.Hosting;
@inject IWebHostEnvironment Environment
@inject IJSRuntime JsRuntime

<div class="demo-section">
    <input id="rb1" class="k-radio k-radio-md" name="loadDocument" type="radio" value="1"
           checked="@(rb == "1")" @onchange="@(() => { rb = "1"; })">
    <label for="rb1">Load Template Document</label>

    <div class="custom-radio-wrapper">
        <input id="rb2" class="k-radio k-radio-md" name="loadDocument" type="radio" value="2"
               checked="@(rb == "2")" @onchange="@(() => { rb = "2"; })">
        <label for="rb2">Load Custom Document</label>
    </div>

    <hr class="clear" />

    <div class='@(rb=="1" ? "visible-wrapper" : "hidden-wrapper")'>
        <span>Preview:</span>
        <div class="image-wrapper">
            <img class="template-image" src="shared/web/wordsprocessing/SampleDocumentImagePDF.png" alt="sample PDF document" />
        </div>
    </div>

    <div class='@(rb=="1" ? "hidden-wrapper":"visible-wrapper" )'>
        <DemoFileSelector ID="uploadInput" Accept=".docx, .rtf, .html, .txt" @bind-FileDetails="fileDetails" />
    </div>
    <br />

    <label>File Name: @(rb == "1" ? fileName : customFileName)</label>
    <hr class="clear" />

    <TelerikButton OnClick="@DownloadHandler"
                   Icon="@SvgIcon.Save"
                   ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)"
                   Enabled='@isButtonEnabled'
                   Class="demo-button">Convert and Download</TelerikButton>
</div>

@code {
    UploadedFileDetails fileDetails = new UploadedFileDetails();
    string rb = "1";
    string fileName = "TelerikWordsProcessing-SampleDocumentPDF.docx";
    string customFileName => fileDetails.Name;
    bool isButtonEnabled => rb == "1" || !string.IsNullOrEmpty(customFileName);

    void DownloadHandler()
    {
        byte[] newFileData = GenerateFile();
        DemoFileExporter.Save(JsRuntime, newFileData, "application/pdf",
            String.Format("{0}.pdf",
            Path.GetFileNameWithoutExtension(rb == "1" ? fileName : customFileName)));
    }

    byte[] GenerateFile()
    {
        IFormatProvider<RadFlowDocument> fileFormatProvider = null;
        RadFlowDocument document = null;

        if (rb == "2" && Regex.IsMatch(Path.GetExtension(customFileName), ".docx|.rtf|.html|.txt"))
        {
            switch (Path.GetExtension(customFileName))
            {
                case ".docx":
                    fileFormatProvider = new DocxFormatProvider();
                    break;
                case ".rtf":
                    fileFormatProvider = new RtfFormatProvider();
                    break;
                case ".html":
                    fileFormatProvider = new HtmlFormatProvider();
                    break;
                case ".txt":
                    fileFormatProvider = new TxtFormatProvider();
                    break;
                default:
                    fileFormatProvider = null;
                    break;
            }

            using (MemoryStream stream = new MemoryStream(fileDetails.Data))
            {
                document = fileFormatProvider.Import(stream, null);
            }
        }
        else
        {
            fileFormatProvider = new DocxFormatProvider();

            string filePath = Path.Combine(Environment.WebRootPath, @"shared/web/wordsprocessing/SampleDocumentPDF.docx");

            using (FileStream input = new FileStream(filePath, FileMode.Open, FileAccess.Read))
            {
                document = fileFormatProvider.Import(input, null);
            }
        }

        // registering the image converter explicitly is a requirement by Telerik.Documents.ImageUtils
        var jpegImageConverter = new JpegImageConverter();
        FixedExtensibilityManager.JpegImageConverter = jpegImageConverter;

        PdfFormatProvider convertFormatProvider = new PdfFormatProvider();

        byte[] renderedBytes = null;
        using (MemoryStream ms = new MemoryStream())
        {
            convertFormatProvider.Export(document, ms, null);
            renderedBytes = ms.ToArray();
        }

        return renderedBytes;
    }
}

<style>
    .demo-button {
        width: 240px;
        float: right;
    }

    .demo-section {
        max-width: 500px;
        padding-bottom: 80px;
    }

        .demo-section label {
            margin-left: 5px;
        }

    .image-wrapper {
        text-align: center;
        min-height: 300px;
        position: relative;
    }

        .image-wrapper img {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            margin: auto;
            bottom: 0;
        }

    .template-image {
        height: 300px;
        border: 1px solid #c9c9c9;
    }

    .custom-image {
        height: 180px;
    }

    .custom-radio-wrapper {
        float: right;
    }

    .visible-wrapper {
        display: block;
    }

    .hidden-wrapper {
        display: none;
    }
</style>
