@page "/pager/localization"

@inject MovieService MovieService

<DemoConfigurator>
    <DemoConfiguratorColumn>
        <CultureChooser></CultureChooser>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<div class="demo-alert demo-alert-info">Hover on the pager buttons to see the localized text</div>

@{
    var pageData = Data.Skip((Page - 1) * PageSize).Take(PageSize).ToList();
    foreach (var movie in pageData)
    {
        <div class="movie-box">
            <p>#@movie.Position</p>
            <h4>@movie.Title</h4>
            <p><TelerikSvgIcon Icon="@SvgIcon.Star" />@(movie.Rating)/10</p>
        </div>
    }
}

<TelerikPager PageSize="@PageSize" Total="Data.Count" ButtonCount="3" @bind-Page="@Page"></TelerikPager>

@code {
    public List<MovieDto> Data { get; set; }
    public int Page { get; set; } = 1;
    public int PageSize { get; set; } = 3;

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        Data = MovieService.GetMovies().ToList();
    }
}

<style>
    .movie-box {
        height: 80px;
        align-content: space-between;
        flex-wrap: wrap;
        display: flex;
        flex-direction: column;
        margin-bottom: 3px;
        border-bottom: 1px solid #DDD;
    }

        .movie-box p, .movie-box h4 {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            margin: 0;
            padding: 0;
        }

        .movie-box p {
            margin: 0 5px;
        }
</style>
