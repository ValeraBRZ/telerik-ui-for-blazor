@page "/multicolumncombobox/localization"

<DemoConfigurator>
    <DemoConfiguratorColumn>
        <CultureChooser></CultureChooser>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<div class="demo-section k-form k-form-md k-form-vertical">
    <div class="k-form-field">
        <label for="size" class="k-label k-form-label">Select a size:</label>
        <div class="k-form-field-wrap">
            <TelerikMultiColumnComboBox Data="@Data"
                                        @bind-Value="@Value"
                                        ValueField="Metric"
                                        TextField="Text"
                                        Placeholder="filter so there are no results, hover the [x] button"
                                        Id="size"
                                        Width="100%"
                                        Filterable="true">
                <MultiColumnComboBoxColumns>
                    <MultiColumnComboBoxColumn Field="@nameof(Size.Metric)" />
                    <MultiColumnComboBoxColumn Field="@nameof(Size.Text)" />
                </MultiColumnComboBoxColumns>
            </TelerikMultiColumnComboBox>
        </div>
    </div>
</div>

@code  {
    private List<Size> Data { get; set; }
    private int? Value { get; set; }

    void LoadData() => Data = new List<Size>
    {
        new Size { Text = "XX-Small", Metric = 3 },
        new Size { Text = "X-Small", Metric = 6 },
        new Size { Text = "Small", Metric = 9 },
        new Size { Text = "Medium", Metric = 12 },
        new Size { Text = "Large", Metric = 15 },
        new Size { Text = "X-Large", Metric = 18 },
        new Size { Text = "XX-Large", Metric = 21 },
    };

    protected override void OnInitialized()
    {
        LoadData();
        base.OnInitialized();
    }

    private class Size
    {
        public string Text { get; set; }
        public int? Metric { get; set; }
    }
}
