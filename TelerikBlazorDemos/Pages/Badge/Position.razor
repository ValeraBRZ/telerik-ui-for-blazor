@page "/badge/position"

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Position">
        <TelerikDropDownList Data="@BadgePositionSettings"
                             @bind-Value="@BadgePositionSetting">
            <DropDownListSettings><DropDownListPopupSettings Height="auto"></DropDownListPopupSettings></DropDownListSettings>
        </TelerikDropDownList>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Horizontal Alignment">
        <TelerikDropDownList Data="@BadgeHorizontalAlignSettings"
                             @bind-Value="@BadgeHorizontalAlignSetting"
                             Enabled="@(BadgePositionSetting != BadgePosition.Inline)">
            <DropDownListSettings><DropDownListPopupSettings Height="auto"></DropDownListPopupSettings></DropDownListSettings>
        </TelerikDropDownList>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Vertical Alignment">
        <TelerikDropDownList Data="@BadgeVerticalAlignSettings"
                             @bind-Value="@BadgeVerticalAlignSetting"
                             Enabled="@(BadgePositionSetting != BadgePosition.Inline)">
            <DropDownListSettings><DropDownListPopupSettings Height="auto"></DropDownListPopupSettings></DropDownListSettings>
        </TelerikDropDownList>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<div class="demo-section auto">
    <TelerikButton Icon="@SvgIcon.User">
        <span style="padding: @(BadgePositionSetting == BadgePosition.Inside ? "10px": "0")">
            <TelerikBadge Position="@BadgePositionSetting"
                          HorizontalAlign="@BadgeHorizontalAlignSetting"
                          VerticalAlign="@BadgeVerticalAlignSetting">
                10
            </TelerikBadge>
        </span>
    </TelerikButton>
</div>

@code {
    private BadgePosition BadgePositionSetting { get; set; } = BadgePosition.Edge;
    private List<BadgePosition> BadgePositionSettings { get; set; } = new List<BadgePosition>()
    {
        BadgePosition.Edge,
        BadgePosition.Inline,
        BadgePosition.Inside,
        BadgePosition.Outside
    };

    private BadgeHorizontalAlign BadgeHorizontalAlignSetting { get; set; } = BadgeHorizontalAlign.End;
    private List<BadgeHorizontalAlign> BadgeHorizontalAlignSettings { get; set; } = new List<BadgeHorizontalAlign>()
    {
        BadgeHorizontalAlign.Start,
        BadgeHorizontalAlign.End
    };

    private BadgeVerticalAlign BadgeVerticalAlignSetting { get; set; } = BadgeVerticalAlign.Top;
    private List<BadgeVerticalAlign> BadgeVerticalAlignSettings { get; set; } = new List<BadgeVerticalAlign>()
    {
        BadgeVerticalAlign.Top,
        BadgeVerticalAlign.Bottom
    };
}
