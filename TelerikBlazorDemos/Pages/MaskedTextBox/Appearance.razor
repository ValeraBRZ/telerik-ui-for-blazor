@page "/maskedtextbox/appearance"

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Fill Mode">
        <TelerikDropDownList TextField="Key" ValueField="Value" Data="@FillModes" @bind-Value="@FillMode" Width="150px"><DropDownListSettings><DropDownListPopupSettings Height="auto"></DropDownListPopupSettings></DropDownListSettings></TelerikDropDownList>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Rounded">
        <TelerikDropDownList TextField="Key" ValueField="Value" Data="@Roundnesses" @bind-Value="@Rounded" Width="150px"><DropDownListSettings><DropDownListPopupSettings Height="auto"></DropDownListPopupSettings></DropDownListSettings></TelerikDropDownList>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Size">
        <TelerikDropDownList TextField="Key" ValueField="Value" Data="@Sizes" @bind-Value="@Size" Width="150px"><DropDownListSettings><DropDownListPopupSettings Height="auto"></DropDownListPopupSettings></DropDownListSettings></TelerikDropDownList>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<div class="demo-section auto">
    <TelerikMaskedTextBox @bind-Value="@PhoneNumber"
                          Mask="(999) 000-0000"
                          FillMode="@FillMode"
                          Rounded="@Rounded"
                          Size="@Size">
    </TelerikMaskedTextBox>
</div>

@code {
    public string FillMode { get; set; } = ThemeConstants.MaskedTextBox.FillMode.Solid;
    public string Rounded {  get; set; } = ThemeConstants.MaskedTextBox.Rounded.Medium;
    public string Size {  get; set; } = ThemeConstants.MaskedTextBox.Size.Medium;

    public Dictionary<string, string> Roundnesses { get; set; } = new Dictionary<string, string>
    {
        { "Small", ThemeConstants.MaskedTextBox.Rounded.Small },
        { "Medium", ThemeConstants.MaskedTextBox.Rounded.Medium },
        { "Large", ThemeConstants.MaskedTextBox.Rounded.Large },
        { "Full", ThemeConstants.MaskedTextBox.Rounded.Full }
    };

    public Dictionary<string, string> FillModes { get; set; } = new Dictionary<string, string>
    {
        { "Solid", ThemeConstants.MaskedTextBox.FillMode.Solid },
        { "Flat", ThemeConstants.MaskedTextBox.FillMode.Flat },
        { "Outline", ThemeConstants.MaskedTextBox.FillMode.Outline },
    };

    public Dictionary<string, string> Sizes { get; set; } = new Dictionary<string, string>
    {
        { "Small", ThemeConstants.MaskedTextBox.Size.Small },
        { "Medium", ThemeConstants.MaskedTextBox.Size.Medium },
        { "Large", ThemeConstants.MaskedTextBox.Size.Large }
    };

    public string PhoneNumber { get; set; } = "5551234567";
}
