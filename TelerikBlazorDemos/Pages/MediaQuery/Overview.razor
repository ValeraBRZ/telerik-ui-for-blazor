@page "/mediaquery/overview"

<TelerikMediaQuery Media="(max-width: 480px)" OnChange="((changed) => XSmall = changed)"></TelerikMediaQuery>
<TelerikMediaQuery Media="(max-width: 960px)" OnChange="((changed) => Small = changed)"></TelerikMediaQuery>
<TelerikMediaQuery Media="(max-width: 1280px)" OnChange="((changed) => Medium = changed)"></TelerikMediaQuery>
<TelerikMediaQuery Media="(min-width: 1281px)" OnChange="((changed) => Large = changed)"></TelerikMediaQuery>

<div class="demo-alert demo-alert-info">Resize your browser to see the effects of the media queries on the Blazor code.</div>

@if (XSmall)
{
    <div class="k-card k-card-vertical">
        <div class="k-card-header k-display-flex">
            <div class="k-avatar k-avatar-md k-avatar-rounded k-avatar-primary k-avatar-solid">
                <div class="k-avatar-image"></div>
            </div>
            <div>
                <h5 class="k-card-title">@Teneriffe.Title</h5>
            </div>
        </div>
        <div class="k-card-body">
            @((MarkupString)Teneriffe.Overview)
        </div>
    </div>
}
else if (Small)
{
    <div class="k-card k-card-vertical">
        <img class="k-card-image k-small-card-image" src="images/destinations/@Teneriffe.SmallImage" alt="@Teneriffe.Title" />
        <div class="k-rowset k-column">
            <div class="k-card-body">
                <h5 class="k-card-title">@Teneriffe.Title</h5>
                <h4 class="k-card-subtitle">Overview</h4>
                @((MarkupString)Teneriffe.Overview)
            </div>
        </div>
    </div>
}
else if (Medium)
{
    <div class="k-card k-card-horizontal">
        <img class="k-card-image" src="images/destinations/@Teneriffe.Image" alt="@Teneriffe.Title" />
        <div class="k-rowset k-column">
            <div class="k-card-body">
                <h5 class="k-card-title">@Teneriffe.Title</h5>
                <h4>Overview</h4>
                @((MarkupString)Teneriffe.Overview)
                <h4>HighLights</h4>
                @((MarkupString)Teneriffe.Highlights)
            </div>
        </div>
    </div>
}
else if (Large)
{
    <div class="k-card k-card-horizontal">
        <img class="k-card-image k-large-card-image" src="images/destinations/@Teneriffe.Image" alt="@Teneriffe.Title" />
        <div class="k-rowset k-column">
            <div class="k-card-body">
                <h5 class="k-card-title">@Teneriffe.Title</h5>
                <h4>Overview</h4>
                @((MarkupString)Teneriffe.Overview)
                <h4>HighLights</h4>
                @((MarkupString)Teneriffe.Highlights)
                <h4>Climate</h4>
                @((MarkupString)Teneriffe.Climate)
            </div>
        </div>
    </div>
}

