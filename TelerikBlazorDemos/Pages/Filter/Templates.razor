@page "/filter/templates"

@using System.ComponentModel.DataAnnotations.Schema
@using Telerik.DataSource
@using Telerik.DataSource.Extensions

@inject ProductService ProductService
@inject CategoryService CategoryService

<TelerikFilter Value="@FilterValue" OnUpdate="@OnFilterValueChanged">
    <FilterFields>
        <FilterField Name="@(nameof(ProductDto.ProductName))" Type="@(typeof(string))" Label="Name" />
        <FilterField Name="@(nameof(ProductDto.UnitPrice))" Type="@(typeof(decimal))" Label="Price" />
        <FilterField Name="@(nameof(ProductDto.CategoryId))" Type="@(typeof(int?))" Label="Category" Operators="@CustomCategoryOperators">
            <ValueTemplate>
                <TelerikDropDownList Data="@Categories"
                                     Value="@((int?)context.FilterDescriptor.Value)"
                                     ValueField="@nameof(CategoryDto.CategoryId)"
                                     TextField="@nameof(CategoryDto.CategoryName)"
                                     ValueChanged="@((int? value) => OnDropDownListValueChanged(context.FilterDescriptor, value))">
                    <DropDownListSettings>
                        <DropDownListPopupSettings Height="auto" />
                    </DropDownListSettings>
                </TelerikDropDownList>
            </ValueTemplate>
        </FilterField>
    </FilterFields>
</TelerikFilter>

<TelerikGrid Data="@GridData"
             Height="400px">
    <GridColumns>
        <GridColumn Field="@(nameof(ProductDto.ProductName))" Title="Product Name" />
        <GridColumn Field="@nameof(ProductDto.CategoryId)" Title="Product Category">
            <Template>
                @{
                    var product = (ProductDto)context;
                }
                @Categories.FirstOrDefault(x => x.CategoryId == product.CategoryId)?.CategoryName
            </Template>
        </GridColumn>
        <GridColumn Field="@(nameof(ProductDto.UnitPrice))" Title="Product Price" DisplayFormat="{0:C}" />
    </GridColumns>
</TelerikGrid>

@code {
    private IEnumerable<ProductDto> GridData { get; set; } = new List<ProductDto>();

    private IEnumerable<ProductDto> InitialData { get; set; } = new List<ProductDto>();

    private IEnumerable<CategoryDto> Categories { get; set; } = new List<CategoryDto>();

    private CompositeFilterDescriptor FilterValue { get; set; } = new CompositeFilterDescriptor();

    private List<FilterListOperator> CustomCategoryOperators = new List<FilterListOperator>
    {
        new FilterListOperator { Operator = FilterOperator.IsNotNull, Text = "(All)" },
        new FilterListOperator { Operator = FilterOperator.IsEqualTo, Text = "Is Equal To" }
    };

    private void OnDropDownListValueChanged(FilterDescriptor filterDescriptor, int? newValue)
    {
        filterDescriptor.Value = newValue;
        ProcessGridData(FilterValue);
    }

    private void OnFilterValueChanged()
    {
        ProcessGridData(FilterValue);
    }

    private void ProcessGridData(CompositeFilterDescriptor filterDescriptor)
    {
        var dataSourceRequest = new DataSourceRequest { Filters = new List<IFilterDescriptor> { filterDescriptor } };

        var dataSourceResult = InitialData.ToDataSourceResult(dataSourceRequest);

        GridData = dataSourceResult.Data.Cast<ProductDto>();
    }

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        InitialData = GridData = ProductService.GetProducts().ToList();

        Categories = CategoryService.GetCategories().ToList();
    }
}

