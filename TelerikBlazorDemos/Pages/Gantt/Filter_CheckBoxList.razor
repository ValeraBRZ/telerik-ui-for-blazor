@page "/gantt/filter-checkboxlist"

@inject GanttTaskService GanttTaskService
@inject GanttDependencyService GanttDependencyService

<TelerikGantt Data="@Data"
              @bind-TreeListWidth="@TreeListWidth"
              IdField="Id"
              ParentIdField="ParentId"
              FilterMode="@GanttFilterMode.FilterMenu"
              FilterMenuType="@FilterMenuType.CheckBoxList"
              OnEdit="@( (GanttEditEventArgs args) => args.IsCancelled = true )"
              Width="100%"
              Height="500px">
    <GanttColumns>
        <GanttColumn Field="Title"
                     Expandable="true"
                     Width="220px"
                     Title="Task Title">
        </GanttColumn>
        <GanttColumn Field="Start"
                     Width="100px"
                     DisplayFormat="{0:d}">
        </GanttColumn>
        <GanttColumn Field="End"
                     Width="100px"
                     DisplayFormat="{0:d}">
        </GanttColumn>
        <GanttColumn Field="PercentComplete"
                     Width="100px"
                     Title="Status"
                     DisplayFormat="{0:P}">
        </GanttColumn>
    </GanttColumns>
    <GanttViews>
        <GanttWeekView></GanttWeekView>
    </GanttViews>
    <GanttDependenciesSettings>
        <GanttDependencies Data="@Dependencies"
                           PredecessorIdField="PredecessorId"
                           SuccessorIdField="SuccessorId"
                           TypeField="Type">
        </GanttDependencies>
    </GanttDependenciesSettings>
</TelerikGantt>

@code{
    public List<GanttTaskDto> Data { get; set; } = new List<GanttTaskDto>();

    public List<GanttDependencyDto> Dependencies { get; set; } = new List<GanttDependencyDto>();

    public string TreeListWidth { get; set; } = "50%";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        await LoadDependenciesAsync();
    }

    private async Task LoadDataAsync()
    {
        Data = (await GanttTaskService.GetTasksAsync()).ToList();
    }

    private async Task LoadDependenciesAsync()
    {
        Dependencies = (await GanttDependencyService.GetDependenciesAsync()).ToList();
    }
}

<style>
    /* Disable Timeline editing via CSS.
        Will not be necessary when this is done:
        https://feedback.telerik.com/blazor/1572900
    */

    /* delete button */
    .k-gantt .k-task:hover .k-task-actions,
    /* resize handles */
    .k-gantt .k-task:hover .k-resize-handle,
    /* progress drag handle */
    .k-gantt .k-task-wrap:hover .k-task-draghandle,
    /* dependency handles */
    .k-gantt .k-task-wrap:hover .k-task-dot,
    /* drag overlay */
    .k-gantt .k-gantt-marquee,
    /* drag tooltip */
    .k-gantt .k-gantt-resize-hint {
        visibility: hidden;
    }
</style>
