@page "/treelist/custom-editor"

@inject EmployeeDirectoryService employeeDirectoryService

<TelerikTreeList Data="@Data"
                 IdField="EmployeeId"
                 ParentIdField="ReportsTo"
                 Pageable="true"
                 EditMode="@TreeListEditMode.Inline"
                 OnCreate="@CreateItem"
                 OnUpdate="@UpdateItem"
                 OnDelete="@DeleteItem">
    <TreeListToolBarTemplate>
        <TreeListCommandButton Command="Add" Icon="@SvgIcon.Plus">Add</TreeListCommandButton>
    </TreeListToolBarTemplate>
    <TreeListColumns>
        <TreeListColumn Field="FirstName" Title="First Name" Width="350px" Expandable="true"></TreeListColumn>
        <TreeListColumn Field="LastName" Title="Last Name"></TreeListColumn>
        <TreeListColumn Field="Position" Width="200px">
            <EditorTemplate>
                @{
                    ItemToEdit = context as EmployeeDirectoryDto;

                    <TelerikDropDownList Data="@Positions"
                                         @bind-Value="@ItemToEdit.Position"
                                         Width="170px">
                    </TelerikDropDownList>
                }
            </EditorTemplate>
        </TreeListColumn>
        <TreeListColumn Field="HireDate" Title="Hire Date" EditorType="@TreeListEditorType.DateTimePicker"></TreeListColumn>
        <TreeListCommandColumn>
            <TreeListCommandButton Command="Add" Icon="@SvgIcon.Plus"></TreeListCommandButton>
            <TreeListCommandButton Command="Edit" Icon="@SvgIcon.Pencil"></TreeListCommandButton>
            <TreeListCommandButton Command="Delete" Icon="@SvgIcon.Trash"></TreeListCommandButton>
            <TreeListCommandButton Command="Save" Icon="@SvgIcon.Save" ShowInEdit="true"></TreeListCommandButton>
            <TreeListCommandButton Command="Cancel" Icon="@SvgIcon.Cancel" ShowInEdit="true"></TreeListCommandButton>
        </TreeListCommandColumn>
    </TreeListColumns>
</TelerikTreeList>

@code {
    public EmployeeDirectoryDto ItemToEdit { get; set; }
    public IEnumerable<EmployeeDirectoryDto> Data { get; set; }
    public IEnumerable<string> Positions { get; set; }

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        Data = employeeDirectoryService.GetEmployeeDirectories();
        Positions = Data.Select(e => e.Position).Distinct();
    }

    private void CreateItem(TreeListCommandEventArgs args)
    {
        var item = (EmployeeDirectoryDto)args.Item;

        item.ReportsTo = ((EmployeeDirectoryDto)args.ParentItem)?.EmployeeId;

        employeeDirectoryService.CreateEmployeeDirectory((EmployeeDirectoryDto)args.Item);
        LoadData();
    }

    private void UpdateItem(TreeListCommandEventArgs args)
    {
        employeeDirectoryService.UpdateEmployeeDirectory((EmployeeDirectoryDto)args.Item);
        LoadData();
    }

    private void DeleteItem(TreeListCommandEventArgs args)
    {
        employeeDirectoryService.DeleteEmployeeDirectory((EmployeeDirectoryDto)args.Item);
        LoadData();
    }
}
