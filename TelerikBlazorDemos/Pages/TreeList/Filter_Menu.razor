@page "/treelist/filter-menu"

@using Telerik.DataSource

@inject EmployeeDirectoryService employeeDirectoryService

<div class="demo-alert demo-alert-info">
    The <strong>First Name</strong> column has <strong>DefaultFilterOperator</strong>. The <strong>Hire Date</strong> column uses customized list of <strong>FilterOperators</strong>.
</div>

<TelerikTreeList Data="@Data"
                 IdField="EmployeeId"
                 ParentIdField="ReportsTo"
                 Pageable="true"
                 FilterMode="@TreeListFilterMode.FilterMenu">
    <TreeListColumns>
        <TreeListColumn Field="EmployeeId" Title="Id" Width="100px"></TreeListColumn>
        <TreeListColumn Field="FirstName" Title="First Name" Width="350px" Expandable="true" DefaultFilterOperator="@FilterOperator.StartsWith" ></TreeListColumn>
        <TreeListColumn Field="LastName" Title="Last Name"></TreeListColumn>
        <TreeListColumn Field="HireDate" Title="Hire Date" FilterOperators="@DateOperators"></TreeListColumn>
    </TreeListColumns>
</TelerikTreeList>

@code {
    public IEnumerable<EmployeeDirectoryDto> Data { get; set; }

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        Data = employeeDirectoryService.GetEmployeeDirectories();
    }

    public List<FilterListOperator> DateOperators = new List<FilterListOperator>
    {
        new FilterListOperator { Operator = FilterOperator.IsEqualTo, Text = "On" },
        new FilterListOperator { Operator = FilterOperator.IsGreaterThan, Text = "After" },
        new FilterListOperator { Operator = FilterOperator.IsLessThan, Text = "Before" },
        new FilterListOperator { Operator = FilterOperator.IsNotEqualTo, Text = "Is Not" },
    };
 }
