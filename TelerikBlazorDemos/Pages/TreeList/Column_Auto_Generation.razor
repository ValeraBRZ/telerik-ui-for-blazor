@page "/treelist/column-auto-generation"

@using System.ComponentModel.DataAnnotations;

<TelerikTreeList Data="@Data"
                 IdField="EmployeeId"
                 ParentIdField="ParentId"
                 Pageable="true"
                 Sortable="true"
                 AutoGenerateColumns="true"
                 EditMode="TreeListEditMode.Inline"
                 OnCreate="@CreateItem"
                 OnUpdate="@UpdateItem"
                 OnDelete="@DeleteItem"
                 Height="400px">
    <TreeListToolBarTemplate>
        <TreeListCommandButton Command="Add" Icon="@SvgIcon.Plus">Add</TreeListCommandButton>
    </TreeListToolBarTemplate>
    <TreeListColumns>
        <TreeListColumn Field="@nameof(Employee.EmployeeId)" Title="Employee Id" Width="80px" Editable="false" />
        <TreeListColumn Field="@nameof(Employee.Name)" Title="Name" Width="200px" Expandable="true" />

        <TreeListAutoGeneratedColumns />

        <TreeListCommandColumn Width="180px">
            <TreeListCommandButton Command="Add" Icon="@SvgIcon.Plus"></TreeListCommandButton>
            <TreeListCommandButton Command="Edit" Icon="@SvgIcon.Pencil"></TreeListCommandButton>
            <TreeListCommandButton Command="Delete" Icon="@SvgIcon.Trash"></TreeListCommandButton>
            <TreeListCommandButton Command="Save" Icon="@SvgIcon.Save" ShowInEdit="true"></TreeListCommandButton>
            <TreeListCommandButton Command="Cancel" Icon="@SvgIcon.Cancel" ShowInEdit="true"></TreeListCommandButton>
        </TreeListCommandColumn>
    </TreeListColumns>
</TelerikTreeList>

@code {
    public class Employee
    {
        public Employee()
        {
            HireDate = MeetingDate = DateTime.Now;
        }

        [Display(AutoGenerateField = false, Name = "Employee #")]
        public int? EmployeeId { get; set; }

        [Display(AutoGenerateField = false)]
        public int? ParentId { get; set; }

        [Editable(false)]
        [Display(AutoGenerateField = false, Name = "Employee Name")]
        public string Name { get; set; }

        [Display(Name = "Age In Years")]
        public int? AgeInYears { get; set; }

        [Display(Name = "Graduate Grade")]
        public decimal? GraduateGrade { get; set; }

        [Display(Name = "HireDate")]
        public DateTime HireDate { get; set; }

        [Display(AutoGenerateField = false, Name = "Meeting Date")]
        public DateTime MeetingDate { get; set; }
    }

    public List<Employee> Data { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Data = new List<Employee>();
        var rand = new Random();

        // Create Parent Items
        for (int i = 0; i < 6; i++)
        {
            Data.Add(new Employee()
            {
                EmployeeId = i,
                ParentId = null,
                Name = "Employee " + i.ToString(),
                AgeInYears = rand.Next(10, 80),
                HireDate = DateTime.Now.Date.AddDays(rand.Next(-20, 20)),
                MeetingDate = DateTime.Now.Date.AddDays(rand.Next(20, 40)),
                GraduateGrade = i % 4 + 3
            });
        }

        for (int i = 6; i < 100; i++)
        {
            Data.Add(new Employee()
            {
                EmployeeId = i,
                ParentId = rand.Next(0, 6),
                Name = "Employee " + i.ToString(),
                AgeInYears = rand.Next(10, 80),
                HireDate = DateTime.Now.Date.AddDays(rand.Next(-20, 20)),
                MeetingDate = DateTime.Now.Date.AddDays(rand.Next(20, 40)),
                GraduateGrade = i % 4 + 3
            });
        }

        await base.OnInitializedAsync();
    }

    private void CreateItem(TreeListCommandEventArgs args)
    {
        var argsItem = args.Item as Employee;
        var lastId = Data.Count > 0 ? Data.Max(x => x.EmployeeId) + 1 : 1;

        argsItem.EmployeeId = lastId;
        argsItem.ParentId = (args.ParentItem as Employee)?.EmployeeId;

        Data.Insert(0, argsItem);
    }

    private void UpdateItem(TreeListCommandEventArgs args)
    {
        var argsItem = args.Item as Employee;
        var index = Data.FindIndex(i => i.EmployeeId == argsItem.EmployeeId);

        if (index != -1)
        {
            Data[index].Name = argsItem.Name;
            Data[index].AgeInYears= argsItem.AgeInYears;
            Data[index].HireDate = argsItem.HireDate;
            Data[index].MeetingDate = argsItem.MeetingDate;
            Data[index].GraduateGrade = argsItem.GraduateGrade;
        }
    }

    private void DeleteItem(TreeListCommandEventArgs args)
    {
        var argsItem = args.Item as Employee;

        DeleteChildItems(argsItem);
        Data.Remove(argsItem);
    }

    private void DeleteChildItems(Employee parentItem)
    {
        var childItems = Data.Where(x => parentItem.EmployeeId.Equals(x.ParentId)).ToList();

        for (int i = 0; i < childItems.Count; i++)
        {
            DeleteChildItems(childItems[i]);
            Data.Remove(childItems[i]);
        }
    }
 }
