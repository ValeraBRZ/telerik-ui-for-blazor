@page "/autocomplete/templates"

<div class="demo-section k-form k-form-md k-form-vertical">
    <div class="k-form-field">
        <label for="countries" class="k-label k-form-label">Country: @Value</label>
        <div class="k-form-field-wrap">
            <TelerikAutoComplete Data="@Countries" @bind-Value="@Value" Filterable="true"
                                 Placeholder="Write your country" Id="countries" Width="100%">
                <HeaderTemplate>
                    <h5>Countries</h5>
                </HeaderTemplate>
                <ItemTemplate>
                    <strong>@context</strong>
                </ItemTemplate>
                <FooterTemplate>
                    <h5>Total: @Countries.Count()</h5>
                </FooterTemplate>
                <NoDataTemplate>
                    <div>
                        <TelerikSvgIcon Icon="@SvgIcon.InfoCircle" Size="@ThemeConstants.SvgIcon.Size.Large" />
                        <br />
                        <br />
                        No items to display...
                    </div>
                </NoDataTemplate>
            </TelerikAutoComplete>
        </div>
    </div>
</div>

