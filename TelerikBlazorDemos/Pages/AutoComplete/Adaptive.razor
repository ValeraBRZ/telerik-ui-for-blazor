@page "/autocomplete/adaptive"

@inject ProductService ProductService

<div class="demo-alert demo-alert-info" role="alert">
    <p>
        Resize the browser to see how the AutoComplete adapts to different resolutions.
    </p>
</div>

<div class="demo-section">
    <label for="product" class="k-label k-form-label">Product</label>
    <TelerikAutoComplete Data="@Data"
                         @bind-Value="@Value"
                         AdaptiveMode="@AdaptiveMode.Auto"
                         Title="Choose a product"
                         Filterable="true"
                         ValueField="@nameof(ProductDto.ProductName)"
                         Placeholder="Enter a product, e.g., Tofu"
                         Size="@ThemeConstants.AutoComplete.Size.Large"
                         Id="product">
    </TelerikAutoComplete>
</div>

@code {
    public string Value { get; set; }

    public IEnumerable<ProductDto> Data { get; set; }

    protected override void OnInitialized()
    {
        Data = ProductService.GetProducts();
    }
}
