@page "/autocomplete/filtering"

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Debounce Delay">
        <TelerikNumericTextBox @bind-Value="@DebounceDelay" Min="0" Max="1000"/>
    </DemoConfiguratorColumn>    
</DemoConfigurator>

<div class="demo-section k-form k-form-md k-form-vertical">
    <div class="k-form-field">
        <label for="basic" class="k-label k-form-label">Basic configuration</label>
        <div class="k-form-field-wrap">
            <TelerikAutoComplete Data="@Countries" Value="@Value"
                                 Placeholder="type Malta"
                                 Filterable="true"
                                 Id="basic" Width="100%"
                                 DebounceDelay="@DebounceDelay">
                <NoDataTemplate>
                    <div>
                        <TelerikSvgIcon Icon="@SvgIcon.InfoCircle" Size="@ThemeConstants.SvgIcon.Size.Large" />
                        <br />
                        <br />
                        No items to display...
                    </div>
                </NoDataTemplate>
            </TelerikAutoComplete>
        </div>
    </div>
    <div class="k-form-field">
        <label for="minLength" class="k-label k-form-label">Minimum Filter Length</label>
        <div class="k-form-field-wrap">
            <TelerikAutoComplete Data="@Countries" Value="@Value"
                                 Placeholder="type Malta"
                                 MinLength="3" Filterable="true"
                                 Id="minLength" Width="100%"
                                 DebounceDelay="@DebounceDelay">
                <NoDataTemplate>
                    <div>
                        <TelerikSvgIcon Icon="@SvgIcon.InfoCircle" Size="@ThemeConstants.SvgIcon.Size.Large" />
                        <br />
                        <br />
                        No items to display...
                    </div>
                </NoDataTemplate>
            </TelerikAutoComplete>
        </div>
    </div>
    <div class="k-form-field">
        <h4>Filter Operator</h4>
        <label for="filterOperator" class="k-label k-form-label">Choose filter operator:</label>
        <div class="k-form-field-wrap">
            <TelerikDropDownList @bind-Value="@FilterOperator"
                                 Id="filterOperator"
                                 Data="@FilterOperators"
                                 Width="160px">
                <DropDownListSettings>
                    <DropDownListPopupSettings Height="auto"></DropDownListPopupSettings>
                </DropDownListSettings>
            </TelerikDropDownList>
        </div>
    </div>
    <div class="k-form-field">
        <div class="k-form-field-wrap">
            <TelerikAutoComplete Data="@Countries" Value="@Value"
                                 Placeholder="type 'a' to see the difference"
                                 FilterOperator="@FilterOperator"
                                 Filterable="true"
                                 Width="100%"
                                 DebounceDelay="@DebounceDelay">
                <NoDataTemplate>
                    <div>
                        <TelerikSvgIcon Icon="@SvgIcon.InfoCircle" Size="@ThemeConstants.SvgIcon.Size.Large" />
                        <br />
                        <br />
                        No items to display...
                    </div>
                </NoDataTemplate>
            </TelerikAutoComplete>
        </div>
    </div>
</div>

@code {
    public int DebounceDelay { get; set; } = 200;
    public string Value { get; set; }
    public IEnumerable<StringFilterOperator> FilterOperators { get; set; } = Enum.GetValues(typeof(StringFilterOperator)).Cast<StringFilterOperator>().ToList();
    StringFilterOperator FilterOperator { get; set; } = StringFilterOperator.StartsWith;
    List<string> Countries = new List<string>()
        {
            "Albania",
            "Andorra",
            "Armenia",
            "Austria",
            "Azerbaijan",
