@page "/autocomplete/validation"

@using System.ComponentModel.DataAnnotations

@if (string.IsNullOrEmpty(SuccessMessage))
{
    <TelerikForm Model="@Employee"
                 OnValidSubmit="@OnFormValidSubmit">
        <FormValidation>
            <DataAnnotationsValidator />
            <TelerikValidationSummary />
        </FormValidation>
        <FormItems>
            <FormItem Field="@nameof(Employee.BirthPlace)">
                <Template>
                    <label for="destinations" class="k-label k-form-label">Country of Birth</label>
                    <div class="k-form-field-wrap">
                        <TelerikAutoComplete Data="@Countries"
                                             @bind-Value="@Employee.BirthPlace"
                                             Placeholder="Enter Country of Birth">
                        </TelerikAutoComplete>
                        <TelerikValidationMessage For="@(() => Employee.BirthPlace)" />
                    </div>
                </Template>
            </FormItem>
        </FormItems>
    </TelerikForm>
}
else
{
    <div class="demo-alert demo-alert-success" role="alert">
        @SuccessMessage
    </div>
}

