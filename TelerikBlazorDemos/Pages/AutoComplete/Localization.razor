@page "/autocomplete/localization"

<DemoConfigurator>
    <DemoConfiguratorColumn>
        <CultureChooser></CultureChooser>
    </DemoConfiguratorColumn>
</DemoConfigurator>


<div class="demo-section k-form k-form-md k-form-vertical">
    <div class="k-form-field">
        <label for="countries" class="k-label k-form-label">Country: @Value</label>
        <div class="k-form-field-wrap">
            <TelerikAutoComplete Data="@Countries" @bind-Value="@Value" Filterable="true" Width="100%"
                                 Placeholder="Type something random, hover the [x] button" Id="countries">
            </TelerikAutoComplete>
        </div>
    </div>
</div>

