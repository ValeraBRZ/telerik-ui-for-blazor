@page "/panelbar/templates"

<TelerikPanelBar Data="@FlatData" @bind-ExpandedItems="@ExpandedItems">
    <PanelBarBindings>
        <PanelBarBinding>
            <ContentTemplate>
                <div class="panelbar-template">
                    <h2 class="k-text-primary">Custom Template:</h2>
                    @(((PanelBarItem)context).Text)
                </div>
            </ContentTemplate>
            <HeaderTemplate>
                <strong>@(((PanelBarItem)context).Text.ToUpper())</strong>
            </HeaderTemplate>
        </PanelBarBinding>
    </PanelBarBindings>
</TelerikPanelBar>


@code {
    public class PanelBarItem
    {
        public int Id { get; set; }
        public string Text { get; set; }
        public int? ParentId { get; set; }
        public bool HasChildren { get; set; }
        public bool Disabled { get; set; }
    }

    public IEnumerable<PanelBarItem> FlatData { get; set; }
    public IEnumerable<object> ExpandedItems { get; set; }

    protected override void OnInitialized()
    {
        LoadFlatData();
    }

    private void LoadFlatData()
    {
        List<PanelBarItem> items = new List<PanelBarItem>();
        items.Add(new PanelBarItem() { Id = 0, Text = "Projects", HasChildren = true });
        items.Add(new PanelBarItem() { Id = 1, Text = "New Business Plan", ParentId = 0 });
        items.Add(new PanelBarItem() { Id = 2, Text = "Sales Forecasts", HasChildren = true, ParentId = 0 });
        items.Add(new PanelBarItem() { Id = 3, Text = "Q1 Forecast", ParentId = 2 });
        items.Add(new PanelBarItem() { Id = 4, Text = "Q2 Forecast", ParentId = 2 });
        items.Add(new PanelBarItem() { Id = 5, Text = "Q3 Forecast", ParentId = 2 });
        items.Add(new PanelBarItem() { Id = 6, Text = "Q4 Forecast", ParentId = 2 });
        items.Add(new PanelBarItem() { Id = 7, Text = "Programs", HasChildren = true });
        items.Add(new PanelBarItem() { Id = 8, Text = "Monday", ParentId = 7 });
        items.Add(new PanelBarItem() { Id = 9, Text = "Tuesday", ParentId = 7 });
        items.Add(new PanelBarItem() { Id = 10, Text = "Wednesday", ParentId = 7 });
        items.Add(new PanelBarItem() { Id = 11, Text = "Thursday", ParentId = 7 });
        items.Add(new PanelBarItem() { Id = 12, Text = "Friday", ParentId = 7 });
        items.Add(new PanelBarItem() { Id = 13, Text = "Communication"});

        FlatData = items;

        ExpandedItems = new List<object> { items.Last() };
    }
}

<style>
    .panelbar-template {
        padding: 20px;
        font-size: 1.2em;
        margin: 0 auto;
        width: 400px;
        text-align: center;
    }
</style>
