@page "/panelbar/events"

<TelerikPanelBar Data="@FlatData"
                 OnItemClick="@OnItemClick"
                 ExpandedItems="@ExpandedItems"
                 ExpandedItemsChanged="@OnExpandItems">
</TelerikPanelBar>

<DemoConsole EventLog="@EventLog" OnClearLogClick="@OnClearLogClick" />

@code {
    public class PanelBarItem
    {
        public int Id { get; set; }
        public string Text { get; set; }
        public int? ParentId { get; set; }
        public bool HasChildren { get; set; }
        public ISvgIcon Icon { get; set; }
    }

    public string EventLog { get; set; } = string.Empty;

    public TreeViewSelectionMode SelectionMode { get; set; } = TreeViewSelectionMode.Multiple;

    public IEnumerable<PanelBarItem> FlatData { get; set; }

    public IEnumerable<PanelBarItem> ExpandedItems { get; set; }

    protected override void OnInitialized()
    {
        LoadInitialData();
    }

    void OnClearLogClick()
    {
        EventLog = string.Empty;
    }

    public void OnExpandItems(IEnumerable<object> expandedItems)
    {
        ExpandedItems = expandedItems.Select(x => x as PanelBarItem);
        var log = "<div><strong>Expand event</strong>. The following items have been Expanded in the Panel Bar<ul>";

        foreach (var item in expandedItems)
        {
            log += $"<li><strong>{(item as PanelBarItem).Text}</strong></li>";
        }

        log += "</ul></div>";

        EventLog = EventLog.Insert(0, log);
    }

    public void OnItemClick(PanelBarItemClickEventArgs args)
    {
        var itemText = (args.Item as PanelBarItem).Text;
        var log = $"<div><strong>Item Click event</strong>: Item Text: <strong>{itemText}</strong></div>";

        EventLog = EventLog.Insert(0, log);
    }

    private void LoadInitialData()
    {
        List<PanelBarItem> items = new List<PanelBarItem>();
        items.Add(new PanelBarItem()
        {
            Id = 1,
            Text = "Project",
            ParentId = null,
            HasChildren = true,
            Icon = SvgIcon.Folder
        });
        items.Add(new PanelBarItem()
        {
            Id = 2,
            Text = "Design",
            ParentId = 1,
            HasChildren = true,
            Icon = SvgIcon.Brush
        });
        items.Add(new PanelBarItem()
        {
            Id = 3,
            Text = "Implementation",
            ParentId = 1,
            HasChildren = true,
            Icon = SvgIcon.Folder
        });

        items.Add(new PanelBarItem()
        {
            Id = 4,
            Text = "site.psd",
            ParentId = 2,
            HasChildren = false,
            Icon = SvgIcon.FilePsd
        });

        items.Add(new PanelBarItem()
        {
            Id = 5,
            Text = "index.js",
            ParentId = 3,
            HasChildren = false,
            Icon = SvgIcon.Js
        });
        items.Add(new PanelBarItem()
        {
            Id = 6,
            Text = "index.html",
            ParentId = 3,
            HasChildren = false,
            Icon = SvgIcon.Code
        });

        items.Add(new PanelBarItem()
        {
            Id = 7,
            Text = "styles.css",
            ParentId = 3,
            HasChildren = false,
            Icon = SvgIcon.Css
        });

        ExpandedItems = new List<PanelBarItem> { items[0], items[1], items[2] };

        FlatData = items;
    }
}
