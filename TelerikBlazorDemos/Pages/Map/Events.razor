@page "/map/events"

<TelerikMap Center="@Center"
            MinZoom="3"
            MaxZoom="8"
            Zoom="3"
            WrapAround="false"
            OnClick="@OnClick"
            OnShapeClick="@OnShapeClick"
            OnMarkerClick="@OnMarkerClick"
            OnZoomEnd="@OnZoomEnd"
            OnPanEnd="@OnPanEnd">
    <MapLayers>
        <MapLayer Type="@MapLayersType.Tile"
                  Attribution="@Attribution"
                  Subdomains="@Subdomains"
                  UrlTemplate="@UrlTemplate">
        </MapLayer>

        <MapLayer Type="@MapLayersType.Bubble"
                  Data="@BubbleData"
                  LocationField="@nameof(BubbleModel.LatLng)"
                  ValueField="@nameof(BubbleModel.Population_2010)">
                  <MapLayerBubbleSettings>
                      <MapLayerBubbleSettingsStyle>
                          <MapLayerBubbleSettingsStyleFill Color="#0000ff"></MapLayerBubbleSettingsStyleFill>
                          <MapLayerBubbleSettingsStyleStroke Color="#000000"></MapLayerBubbleSettingsStyleStroke>
                      </MapLayerBubbleSettingsStyle>
                  </MapLayerBubbleSettings>
        </MapLayer>

        <MapLayer Type="@MapLayersType.Marker"
                  Data="@MarkerData1"
                  LocationField="@nameof(MarkerModel.LatLng)"
                  TitleField="@nameof(MarkerModel.Address)">
        </MapLayer>
    </MapLayers>
</TelerikMap>

<DemoConsole EventLog="@EventLog" OnClearLogClick="@OnClearLogClick" />

@code {
    private string EventLog { get; set; } = string.Empty;

    private string[] Subdomains { get; set; } = new string[] { "a", "b", "c" };
    private string UrlTemplate { get; set; } = "https://#= subdomain #.tile.openstreetmap.org/#= zoom #/#= x #/#= y #.png";
    private string Attribution { get; set; } = "&copy; <a href='https://osm.org/copyright'>OpenStreetMap contributors</a>";
    private double[] Center { get; set; } = new double[] { 30.268107, -97.744821 };


    #region Event handlers

    private void OnClick(MapClickEventArgs args)
    {
        var location = args.Location;
        var mouseEventArgs = args.EventArgs as MouseEventArgs;

        var log = string.Empty;
        log += "<div>";
        log += $"<div><code>OnClick</code> event fired:</div>";
        log += $"<ul>";
        log += $"<li><strong>Location:</strong> [{location.Latitude}, {location.Longitude}]</li>";
        log += $"<li><strong>Mouse Position:</strong> {mouseEventArgs.ClientX}, {mouseEventArgs.ClientY}</li>";
        log += $"</ul>";
        log += "</div>";

        LogToConsole(log);
    }

    private void OnShapeClick(MapShapeClickEventArgs args)
    {
        var dataItem = args.DataItem as BubbleModel;
        var mouseEventArgs = args.EventArgs as MouseEventArgs;

        var log = string.Empty;
        log += "<div>";
        log += $"<div><code>OnShapeClick</code> event fired:</div> ";
        log += $"<ul>";
        log += $"<li><strong>Shape (City):</strong> {dataItem.City}</li>";
        log += $"<li><strong>Location:</strong> [{string.Join(",", dataItem.LatLng)}]</li>";
        log += $"<li><strong>Mouse Position:</strong> {mouseEventArgs.ClientX}, {mouseEventArgs.ClientY}</li>";
        log += $"</ul>";
        log += "</div>";

        LogToConsole(log);
    }

    private void OnMarkerClick(MapMarkerClickEventArgs args)
    {
        var dataItem = args.DataItem as MarkerModel;
        var mouseEventArgs = args.EventArgs as MouseEventArgs;

        var log = string.Empty;
        log += "<div>";
        log += $"<div><code>OnMarkerClick</code> event fired:</div>";
        log += $"<ul>";
        log += $"<li><strong>Marker:</strong> {dataItem.Address}</li>";
        log += $"<li><strong>Location:</strong> [{string.Join(",", dataItem.LatLng)}]</li>";
        log += $"<li><strong>Mouse Position:</strong> {mouseEventArgs.ClientX}, {mouseEventArgs.ClientY}</li>";
        log += $"</ul>";
        log += "</div>";

        LogToConsole(log);
    }

    private void OnZoomEnd(MapZoomEndEventArgs args)
    {
        var zoomLevel = args.Zoom;
        var center = args.Center;
        var extent = args.Extent;

        var log = string.Empty;
        log += "<div>";
        log += $"<div><code>OnZoomEnd</code> event fired:</div>";
        log += $"<ul>";
        log += $"<li><strong>Zoom level:</strong> {zoomLevel}</li>";
        log += $"<li><strong>Center coordinates:</strong> [{center[0]}, {center[1]}]</li>";
        log += $"<li><strong>Extent:</strong> NW - [{extent[0]}, {extent[1]}]; SE - [{extent[2]}, {extent[3]}]</li>";
        log += $"</ul>";
        log += "</div>";

        LogToConsole(log);
    }

    private void OnPanEnd(MapPanEndEventArgs args)
    {
        var center = args.Center;
        var extent = args.Extent;

        var log = string.Empty;
        log += "<div>";
        log += $"<div><code>OnPanEnd</code> event fired:</div>";
        log += $"<ul>";
        log += $"<li><strong>Center coordinates:</strong> [{center[0]}, {center[1]}]</li>";
        log += $"<li><strong>Extent:</strong> NW - [{extent[0]}, {extent[1]}]; SE - [{extent[2]}, {extent[3]}]</li>";
        log += $"</ul>";
        log += "</div>";

        LogToConsole(log);
    }

    private void LogToConsole(string text)
    {
        EventLog = EventLog.Insert(0, text);
    }

    private void OnClearLogClick()
    {
        EventLog = string.Empty;
    }

    #endregion  Event handlers

    #region Map data and models

    private List<MarkerModel> MarkerData1 { get; set; } = new List<MarkerModel>()
    {
        new MarkerModel()
        {
            LatLng = new double[] { 47.6062, -122.3321 },
            Address = "Seattle, WA",
        },
        new MarkerModel()
        {
            LatLng = new double[] { 30.268107, -97.744821 },
            Address = "Austin, TX"
        },
        new MarkerModel()
        {
            LatLng = new double[] { 42.4906, -71.2760 },
            Address = "Bedford, MA",
        },
    };

    private List<BubbleModel> BubbleData { get; set; } = new List<BubbleModel>()
    {
        new BubbleModel()
        {
            LatLng = new double[] { 38.99, -94.62 }, City = "Kansas City", Country = "United States of America", Population_2010 = 1470
        },
        new BubbleModel()
        {
            LatLng = new double[] { 34, -118.25 }, City = "Los Angeles-Long Beach-Santa Ana", Country = "United States of America", Population_2010 = 12500
        },
        new BubbleModel()
        {
            LatLng = new double[] { 44.92, -93.3 }, City = "Minneapolis-St. Paul", Country = "United States of America", Population_2010 = 2620
        },
    };
    
    public class MarkerModel
    {
        public double[] LatLng { get; set; }
        public string Address { get; set; }
    }

    public class BubbleModel
    {
        public double[] LatLng { get; set; }
        public string City { get; set; }
        public string Country { get; set; }
        public int Population_2010 { get; set; }
    }

    #endregion Map data and models
}
