@page "/speechtotextbutton/overview"

<div class="demo-container"></div>
<div class="profile-demo card-container">
    <div class="k-card custom-card">
        <div class="card-row">
            <div class="card-column no-flex">
                <div class="sidebar-container k-skeleton">
                    <div class="avatar-name-container">
                        <div class="name-container">
                            <div class="k-skeleton skeleton-text"></div>
                            <div class="k-skeleton skeleton-small-text-short"></div>
                        </div>
                    </div>
                    <div class="description-container">
                        <div class="k-skeleton skeleton-small-text"></div>
                        <div class="k-skeleton skeleton-small-text"></div>
                        <div class="k-skeleton skeleton-small-text"></div>
                    </div>
                </div>
            </div>
            <div class="card-column">
                <div class="avatar-title-container">
                    <div class="k-skeleton skeleton-avatar"></div>
                    <h4 class="k-h4">Additional information</h4>
                </div>
                <div class="skeleton-container top">
                    <div class="k-skeleton skeleton-box-small"></div>
                    <div class="k-skeleton skeleton-box-large"></div>
                </div>
                <label class="project-label" for=".component-container">Project Impact Summary</label>
                <div class="component-container">
                    <TelerikTextArea @bind-Value="InputValue"
                                     Rounded="@ThemeConstants.TextArea.Rounded.Large"
                                     Placeholder="Describe a project you worked on that had a strong impact."
                                     ResizeMode="@TextAreaResizeMode.Auto"
                                     Rows="3">
                        <TextAreaSuffixTemplate>
                            <span class="suffix-text">@(IsRecording ? "Listening..." : "Click the mic to speak")</span>
                            <TelerikSpeechToTextButton OnResult="OnSpeechResult"
                                                       OnStart="@(() => IsRecording = !IsRecording)"
                                                       OnEnd="@(() => IsRecording = !IsRecording)"
                                                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                                       Rounded="@ThemeConstants.Button.Rounded.Large"
                                                       Lang="en-US" />
                        </TextAreaSuffixTemplate>
                    </TelerikTextArea>
                </div>
                <div class="skeleton-container bottom">
                    <div class="k-skeleton skeleton-box-small"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string InputValue { get; set; }
    private bool IsRecording { get; set; }

    private void OnSpeechResult(SpeechToTextButtonResultEventArgs args)
    {
        InputValue = args.Alternatives[0].Transcript;
    }
}

