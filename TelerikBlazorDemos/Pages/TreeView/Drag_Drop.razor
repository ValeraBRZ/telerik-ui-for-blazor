@page "/treeview/drag-drop"

<TelerikTreeView Data="@Data"
                 Id="TreeView"
                 @bind-ExpandedItems="@ExpandedItems"
                 Draggable="true"
                 OnDrop="@OnItemDrop"
                 OnDragStart="@OnDragStart"
                 DragThrottleInterval="250"
                 OnDrag="@OnDrag"
                 OnDragEnd="@OnDragEnd">
    <TreeViewBindings>
        <TreeViewBinding ParentIdField="Parent"></TreeViewBinding>
    </TreeViewBindings>
</TelerikTreeView>

<DemoConsole EventLog="@EventLog" OnClearLogClick="@OnClearLogClick" />

<TelerikWindow @bind-Visible="@WarningWindowVisible" Modal="true" Width="300px">
    <WindowActions>
        <WindowAction Name="Close"></WindowAction>
    </WindowActions>
    <WindowTitle>
        Warning
    </WindowTitle>
    <WindowContent>
        @WindowContent
    </WindowContent>
    <WindowFooter>
        <TelerikButton OnClick="@OnToggleWindowVisibility">Close</TelerikButton>
    </WindowFooter>
</TelerikWindow>

@code {
    public string CurrentItem { get; set; }
    public string DestinationItem { get; set; }
    public string Location { get; set; }
    public string WindowContent { get; set; }
    public string EventLog { get; set; } = string.Empty;

    public bool WarningWindowVisible { get; set; }

    public List<TreeItem> Data { get; set; }
    public IEnumerable<object> ExpandedItems { get; set; }

    public void OnClearLogClick()
    {
        EventLog = string.Empty;
    }

    public class TreeItem
    {
        public int Id { get; set; }
        public int? Parent { get; set; }
        public string Text { get; set; }
        public ISvgIcon Icon { get; set; }
        public bool HasChildren { get; set; }

        public TreeItem(int id, int? parent, string text, ISvgIcon icon, bool hasChildren)
        {
            Id = id;
            Parent = parent;
            Text = text;
            Icon = icon;
            HasChildren = hasChildren;
        }
    }

    public void OnDragStart(TreeViewDragStartEventArgs args)
    {
        var item = args.Item as TreeItem;

        if (item.Parent == 1 || item.Id == 1)
        {
            args.IsCancelled = true;
            WindowContent = "Dragging of Documents is prevented conditionally in the TreeView OnDragStart handler. Try another item.";
            WarningWindowVisible = true;
        }
        else
        {
            CurrentItem = item.Text;
            var log = "<div><strong>OnDragStart fired</strong></div>";
            EventLog = EventLog.Insert(0, log);
        }
    }

    public void OnDrag(TreeViewDragEventArgs args)
    {
        var log = "<div><strong>OnDrag fired</strong>: ";

        if (args.DestinationItem != null)
        {
            var destination = args.DestinationItem as TreeItem;
            DestinationItem = destination.Text;
        }

        if (args.DropPosition != null)
        {
            Location = args.DropPosition.Value.ToString().ToLower();
        }
        else
        {
            Location = "over";
        }

        log += $"{CurrentItem} is located {Location} {DestinationItem}.";
        log += "</div>";

        EventLog = EventLog.Insert(0, log);
    }

    public void OnDragEnd(TreeViewDragEndEventArgs args)
    {
        var log = "<div><strong>OnDragEnd fired</strong>: ";

        if (args.DestinationComponentId == "TreeView")
        {
            if (args.DropPosition == null)
            {
                log += "Incorrect drop location.";
            }
            else
            {
                log += $"{CurrentItem} was dropped {Location} {DestinationItem}.";
            }
        }
        else
        {
            log += "The dragging ended away from the treeview.";
        }

        log += "</div>";
        EventLog = EventLog.Insert(0, log);
    }

    protected override void OnInitialized()
    {
        LoadData();

        base.OnInitialized();
    }

    public void OnItemDrop(TreeViewDropEventArgs args)
    {
        var item = args.Item as TreeItem;
        var destinationItem = args.DestinationItem as TreeItem;

        if (destinationItem != null && IsChild(item, destinationItem))
        {
            WindowContent = "Drop over a child node is not supported!";
            WarningWindowVisible = true;

            return;
        }

        Data.Remove(item);

        if (item.Parent != null && !Data.Any(x => item.Parent == x.Parent))
        {
            Data.FirstOrDefault(x => x.Id == item.Parent).HasChildren = false;
        }

        if (args.DropPosition == TreeViewDropPosition.Over)
        {
            item.Parent = destinationItem.Id;
            destinationItem.HasChildren = true;
            Data.Add(item);
        }
        else
        {
            var index = Data.IndexOf(destinationItem);

            item.Parent = destinationItem.Parent;

            if (args.DropPosition == TreeViewDropPosition.After)
            {
                index++;
            }

            Data.Insert(index, item);
        }

        // Refresh data
        Data = new List<TreeItem>(Data);
    }

    public bool IsChild(TreeItem item, TreeItem destinationItem)
    {
        if (destinationItem?.Parent == null || item == null)
        {
            return false;
        }
        else if (destinationItem.Parent?.Equals(item.Id) == true)
        {
            return true;
        }

        var parentDestinationItem = Data.FirstOrDefault(e => e.Id.Equals(destinationItem.Parent));

        return IsChild(item, parentDestinationItem);
    }

    public void LoadData()
    {
        Data = new List<TreeItem>()
        {
            new TreeItem(1, null, "Documents", SvgIcon.Folder, true),
                new TreeItem(2, 1, "annualreport.xlsx", SvgIcon.FileExcel, false),
                new TreeItem(3, 1, "statusupdate.docx", SvgIcon.FileWord, false),
                new TreeItem(4, 1, "conferences.xlsx", SvgIcon.FileExcel, false),
                new TreeItem(5, 1, "performance.pdf", SvgIcon.FilePdf, false),
            new TreeItem(6, null, "Pictures", SvgIcon.Folder, true),
                new TreeItem(7, 6, "Camera Roll", SvgIcon.Folder, true),
                    new TreeItem(8, 7, "team.png", SvgIcon.FileImage, false),
                    new TreeItem(9, 7, "team-building.png", SvgIcon.FileImage, false),
                    new TreeItem(10, 7, "friends.png", SvgIcon.FileImage, false),
                new TreeItem(11, 6, "Screenshots", SvgIcon.Folder, true),
                    new TreeItem(12, 11, "screen-error.png", SvgIcon.FileImage, false),
                    new TreeItem(13, 11, "feedback.png", SvgIcon.FileImage, false),
            new TreeItem(14, null, "Videos", SvgIcon.Folder, true),
                new TreeItem(15, 14, "demo.gif", SvgIcon.MediaManager, false),
                new TreeItem(16, 14, "ux-components.avi", SvgIcon.MediaManager, false),
                new TreeItem(17, 14, "presentation-intro.avi", SvgIcon.MediaManager, false)
        };

        ExpandedItems = Data.ToList();
    }

    public void OnToggleWindowVisibility()
    {
        WarningWindowVisible = !WarningWindowVisible;
    }
}

<style>
    .k-treeview-lines {
        padding: 0px;
    }
</style>
