@page "/listview/paging"

@inject DestinationService DestinationService

<DemoConfigurator>
    <DemoConfiguratorColumn Description="Show Page Sizes">
        <TelerikCheckBox @bind-Value="@ShowPageSizeDropdown" Id="show-page-size-dropdown"></TelerikCheckBox>
        <label for="show-page-size-dropdown" class="k-checkbox-label checkbox-label">Show Page Sizes</label>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Input Type">
        <TelerikDropDownList Data="InputTypes" @bind-Value="@InputType" Width="150px"><DropDownListSettings><DropDownListPopupSettings Height="auto"></DropDownListPopupSettings></DropDownListSettings></TelerikDropDownList>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Buttons Count">
        <TelerikNumericTextBox Min="1" @bind-Value="@ButtonsCount"></TelerikNumericTextBox>
    </DemoConfiguratorColumn>
    <DemoConfiguratorColumn Description="Pager Position">
        <TelerikDropDownList Data="PagerPositions" @bind-Value="@PagerPosition" Width="150px">
            <DropDownListSettings><DropDownListPopupSettings Height="auto"></DropDownListPopupSettings></DropDownListSettings>
        </TelerikDropDownList>
    </DemoConfiguratorColumn>
</DemoConfigurator>

<TelerikListView Data="@ListViewData"
                 TItem="DestinationDto"
                 Height="400px"
                 Pageable="true"
                 @bind-PageSize="@PageSize"
                 @bind-Page="@CurrentPage">
    <ListViewSettings>
        <ListViewPagerSettings InputType="@InputType" PageSizes="@PageSizes" ButtonCount="@ButtonsCount" Position="@PagerPosition" />
    </ListViewSettings>
    <HeaderTemplate>
        Top European destinations
    </HeaderTemplate>
    <Template>
        <div>
            <div class="k-card">
                <img src="images/destinations/@context.ImageUrl" alt="@context.Title" />
                <div class="k-card-body">
                    <h4 class="k-card-title">@context.Title</h4>
                    <h5 class="k-card-subtitle">@context.Description</h5>
                </div>
            </div>
        </div>
    </Template>
    <FooterTemplate>
        <div class="footer-note">Source: wwww.european.destinations</div>
    </FooterTemplate>
</TelerikListView>

@code {
    public TelerikListView<DestinationDto> ListViewRef { get; set; }

    int PageSize = 5;
    int CurrentPage = 2;
    int _buttonsCount = 5;
    public int ButtonsCount
    {
        get
        {
            return _buttonsCount;
        }
        set
        {
            if (value < 1)
            {
                _buttonsCount = 1;
            }
            else
            {
                _buttonsCount = value;
            }
        }
    }

    public PagerInputType InputType { get; set; }
    public PagerPosition PagerPosition { get; set; } = PagerPosition.Bottom;
    public bool ShowPageSizeDropdown { get; set; }
    public List<int?> PageSizes => ShowPageSizeDropdown ? new List<int?> { 5, 10, 20, null } : null;
    public List<PagerInputType> InputTypes => new List<PagerInputType> { PagerInputType.Buttons, PagerInputType.Input };
    public List<PagerPosition> PagerPositions => new List<PagerPosition> { PagerPosition.Bottom, PagerPosition.Top };

    public IEnumerable<DestinationDto> ListViewData { get; set; }

    protected override void OnInitialized()
    {
        LoadData();
    }

    // sample Read operation
    private void LoadData()
    {
        ListViewData = DestinationService.GetDestinations();
    }
}

<style>
    .k-listview-header,
    .k-listview-content {
        padding: 20px;
    }

    .k-listview-footer {
        border-width: 0;
        padding: 10px 20px;
    }

    .k-listview-content {
        display: grid;
        grid-template-columns: repeat(auto-fill, 180px);
        gap: 30px 20px;
    }

    .k-card {
        border: 0;
        border-radius: 0;
        box-shadow: none;
    }

    .k-card-body {
        padding: 10px 0;
    }

    .k-card .k-card-title {
        padding: 0;
        font-size: 1em;
        font-weight: bold;
        line-height: normal;
    }

    .k-card-subtitle {
        font-size: 0.85em;
    }

    .footer-note {
        text-align: right;
        font-style: italic;
        font-size: 0.85em;
    }
</style>
