@page "/listview/filtering"

@using Telerik.DataSource
@using Telerik.DataSource.Extensions
@using System.Collections.Generic

@inject ProductService ProductService

<TelerikListView Data=@Data
                 Pageable="true"
                 @bind-Page="@Page"
                 Height="500px">
    <HeaderTemplate>
        <div>Filter by Name</div>
        <TelerikTextBox Class="txt-listview" @bind-Value="@FilterText"></TelerikTextBox>
        <TelerikButton OnClick="@Filter">Filter</TelerikButton>
        <TelerikButton OnClick="@ClearFilter">Clear Filter</TelerikButton>
    </HeaderTemplate>
    <Template>
        <div class="k-card k-card-horizontal">
            <div class="k-card-body">
                <div class="k-hbox k-justify-content-between k-flex-wrap ">
                    <div class="product-name">
                        <h4 class="k-card-title">@context.ProductName</h4>
                        <h5 class="k-card-subtitle">@context.CategoryName</h5>
                    </div>
                    <ul class="product-info">
                        @if (context.QuantityPerUnit != null)
                        {
                            <li>Quantity per unit: @context.QuantityPerUnit</li>
                        }
                        @if (context.UnitsInStock != null)
                        {
                            <li>Units in stock: @context.UnitsInStock</li>
                        }
                    </ul>
                    <div class="product-price">
                        <strong>Price: </strong>@context.UnitPrice
                    </div>
                </div>
            </div>
        </div>
    </Template>
</TelerikListView>

@code {
    private const int _defaultPage = 1;
    private IEnumerable<ProductDto> SourceData { get; set; }
    private IEnumerable<ProductDto> Data { get; set; }
    private string FilterText { get; set; } = string.Empty;
    private int Page { get; set; } = _defaultPage;

    protected override void OnInitialized()
    {
        LoadData();
    }

    // sample Read operation
    private void LoadData()
    {
        SourceData = ProductService.GetProducts();
        Filter();
    }

    private void ClearFilter()
    {
        FilterText = string.Empty;
        Filter();
    }

    private void Filter()
    {
        var request = new DataSourceRequest()
        {
            Filters = new List<IFilterDescriptor>()
        };
        request.Filters.Add(new FilterDescriptor("ProductName", FilterOperator.Contains, FilterText));

        Data = SourceData.ToDataSourceResult(request).Data as IEnumerable<ProductDto>;
        Page = _defaultPage;
    }
}

<style>
    .k-listview-header {
        padding: 20px;
    }

    .k-card {
        padding: 10px 20px;
        border-width: 0 0 1px 0;
        border-radius: 0;
        box-shadow: none;
    }

        .k-card:last-child {
            border-bottom: 0;
        }

        .k-card .k-card-title {
            padding: 0;
            font-size: 1em;
            font-weight: bold;
            line-height: normal;
        }

    .k-card-subtitle {
        font-size: 1em;
        margin-bottom: 0;
    }

    .product-name {
        width: 50%;
        min-width: 180px;
        padding: 5px 0;
    }

    .product-info {
        width: 25%;
        min-width: 120px;
        margin: 0;
        padding: 5px 0;
        font-size: .875em;
    }

        .product-info li {
            list-style-type: none;
        }

    .product-price {
        width: 15%;
        min-width: 150px;
        padding: 5px 0;
        font-size: .875em;
    }

    .product-img {
        width: 80px;
        height: 50px;
        text-align: center;
        margin: auto;
    }

    .txt-listview {
        max-width: 200px;
    }
</style>
