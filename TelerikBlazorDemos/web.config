<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <configSections>
        <section name="rewriter" requirePermission="false" type="Telerik.UrlRewriter.Configuration.RewriterConfigurationSectionHandler, Telerik.UrlRewriter" />
    </configSections>
    <system.webServer>
        <httpProtocol>
            <customHeaders>
                <add name="Cache-Control" value="no-cache" />
                <add name="Content-Security-Policy" value="frame-ancestors 'none'; upgrade-insecure-requests" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-XSS-Protection" value="1; mode=block" />
            </customHeaders>
        </httpProtocol>
        <rewrite>
            <rules>
                <rule name="Redirect to lower case" stopProcessing="true">
                    <match url="[A-Z]" ignoreCase="false" />
                    <action type="Redirect" url="{ToLower:{URL}}" redirectType="Permanent" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                </rule>
                <rule name="Redirect to overview with slash">
                    <match url="(.*)" />
                    <action type="Redirect" url="{R:1}overview" redirectType="Found" />
                    <conditions>
                        <add input="{URL}" pattern="blazor-ui/([a-zA-Z]+)(/)$" />
                    </conditions>
                </rule>
                <rule name="Redirect to overview">
                    <match url="(.*)" />
                    <action type="Redirect" url="{R:1}/overview" redirectType="Found" />
                    <conditions>
                        <add input="{URL}" pattern="blazor-ui/([a-zA-Z]+)$" />
                    </conditions>
                </rule>
                <rule name="Skip Redirect index to overview for source files" stopProcessing="true">
                    <match url="(.*)/index" />
                    <action type="None" />
                    <conditions>
                        <add input="{QUERY_STRING}" pattern="path=" />
                    </conditions>
                </rule>
                <rule name="Redirect index to overview">
                    <match url="(.*)/index" />
                    <action type="Redirect" url="{R:1}/overview" redirectType="Found" />
                </rule>
                <rule name="Remove trailing slash" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Redirect" redirectType="Permanent" url="/blazor-ui" />
                    <conditions>
                        <add input="{REQUEST_URI}" pattern="/blazor-ui/$" />
                    </conditions>
                </rule>
                <rule name="Redirect animationcontainer/notification to notification/overview" stopProcessing="true">
                    <match url="animationcontainer/notification" />
                    <action type="Redirect" url="notification/overview" redirectType="Permanent" />
                </rule>
                <rule name="Redirect animationcontainer/tooltip to tooltip/overview" stopProcessing="true">
                    <match url="animationcontainer/tooltip" />
                    <action type="Redirect" url="tooltip/overview" redirectType="Permanent" />
                </rule>
                <rule name="Redirect grid/selection to grid/row-selection" stopProcessing="true">
                    <match url="grid/selection" />
                    <action type="Redirect" url="grid/row-selection" redirectType="Permanent" />
                </rule>
                <rule name="Redirect grid/checkbox-only-selection to grid/row-selection" stopProcessing="true">
                    <match url="grid/checkbox-only-selection" />
                    <action type="Redirect" url="grid/row-selection" redirectType="Permanent" />
                </rule>
                <rule name="Redirect treelist/selection to treelist/row-selection" stopProcessing="true">
                    <match url="treelist/selection" />
                    <action type="Redirect" url="treelist/row-selection" redirectType="Permanent" />
                </rule>
                <rule name="Redirect treelist/checkbox-only-selection to treelist/row-selection" stopProcessing="true">
                    <match url="treelist/checkbox-only-selection" />
                    <action type="Redirect" url="treelist/row-selection" redirectType="Permanent" />
                </rule>
                <rule name="Redirect grid/export-excel to grid/export" stopProcessing="true">
                    <match url="grid/export-excel" />
                    <action type="Redirect" url="grid/export" redirectType="Permanent" />
                </rule>
                <rule name="Redirect grid/export-csv to grid/export" stopProcessing="true">
                    <match url="grid/export-csv" />
                    <action type="Redirect" url="grid/export" redirectType="Permanent" />
                </rule>
                <rule name="Redirect blazorlab/combobox-smart-ai-search to aicomponents/overview" stopProcessing="true">
                    <match url="blazorlab/combobox-smart-ai-search" />
                    <action type="Redirect" url="aicomponents/overview" redirectType="Permanent" />
                </rule>
                <rule name="Redirect blazorlab/grid-smart-ai-search to aicomponents/overview" stopProcessing="true">
                    <match url="blazorlab/grid-smart-ai-search" />
                    <action type="Redirect" url="aicomponents/overview" redirectType="Permanent" />
                </rule>
                <rule name="Redirect blazorlab/pdfviewer-smart-ai-assistant to aicomponents/overview" stopProcessing="true">
                    <match url="blazorlab/pdfviewer-smart-ai-assistant" />
                    <action type="Redirect" url="aicomponents/overview" redirectType="Permanent" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
