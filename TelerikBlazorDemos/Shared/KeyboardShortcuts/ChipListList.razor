<h3>Supported keys and user actions</h3>
<ul class="keyboard-legend">
    <li>
        <span class="button-preview">
            <span class="key-button">Enter</span> or <span class="key-button">Space</span>
        </span>
        <span class="button-descr">
            Triggers a click action on the focused Chip and toggles the selection, if it's enabled.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Backspace</span> or <span class="key-button">Del</span>
        </span>
        <span class="button-descr">
            Removes the focused Chip, if it's removable.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Left Arrow</span>
        </span>
        <span class="button-descr">
            Focuses the next Chip in the list.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Shift + Tab</span>
        </span>
        <span class="button-descr">
            Focuses the previous Chip in the list.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Tab</span>
        </span>
        <span class="button-descr">
            Focuses the next focusable element on the page.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Shift + Tab</span>
        </span>
        <span class="button-descr">
            Focuses the previous focusable element on the page.
        </span>
    </li>
</ul>
