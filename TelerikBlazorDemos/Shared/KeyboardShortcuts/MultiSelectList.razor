<h3>Supported keys and user actions</h3>
<ul class="keyboard-legend">
    <li>
        <span class="button-preview">
            <span class="key-button">Alt</span>
            +
            <span class="key-button">Down</span>
        </span>
        <span class="button-descr">
            opens the popup element when the component is focused.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Alt</span>
            +
            <span class="key-button">Up</span>
        </span>
        <span class="button-descr">
            closes the popup element if it is open.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Esc</span>
        </span>
        <span class="button-descr">
            closes the popup element if it is open. If it is not open, clears the input value.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Up arrow</span>
        </span>
        <span class="button-descr">
            focuses the previous item in the list.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Down arrow</span>
        </span>
        <span class="button-descr">
            focuses the next item in the list.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Left arrow</span>
        </span>
        <span class="button-descr">
            focuses the previous selected tag in the tag list.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Right arrow</span>
        </span>
        <span class="button-descr">
            focuses the next selected tag in the tag list.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Home</span>
        </span>
        <span class="button-descr">
            focuses the first item in the list.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">End</span>
        </span>
        <span class="button-descr">
            focuses the last item in the list.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Enter</span>
        </span>
        <span class="button-descr">
            selects the currently focused item, or closes the popup if already selected
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Backspace</span>
        </span>
        <span class="button-preview">
            <span class="button-descr">or</span>
        </span>
        <span class="button-preview">
            <span class="key-button">Delete</span>
        </span>
        <span class="button-descr">
            removes the focused tag from the selection.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Printable character</span>
        </span>
        <span class="button-descr">
            opens the popup element when the component is focused, focuses the first matching option.
        </span>
    </li>
</ul>
