@if (!IsNested)
{
    <h3>Supported keys and user actions</h3>
}
<ul class="keyboard-legend">
    <li>
        <span class="button-preview">
            <span class="key-button">Alt</span>
            +
            <span class="key-button">Down</span>
        </span>
        ,
        <span class="button-preview">
            <span class="key-button">Space</span>
        </span>
        <span class="button-preview">
            <span class="button-preview button-descr">or</span>
            <span class="key-button">Enter</span>
        </span>
        <span class="button-descr">
            opens the popup element when the component is focused.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Alt</span>
            +
            <span class="key-button">Up</span>
        </span>
        <span class="button-preview">
            <span class="button-preview button-descr">or</span>
            <span class="key-button">Esc</span>
        </span>
        <span class="button-descr">
            closes the popup element.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Up arrow</span>
        </span>
        <span class="button-descr">
            moves focus to the previous item in the list.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Down arrow</span>
        </span>
        <span class="button-descr">
            moves focus to the next item in the list.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Home</span>
        </span>
        <span class="button-descr">
            moves focus to the first item in the list.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">End</span>
        </span>
        <span class="button-descr">
            moves focus to the last item in the list.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Printable characters</span>
        </span>
        <span class="button-descr">
            such as a letter or a number select the first item in the list whose text starts with that character. If such an item is already selected, selects the next.
        </span>
    </li>
</ul>

@code {
    [Parameter] public bool IsNested { get; set; }
}
