<h3>Supported keys and user actions</h3>
<ul class="keyboard-legend">
    <li>
        <span class="button-preview">
            <span class="key-button">Up & Right arrow</span>
        </span>
        <span class="button-descr">
            increases the start/end value of the rangeslider with the SmallStep.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Down & Left arrow</span>
        </span>
        <span class="button-descr">
            decreases the start/end value of the rangeslider with the SmallStep.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">PageUp</span>
        </span>
        <span class="button-descr">
            increases the start/end value of the rangeslider with the LargeStep.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">PageDown</span>
        </span>
        <span class="button-descr">
            decreases the start/end value of the rangeslider with the LargeStep.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Home</span>
        </span>
        <span class="button-descr">
            sets the start/end value of the rangeslider to the Min.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">End</span>
        </span>
        <span class="button-descr">
            sets the start/end value of the rangeslider with the Max.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Tab</span>
        </span>
        <span class="button-descr">
            lets you move the focus between the handles (they have <code>tabIndex=0</code> so the browser includes them in the tab sequence).
        </span>
    </li>
</ul>
