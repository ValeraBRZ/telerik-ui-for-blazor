@if (!IsNested)
{
    <h3>Supported keys and user actions</h3>
}
<ul class="keyboard-legend">
    <li>
        <span class="button-preview">
            <span class="key-button">Up arrow</span>
        </span>
        <span class="button-descr">
            increases the value of the date portion that contains the cursor. Takes the corresponding Step into account.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Down arrow</span>
        </span>
        <span class="button-descr">
            decreases the value of the date portion that contains the cursor. Takes the corresponding Step into account.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Left arrow</span>
        </span>
        <span class="button-descr">
            moves the cursor one position to the left.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Right arrow</span>
        </span>
        <span class="button-descr">
            moves the cursor one position to the right.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Delete</span>
            or
            <span class="key-button">Backspace</span>
        </span>
        <span class="button-descr">
            deletes the current date portion that contains the cursor.
        </span>
    </li>
</ul>

@code {
    [Parameter] public bool IsNested { get; set; }
}
