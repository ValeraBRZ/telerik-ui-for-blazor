<h3>Supported keys and user actions</h3>
<ul class="keyboard-legend">
    <li>
        <span class="button-preview">
            <span class="key-button">Up arrow</span>
        </span>
        <span class="button-descr">
            goes to the previous panel bar item. If no previous item is available, focuses the last item.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Down arrow</span>
        </span>
        <span class="button-descr">
            goes to the next panel bar item. If no next item is available, focuses the first item.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Right arrow</span>
        </span>
        <span class="button-descr">
            expands a collapsed item. If the item is expanded, focus is moved to its first child node.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Left arrow</span>
        </span>
        <span class="button-descr">
            collapses an expanded item. If the item is collapsed, focus is moved to its parent.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Home</span>
        </span>
        <span class="button-descr">
            moves focus to the first item in the panel bar without opening or closing an item.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">End</span>
        </span>
        <span class="button-descr">
            moves focus to the last item in the panel bar that is focusable without opening an item.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Enter & Space</span>
        </span>
        <span class="button-descr">
            selects the focused item and toggles the item if it is expandable. It also triggers its action (click or opening url).
        </span>
    </li>
</ul>
