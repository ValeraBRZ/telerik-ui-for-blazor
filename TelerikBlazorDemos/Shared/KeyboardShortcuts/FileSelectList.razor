<h3>Supported keys and user actions</h3>

<h3>Upload</h3>
<ul class="keyboard-legend">
    <li>
        <span class="button-preview">
            <span class="key-button">Tab</span>
        </span>
        <span class="button-descr">
            focuses the <code>Select File</code> Button.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Space</span>
            or
            <span class="key-button">Enter</span>
        </span>
        <span class="button-descr">
            opens the <code>Select file</code> dialog if the <code>Select files</code> button is focused.
        </span>
    </li>
</ul>

<h3>File List</h3>
<ul class="keyboard-legend">
    <li>
        <span class="button-preview">
            <span class="key-button">Down Arrow</span>
        </span>
        <span class="button-descr">
            highlights the next file in the file list.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Up Arrow</span>
        </span>
        <span class="button-descr">
            highlights the previous file in the file list or the <code>Select files</code> button if the top of the list is reached.
        </span>
    </li>
</ul>

<h3>File List Item</h3>
<ul class="keyboard-legend">
    <li>
        <span class="button-preview">
            <span class="key-button">Delete</span>
        </span>
        <span class="button-descr">
            removes the highlighted file.
        </span>
    </li>
</ul>
