<h3>Supported keys and user actions</h3>
<ul class="keyboard-legend">
    <li>
        <span class="button-preview">
            <span class="key-button">Up Arrow</span>
            or
            <span class="key-button">Left Arrow</span>
        </span>
        <span class="button-descr">
            selects previous Step.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Down Arrow</span>
            or
            <span class="key-button">Right Arrow</span>
        </span>
        <span class="button-descr">
            selects next Step.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Home</span>
        </span>
        <span class="button-descr">
            selects the first Step if it is available.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">End</span>
        </span>
        <span class="button-descr">
            selects the last Step if it is available.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Tab</span>
        </span>
        <span class="button-descr">
            focuses next element in the page Tab sequence.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Shift</span>
            +
            <span class="key-button">Tab</span>
        </span>
        <span class="button-descr">
            focuses previous element in the page Tab sequence.
        </span>
    </li>
</ul>
