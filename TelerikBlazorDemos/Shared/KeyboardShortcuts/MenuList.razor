<h3>Supported keys and user actions</h3>

<h3>Common</h3>
<ul class="keyboard-legend">
    <li>
        <span class="button-preview">
            <span class="key-button">Enter</span>
        </span>
        <span class="button-descr">
            activates the item and closes the menu. If the current menu item has a submenu (child items),
            opens the submenu and places the focus on its first item.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Space</span>
        </span>
        <span class="button-descr">
            same as
        </span>
        <span class="button-preview">
            <span class="key-button">Enter</span>
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Home</span>
        </span>
        <span class="button-descr">
            moves focus to the first item in the current menu or sub-menu.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">End</span>
        </span>
        <span class="button-descr">
            moves focus to the last item in the current menu or sub-menu.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Esc</span>
        </span>
        <span class="button-descr">
            closes an opened child item and focuses its parent.
        </span>
    </li>
</ul>

<h3>Horizontal Menu</h3>
<ul class="keyboard-legend">
    <li>
        <span class="button-preview">
            <span class="key-button">Down arrow</span>
        </span>
        <span class="button-preview">
            <span class="button-descr">and</span>
        </span>
        <span class="button-preview">
            <span class="key-button">Up arrow</span>
        </span>
        <span class="button-descr">
            moves focus to the next/previous item in the sub-menu, wrapping around the items list.
            If the focus is on an item that has child items, opens the sub-menu and focuses its first item.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Left arrow</span>
        </span>
        <span class="button-preview">
            <span class="button-descr">and</span>
        </span>
        <span class="button-preview">
            <span class="key-button">Right arrow</span>
        </span>
        <span class="button-descr">
            moves focus to the next/previous item in the main menu, wrapping around the items list.
            If the focus is in a sub-menu item that has child items, opens the sub-menu and focuses its first item.
            If the focus is in a sub-menu item that does not have child items,
            closes the sub-menu and moves the focus to the previous/next item in the main menu,
            while also expanding its sub-menu wihtout focusing it.
        </span>
    </li>
</ul>

<h3>Vertical Menu</h3>
<ul class="keyboard-legend">
    <li>
        <span class="button-preview">
            <span class="key-button">Down arrow</span>
        </span>
        <span class="button-descr">
            moves focus to the next item in the main menu or a sub-menu, wrapping around the items list.
            If the last item of the main menu is reached, closes a sub-menu (if present), moves to the first item and
            expands its sub-menu without focusing it.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Up arrow</span>
        </span>
        <span class="button-descr">
            moves focus to the previous item in the main menu or a sub-menu, wrapping around the items list.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Left arrow</span>
        </span>
        <span class="button-descr">
            opens the sub-menu of an item that has child items and places the focus on the last item of the sub-menu.
            If the focus is in a sub-menu item, closes the sub-menu and focuses its parent item.
        </span>
    </li>
    <li>
        <span class="button-preview">
            <span class="key-button">Right arrow</span>
        </span>
        <span class="button-descr">
            opens the sub-menu of an item that has child items and places the focus on the first item of the sub-menu.
        </span>
    </li>
</ul>
