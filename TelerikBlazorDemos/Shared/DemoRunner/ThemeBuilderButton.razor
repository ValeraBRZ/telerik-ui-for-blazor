@namespace TelerikBlazorDemos.Shared

<a class="tb-button kd-link @Class"
   target="_blank"
   href="@Link"
   @onmousedown="@OnMouseDown"
   @onclick="@OnClick">
    <span class="icon" style="pointer-events: none">
        <TelerikBlazorDemos.Shared.SVG.ThemeBuilderSvg></TelerikBlazorDemos.Shared.SVG.ThemeBuilderSvg>
    </span>
    @Text
</a>

@code {
    [Parameter]
    public Action OnMouseDown { get; set; }

    [Parameter]
    public Action OnClick { get; set; }

    [Parameter]
    public string Link { get; set; }

    [Parameter]
    public string Text { get; set; }

    [Parameter]
    public string Class { get; set; }
}
