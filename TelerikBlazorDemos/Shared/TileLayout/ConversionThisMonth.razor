@using Telerik.Blazor

<TelerikChart @ref="@ChartRef" Height="100%">
    <ChartLegend Visible="false"></ChartLegend>

    <ChartSeriesItems>
        <ChartSeries Type="ChartSeriesType.Line"
                     Data="@Data"
                     Field="@nameof(ModelData.Value)"
                     CategoryField="@nameof(ModelData.Date)"
                     Style="@ChartSeriesStyle.Smooth">
            <ChartSeriesMarkers Visible="false" />
        </ChartSeries>
    </ChartSeriesItems>

    <ChartCategoryAxes>
        <ChartCategoryAxis BaseUnit="ChartCategoryAxisBaseUnit.Fit">
            <ChartCategoryAxisLabels Format="{0:d MMMM}">
                <ChartCategoryAxisLabelsRotation Angle="@LabelsRotation" />
            </ChartCategoryAxisLabels>
            <ChartCategoryAxisMajorGridLines Visible="false" />
            <ChartCategoryAxisMajorTicks Visible="false" />
        </ChartCategoryAxis>
    </ChartCategoryAxes>

    <ChartValueAxes>
        <ChartValueAxis Min="0" Max="200000">
            <ChartValueAxisLabels Step="2"></ChartValueAxisLabels>
        </ChartValueAxis>
    </ChartValueAxes>

</TelerikChart>

@code {
    public class ModelData
    {
        public int Value { get; set; }
        public DateTime Date { get; set; }
    }

    public TelerikChart ChartRef { get; set; }
    public string LabelsRotation = "auto";

    public List<ModelData> Data = new List<ModelData>()
    {
        new ModelData()
        {
            Value = 2000,
            Date = new DateTime(2025, 3, 1)
        },
        new ModelData()
        {
            Value = 80000,
            Date = new DateTime(2025, 3, 5)
        },
        new ModelData()
        {
            Value = 130000,
            Date = new DateTime(2025, 3, 10)
        },
        new ModelData()
        {
            Value = 170000,
            Date = new DateTime(2025, 3, 15)
        },
        new ModelData()
        {
            Value = 190000,
            Date = new DateTime(2025, 3, 20)
        },
        new ModelData()
        {
            Value = 190000,
            Date = new DateTime(2025, 3, 25)
        }
    };

    public void Refresh()
    {
        ChartRef.Refresh();
    }
}
